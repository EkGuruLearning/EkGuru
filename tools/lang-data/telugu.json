  "dialogues": [
    {
      "title": "Meeting someone",
      "lines": [
        {
          "sp": "Lakshmi",
          "t": "నమస్కారం! నా పేరు లక్ష్మి.",
          "r": "Namaskāraṁ! Nā pēru Lakṣmi.",
          "hi": "नमस्ते! मेरा नाम लक्ष्मी है।",
          "en": "Hello! My name is Lakshmi."
        },
        {
          "sp": "Arjun",
          "t": "నమస్కారం! నేను అర్జున్. మీరు ఎలా ఉన్నారు?",
          "r": "Namaskāraṁ! Nēnu Arjun. Mīru elā unnāru?",
          "hi": "नमस्ते! मैं अर्जुन हूँ। आप कैसे हैं?",
          "en": "Hello! I'm Arjun. How are you?"
        },
        {
          "sp": "Lakshmi",
          "t": "నేను బాగున్నాను, ధన్యవాదాలు. మీది ఎక్కడ?",
          "r": "Nēnu bāgunnānu, dhanyavādālu. Mīdi ekkaḍa?",
          "hi": "मैं ठीक हूँ, धन्यवाद। आप कहाँ से हैं?",
          "en": "I'm fine, thank you. Where are you from?"
        },
        {
          "sp": "Arjun",
          "t": "నేను చెన్నై నుండి. నేను తెలుగు నేర్చుకుంటున్నాను.",
          "r": "Nēnu Chennai nunḍi. Nēnu telugu nērchukunṭunnānu.",
          "hi": "मैं चेन्नई से हूँ। मैं तेलुगु सीख रहा हूँ।",
          "en": "I'm from Chennai. I'm learning Telugu."
        },
        {
          "sp": "Lakshmi",
          "t": "చాలా బాగుంది! మళ్ళీ కలుద్దాం.",
          "r": "Chālā bāgundi! Maḷḷī kaluddāṁ.",
          "hi": "बहुत बढ़िया! फिर मिलेंगे।",
          "en": "Very good! See you again."
        }
      ]
    },
    {
      "title": "At a tea stall",
      "lines": [
        {
          "sp": "You",
          "t": "అన్నా, ఒక టీ ఇవ్వండి.",
          "r": "Annā, oka ṭī ivvaṇḍi.",
          "hi": "भैया, एक चाय दीजिए।",
          "en": "Brother, one tea please. (అన్నా = elder brother — everyone calls the vendor అన్నా)"
        },
        {
          "sp": "Vendor",
          "t": "చక్కెర ఎంత?",
          "r": "Chakkera enta?",
          "hi": "चीनी कितनी?",
          "en": "How much sugar?"
        },
        {
          "sp": "You",
          "t": "ఒక చెంచా. ఎంత అయింది?",
          "r": "Oka chen̄chā. Enta ayindi?",
          "hi": "एक चम्मच। कितने हुए?",
          "en": "One spoon. How much?"
        },
        {
          "sp": "Vendor",
          "t": "పది రూపాయలు.",
          "r": "Padi rūpāyalu.",
          "hi": "दस रुपये।",
          "en": "Ten rupees."
        },
        {
          "sp": "You",
          "t": "సరే. ధన్యవాదాలు!",
          "r": "Sarē. Dhanyavādālu!",
          "hi": "ठीक है। धन्यवाद!",
          "en": "OK. Thank you!"
        }
      ]
    },
    {
      "title": "Asking the way",
      "lines": [
        {
          "sp": "You",
          "t": "క్షమించండి, స్టేషన్ ఎక్కడ ఉంది?",
          "r": "Kshamin̄chaṇḍi, sṭēṣan ekkaḍa undi?",
          "hi": "माफ़ कीजिए, स्टेशन कहाँ है?",
          "en": "Excuse me, where is the station?"
        },
        {
          "sp": "Local",
          "t": "సరాసరి వెళ్ళండి, తర్వాత కుడికి.",
          "r": "Sarāsari veḷḷaṇḍi, tarvāta kuḍiki.",
          "hi": "सीधे जाइए, फिर दाएँ।",
          "en": "Go straight, then right."
        },
        {
          "sp": "You",
          "t": "దూరమా?",
          "r": "Dūramā?",
          "hi": "क्या दूर है?",
          "en": "Is it far?"
        },
        {
          "sp": "Local",
          "t": "కాదు, దగ్గరే. ఐదు నిమిషాలు.",
          "r": "Kādu, daggarē. Aidu nimiṣālu.",
          "hi": "नहीं, पास ही है। पाँच मिनट।",
          "en": "No, quite near. Five minutes."
        },
        {
          "sp": "You",
          "t": "చాలా ధన్యవాదాలు!",
          "r": "Chālā dhanyavādālu!",
          "hi": "बहुत धन्यवाद!",
          "en": "Thank you very much!"
        }
      ]
    }
  ],
