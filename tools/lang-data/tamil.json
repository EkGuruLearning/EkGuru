  "dialogues": [
    {
      "title": "Meeting someone",
      "lines": [
        {
          "sp": "Divya",
          "t": "வணக்கம்! என் பெயர் திவ்யா.",
          "r": "Vaṇakkam! Eṉ peyar Divyā.",
          "hi": "नमस्ते! मेरा नाम दिव्या है।",
          "en": "Hello! My name is Divya."
        },
        {
          "sp": "Karthik",
          "t": "வணக்கம்! நான் கார்த்திக். நீங்கள் எப்படி இருக்கிறீர்கள்?",
          "r": "Vaṇakkam! Nāṉ Kārttik. Nīṅkaḷ eppaḍi irukkiṟīrkaḷ?",
          "hi": "नमस्ते! मैं कार्तिक हूँ। आप कैसे हैं?",
          "en": "Hello! I'm Karthik. How are you?"
        },
        {
          "sp": "Divya",
          "t": "நான் நன்றாக இருக்கிறேன், நன்றி. நீங்கள் எந்த ஊர்?",
          "r": "Nāṉ naṉṟāka irukkiṟēṉ, naṉṟi. Nīṅkaḷ enta ūr?",
          "hi": "मैं ठीक हूँ, धन्यवाद। आप कहाँ से हैं?",
          "en": "I'm fine, thank you. Which town are you from?"
        },
        {
          "sp": "Karthik",
          "t": "நான் பெங்களூர். நான் தமிழ் கற்றுக்கொண்டிருக்கிறேன்.",
          "r": "Nāṉ Peṅkaḷūr. Nāṉ tamiḻ kaṟṟukkoṇḍirukkiṟēṉ.",
          "hi": "मैं बेंगलुरु से हूँ। मैं तमिल सीख रहा हूँ।",
          "en": "I'm from Bengaluru. I'm learning Tamil."
        },
        {
          "sp": "Divya",
          "t": "மிகவும் நல்லது! மீண்டும் சந்திப்போம்.",
          "r": "Mikavum nallatu! Mīṇḍum cantippōm.",
          "hi": "बहुत बढ़िया! फिर मिलेंगे।",
          "en": "Very good! See you again."
        }
      ]
    },
    {
      "title": "At a tea stall",
      "lines": [
        {
          "sp": "You",
          "t": "அண்ணே, ஒரு டீ கொடுங்கள்.",
          "r": "Aṇṇē, oru ṭī koḍuṅkaḷ.",
          "hi": "भैया, एक चाय दीजिए।",
          "en": "Brother, one tea please. (அண்ணே = O elder brother — the vocative everyone uses for the vendor)"
        },
        {
          "sp": "Vendor",
          "t": "சர்க்கரை எவ்வளவு?",
          "r": "Sarkkarai evvaḷavu?",
          "hi": "चीनी कितनी?",
          "en": "How much sugar?"
        },
        {
          "sp": "You",
          "t": "ஒரு ஸ்பூன். எவ்வளவு ஆயிற்று?",
          "r": "Oru spūṉ. Evvaḷavu āyiṟṟu?",
          "hi": "एक चम्मच। कितने हुए?",
          "en": "One spoon. How much?"
        },
        {
          "sp": "Vendor",
          "t": "பத்து ரூபாய்.",
          "r": "Pattu rūpāy.",
          "hi": "दस रुपये।",
          "en": "Ten rupees."
        },
        {
          "sp": "You",
          "t": "சரி. நன்றி!",
          "r": "Cari. Naṉṟi!",
          "hi": "ठीक है। धन्यवाद!",
          "en": "OK. Thank you!"
        }
      ]
    },
    {
      "title": "Asking the way",
      "lines": [
        {
          "sp": "You",
          "t": "மன்னிக்கவும், நிலையம் எங்கே இருக்கிறது?",
          "r": "Maṉṉikkavum, nilaiyam eṅkē irukkiṟatu?",
          "hi": "माफ़ कीजिए, स्टेशन कहाँ है?",
          "en": "Excuse me, where is the station?"
        },
        {
          "sp": "Local",
          "t": "நேராக போங்கள், பிறகு வலதுபுறம்.",
          "r": "Nērāka pōṅkaḷ, piṟaku valatupuṟam.",
          "hi": "सीधे जाइए, फिर दाएँ।",
          "en": "Go straight, then right."
        },
        {
          "sp": "You",
          "t": "தூரமா?",
          "r": "Tūramā?",
          "hi": "क्या दूर है?",
          "en": "Is it far?"
        },
        {
          "sp": "Local",
          "t": "இல்லை, அருகில்தான். ஐந்து நிமிடம்.",
          "r": "Illai, arukiltāṉ. Aintu nimiḍam.",
          "hi": "नहीं, पास ही है। पाँच मिनट।",
          "en": "No, quite near. Five minutes."
        },
        {
          "sp": "You",
          "t": "மிக்க நன்றி!",
          "r": "Mikka naṉṟi!",
          "hi": "बहुत धन्यवाद!",
          "en": "Thank you very much!"
        }
      ]
    }
  ],
