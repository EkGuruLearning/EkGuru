  "culture": [
    {
      "t": "பொங்கல்",
      "r": "Poṅkal",
      "en": "The Tamil harvest festival (January) — pongal pots boiling over at sunrise, sugarcane in every hand, and மாட்டுப் பொங்கல் honouring the cattle."
    },
    {
      "t": "தமிழ் புத்தாண்டு",
      "r": "Tamil New Year",
      "en": "Mid-April new year (புத்தாண்டு) — mango pachadi, new clothes, temple bells, and the year's first banana leaf."
    },
    {
      "t": "தீபாவளி",
      "r": "Dīpāvali",
      "en": "Tamil Diwali — oil lamps, new dresses at dawn, murukku mountains. Celebrated with full noise, often a day before the north."
    },
    {
      "t": "ஜல்லிக்கட்டு",
      "r": "Jallikattu",
      "en": "Pongal bull-taming — ancient, fierce, fiercely loved. Part sport, part identity, all Tamil."
    },
    {
      "t": "ஃபில்டர் காபி",
      "r": "filter coffee",
      "en": "Meter coffee in dabara-tumbler — frothed by pouring arm's length, drunk scalding. The state religion in a steel cup."
    }
  ],
