  "dialogues": [
    {"title": "Meeting someone",
     "lines": [
       {"sp": "Rina", "t": "নমস্কার! আমার নাম রিনা।", "r": "Nômoshkar! Amar nam Rina.", "hi": "नमस्ते! मेरा नाम रीना है।", "en": "Hello! My name is Rina."},
       {"sp": "Tom", "t": "নমস্কার! আমি টম। আপনি কেমন আছেন?", "r": "Nômoshkar! Ami Tom. Apni kæmon achhen?", "hi": "नमस्ते! मैं टॉम हूँ। आप कैसे हैं?", "en": "Hello! I'm Tom. How are you?"},
       {"sp": "Rina", "t": "আমি ভালো আছি, ধন্যবাদ। আপনি কোথা থেকে?", "r": "Ami bhalo achhi, dhonnobad. Apni kotha theke?", "hi": "मैं ठीक हूँ, धन्यवाद। आप कहाँ से हैं?", "en": "I'm fine, thank you. Where are you from?"},
       {"sp": "Tom", "t": "আমি লন্ডন থেকে। আমি বাংলা শিখছি।", "r": "Ami London theke. Ami bangla shikhchhi.", "hi": "मैं लंदन से हूँ। मैं बांग्ला सीख रहा हूँ।", "en": "I'm from London. I'm learning Bengali."},
       {"sp": "Rina", "t": "খুব ভালো! আবার দেখা হবে।", "r": "Khub bhalo! Abar dekha hobe.", "hi": "बहुत बढ़िया! फिर मिलेंगे।", "en": "Very good! See you again."}
     ]},
    {"title": "At a tea stall",
     "lines": [
       {"sp": "You", "t": "দাদা, একটা চা দিন।", "r": "Dada, ekṭa cha din.", "hi": "भैया, एक चाय दीजिए।", "en": "Brother, one tea please. (দাদা = elder brother — everyone calls the vendor দাদা)"},
       {"sp": "Vendor", "t": "চিনি কটা?", "r": "Chini koṭa?", "hi": "चीनी कितनी?", "en": "How many sugars?"},
       {"sp": "You", "t": "একটা। দাম কত?", "r": "Ekṭa. Dam koto?", "hi": "एक। कितने का?", "en": "One. How much?"},
       {"sp": "Vendor", "t": "দশ টাকা।", "r": "Dôsh ṭaka.", "hi": "दस रुपये।", "en": "Ten taka."},
       {"sp": "You", "t": "ঠিক আছে। ধন্যবাদ!", "r": "Ṭhik achhe. Dhonnobad!", "hi": "ठीक है। धन्यवाद!", "en": "OK. Thank you!"}
     ]},
    {"title": "Asking the way",
     "lines": [
       {"sp": "You", "t": "মাফ করবেন, স্টেশন কোথায়?", "r": "Maph korben, steshon kothay?", "hi": "माफ़ कीजिए, स्टेशन कहाँ है?", "en": "Excuse me, where is the station?"},
       {"sp": "Local", "t": "সোজা যান, তারপর ডানে।", "r": "Shoja jan, tarpor dane.", "hi": "सीधे जाइए, फिर दाएँ।", "en": "Go straight, then right."},
       {"sp": "You", "t": "এটা কি দূরে?", "r": "Eṭa ki dure?", "hi": "क्या दूर है?", "en": "Is it far?"},
       {"sp": "Local", "t": "না, কাছে। পাঁচ মিনিট।", "r": "Na, kachhe. Pãch minit.", "hi": "नहीं, पास है। पाँच मिनट।", "en": "No, near. Five minutes."},
       {"sp": "You", "t": "অনেক ধন্যবাদ!", "r": "Ônek dhonnobad!", "hi": "बहुत धन्यवाद!", "en": "Thank you very much!"}
     ]}
  ],

