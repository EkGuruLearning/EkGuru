  "quiz": [
    {"id": "bq-01", "lesson": "basics", "type": "meaning", "topic": "basics", "level": "beginner", "q": "What does নমস্কার mean?", "a": "hello", "opts": ["hello", "goodbye", "thank you", "sorry"], "explain": "নমস্কার (nômoshkar) is the standard formal hello — to elders, officials, anyone you respect."},
    {"id": "bq-02", "lesson": "basics", "type": "vocab", "topic": "basics", "level": "beginner", "q": "How do you say 'thank you' in Bengali?", "a": "ধন্যবাদ", "opts": ["ধন্যবাদ", "নমস্কার", "বিদায়", "মাফ করবেন"], "explain": "ধন্যবাদ (dhonnobad). মাফ করবেন is excuse-me/sorry — don't mix them."},
    {"id": "bq-03", "lesson": "pronunciation", "type": "usage", "topic": "basics", "level": "beginner", "q": "The letter ক reads as…", "a": "kô (as in 'on')", "opts": ["ka (as in 'car')", "kô (as in 'on')", "ki (as in 'kit')", "ku (as in 'put')"], "explain": "Bengali's inherent vowel is ô, not a. ক = kô. This is the biggest shock for Hindi speakers."},
    {"id": "bq-04", "lesson": "basics", "type": "meaning", "topic": "basics", "level": "beginner", "q": "আপনি কেমন আছেন? means…", "a": "How are you? (formal)", "opts": ["How are you? (formal)", "What is your name?", "Where are you from?", "See you again"], "explain": "আপনি (apni) is formal 'you' — safe with every stranger."},
