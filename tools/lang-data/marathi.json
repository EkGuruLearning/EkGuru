  "dialogues": [
    {
      "title": "Meeting someone",
      "lines": [
        {
          "sp": "Priya",
          "t": "नमस्कार! माझे नाव प्रिया आहे.",
          "r": "Namaskār! Mājhe nāv Priyā āhe.",
          "hi": "नमस्ते! मेरा नाम प्रिया है।",
          "en": "Hello! My name is Priya."
        },
        {
          "sp": "Rahul",
          "t": "नमस्कार! मी राहुल. तुम्ही कसे आहात?",
          "r": "Namaskār! Mī Rāhul. Tumhī kase āhāt?",
          "hi": "नमस्ते! मैं राहुल हूँ। आप कैसे हैं?",
          "en": "Hello! I'm Rahul. How are you?"
        },
        {
          "sp": "Priya",
          "t": "मी ठीक आहे, धन्यवाद. तुम्ही कुठले?",
          "r": "Mī ṭhīk āhe, dhanyavād. Tumhī kuṭhle?",
          "hi": "मैं ठीक हूँ, धन्यवाद। आप कहाँ से हैं?",
          "en": "I'm fine, thank you. Where are you from?"
        },
        {
          "sp": "Rahul",
          "t": "मी दिल्लीचा. मी मराठी शिकतोय.",
          "r": "Mī dillīcā. Mī marāṭhī śiktoy.",
          "hi": "मैं दिल्ली से हूँ। मैं मराठी सीख रहा हूँ।",
          "en": "I'm from Delhi. I'm learning Marathi."
        },
        {
          "sp": "Priya",
          "t": "छान! पुन्हा भेटू.",
          "r": "Chān! Punhā bheṭū.",
          "hi": "बढ़िया! फिर मिलेंगे।",
          "en": "Great! See you again."
        }
      ]
    },
    {
      "title": "At a tea tapri",
      "lines": [
        {
          "sp": "You",
          "t": "दादा, एक चहा द्या.",
          "r": "Dādā, ek cahā dyā.",
          "hi": "भैया, एक चाय दीजिए।",
          "en": "Brother, one tea please. (दादा = elder brother — everyone calls the vendor दादा)"
        },
        {
          "sp": "Vendor",
          "t": "साखर किती?",
          "r": "Sākhar kitī?",
          "hi": "चीनी कितनी?",
          "en": "How much sugar?"
        },
        {
          "sp": "You",
          "t": "एक चमचा. किती झाले?",
          "r": "Ek camcā. Kitī jhāle?",
          "hi": "एक चम्मच। कितने हुए?",
          "en": "One spoon. How much?"
        },
        {
          "sp": "Vendor",
          "t": "दहा रुपये.",
          "r": "Dahā rupaye.",
          "hi": "दस रुपये।",
          "en": "Ten rupees."
        },
        {
          "sp": "You",
          "t": "ठीक आहे. धन्यवाद!",
          "r": "Ṭhīk āhe. Dhanyavād!",
          "hi": "ठीक है। धन्यवाद!",
          "en": "OK. Thank you!"
        }
      ]
    },
    {
      "title": "Asking the way",
      "lines": [
        {
          "sp": "You",
          "t": "माफ करा, स्टेशन कुठे आहे?",
          "r": "Māph karā, sṭeśan kuṭhe āhe?",
          "hi": "माफ़ कीजिए, स्टेशन कहाँ है?",
          "en": "Excuse me, where is the station?"
        },
        {
          "sp": "Local",
          "t": "सरळ जा, मग उजवीकडे.",
          "r": "Saraḷ jā, mag ujavīkaḍe.",
          "hi": "सीधे जाइए, फिर दाएँ।",
          "en": "Go straight, then right."
        },
        {
          "sp": "You",
          "t": "लांब आहे का?",
          "r": "Lāmb āhe kā?",
          "hi": "क्या दूर है?",
          "en": "Is it far?"
        },
        {
          "sp": "Local",
          "t": "नाही, जवळ आहे. पाच मिनिटे.",
          "r": "Nāhī, javaḷ āhe. Pāc miniṭe.",
          "hi": "नहीं, पास है। पाँच मिनट।",
          "en": "No, it's near. Five minutes."
        },
        {
          "sp": "You",
          "t": "खूप खूप धन्यवाद!",
          "r": "Khūp khūp dhanyavād!",
          "hi": "बहुत-बहुत धन्यवाद!",
          "en": "Thank you very much!"
        }
      ]
    }
  ],
