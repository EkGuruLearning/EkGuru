    {"id": "gj-01", "lesson": "basics", "type": "meaning", "topic": "basics", "level": "beginner", "q": "What does નમસ્તે mean?", "a": "hello", "opts": ["hello", "goodbye", "thank you", "sorry"], "explain": "નમસ્તે (namaste) is the standard hello — to elders, officials, anyone you respect."},
    {"id": "gj-02", "lesson": "basics", "type": "vocab", "topic": "basics", "level": "beginner", "q": "How do you say 'thank you' in Gujarati?", "a": "આભાર", "opts": ["આભાર", "નમસ્તે", "માફ કરશો", "આવજો"], "explain": "આભાર (ābhār). માફ કરશો is excuse-me/sorry — don't mix them."},
    {"id": "gj-03", "lesson": "pronunciation", "type": "usage", "topic": "basics", "level": "beginner", "q": "Gujarati script differs from Devanagari mainly in…", "a": "having NO headline bar (letters hang free)", "opts": ["having NO headline bar (letters hang free)", "being written right-to-left", "having 50 vowels", "using Roman letters"], "explain": "Gujarati dropped Devanagari's headline bar — same family, cleaner look. Hindi readers decode it fast."},
    {"id": "gj-04", "lesson": "basics", "type": "meaning", "topic": "basics", "level": "beginner", "q": "તમે કેમ છો? means…", "a": "How are you? (formal)", "opts": ["How are you? (formal)", "What is your name?", "Where are you from?", "See you again"], "explain": "તમે (tame) is formal 'you' — safe with every stranger."},
    {"id": "gj-05", "lesson": "numbers", "type": "vocab", "topic": "numbers", "level": "beginner", "q": "What does પાંચ mean?", "a": "five", "opts": ["four", "five", "six", "seven"], "explain": "પાંચ (pāṁch) = 5. Same root as Hindi पाँच."},
    {"id": "gj-06", "lesson": "numbers", "type": "vocab", "topic": "numbers", "level": "beginner", "q": "How do you say 'ten'?", "a": "દસ", "opts": ["દસ", "પાંચ", "વીસ", "સો"], "explain": "દસ (das) = 10. વીસ is 20, સો is 100."},
    {"id": "gj-07", "lesson": "numbers", "type": "vocab", "topic": "numbers", "level": "elementary", "q": "વીસ means…", "a": "twenty", "opts": ["twelve", "twenty", "two hundred", "two thousand"], "explain": "વીસ (vīs) = 20 — its own word, like English 'twenty'."},
    {"id": "gj-08", "lesson": "numbers", "type": "vocab", "topic": "numbers", "level": "elementary", "q": "સો means…", "a": "one hundred", "opts": ["one thousand", "one hundred", "eleven", "ten"], "explain": "સો (so) = 100 — short and sweet."},
    {"id": "gj-09", "lesson": "food", "type": "vocab", "topic": "food", "level": "beginner", "q": "What does ભાત mean?", "a": "cooked rice", "opts": ["cooked rice", "bread", "fish", "lentils"], "explain": "ભાત (bhāt) is cooked rice — uncooked rice is ચોખા."},
    {"id": "gj-10", "lesson": "food", "type": "vocab", "topic": "food", "level": "beginner", "q": "માછલી means…", "a": "fish", "opts": ["meat", "fish", "egg", "milk"], "explain": "માછલી (māchhalī) = fish."},
    {"id": "gj-11", "lesson": "food", "type": "usage", "topic": "food", "level": "elementary", "q": "એક ચા આપો means…", "a": "One tea, please", "opts": ["One tea, please", "Two teas, please", "No tea", "Tea is cold"], "explain": "એક = one, આપો = give (polite). The full polite ordering pattern."},
    {"id": "gj-12", "lesson": "travel", "type": "usage", "topic": "travel", "level": "beginner", "q": "સ્ટેશન ક્યાં છે? means…", "a": "Where is the station?", "opts": ["Where is the station?", "The station is far", "Take me to the station", "The station is closed"], "explain": "ક્યાં (kyāṁ) = where. X ક્યાં છે? is the whole direction toolkit in three words."},
    {"id": "gj-13", "lesson": "travel", "type": "vocab", "topic": "travel", "level": "beginner", "q": "જમણે means…", "a": "right", "opts": ["left", "right", "straight", "back"], "explain": "જમણે (jamṇe) = to the right. Left is ડાબે, straight is સીધું."},
    {"id": "gj-14", "lesson": "travel", "type": "usage", "topic": "travel", "level": "elementary", "q": "ભાડું કેટલું? means…", "a": "How much is the fare?", "opts": ["How much is the fare?", "The fare is fixed", "Stop the car", "Faster, please"], "explain": "ભાડું (bhāḍuṁ) = fare, કેટલું = how much. Ask before you sit down."},
    {"id": "gj-15", "lesson": "grammar", "type": "usage", "topic": "grammar", "level": "beginner", "q": "હું ભાત ખાઉં છું. The word order is…", "a": "I · rice · eat · am (verb + helper last)", "opts": ["I · eat · rice (like English)", "I · rice · eat · am (verb + helper last)", "Rice · I · eat", "Eat · I · rice"], "explain": "Gujarati is subject–object–verb–helper: હું ભાત ખાઉં છું. The helper છું is compulsory."},
    {"id": "gj-16", "lesson": "grammar", "type": "usage", "topic": "grammar", "level": "beginner", "q": "Which 'you' is safe with strangers?", "a": "તમે", "opts": ["તું", "તમે", "તે", "હું"], "explain": "તમે (tame) is formal and safe everywhere. તું to a stranger is rude."},
    {"id": "gj-17", "lesson": "grammar", "type": "usage", "topic": "grammar", "level": "elementary", "q": "હું માંસ ખાતો નથી means…", "a": "I don't eat meat", "opts": ["I don't eat meat", "I eat meat daily", "I ate meat", "I will eat meat"], "explain": "નથી after the verb negates it: ખાતો નથી = don't eat. A woman says ખાતી નથી."},
    {"id": "gj-18", "lesson": "grammar", "type": "usage", "topic": "grammar", "level": "elementary", "q": "'She went' is…", "a": "ગઈ", "opts": ["ગયો", "ગઈ", "ગયું", "જઈશ"], "explain": "ગઈ (gaī) — the past tense shows gender: ગયો (he went), ગઈ (she went), ગયું (it went)."},
    {"id": "gj-19", "lesson": "conversation", "type": "meaning", "topic": "conversation", "level": "beginner", "q": "મારું નામ … means…", "a": "My name is …", "opts": ["My name is …", "Your name is …", "What is this?", "I am lost"], "explain": "મારું (māruṁ) = my, નામ = name. મારું નામ પ્રિયા = my name is Priya."},
    {"id": "gj-20", "lesson": "conversation", "type": "usage", "topic": "conversation", "level": "elementary", "q": "હું ગુજરાતી શીખું છું means…", "a": "I am learning Gujarati", "opts": ["I am learning Gujarati", "I speak Gujarati fluently", "I forgot Gujarati", "I teach Gujarati"], "explain": "શીખું છું is present continuous: right now, in progress. Say it to any Gujarati and watch them smile."},
