    {"id": "gj-22", "lesson": "vocabulary", "type": "vocab", "topic": "vocabulary", "level": "beginner", "q": "ઘર means…", "a": "house", "opts": ["house", "car", "shop", "school"], "explain": "ઘર (ghar) = house/home. ઘરમાં = at home (માં = in/at)."},
