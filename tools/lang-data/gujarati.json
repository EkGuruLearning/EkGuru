  "dialogues": [
    {"title": "Meeting someone",
     "lines": [
       {"sp": "Priya", "t": "નમસ્તે! મારું નામ પ્રિયા છે.", "r": "Namaste! Māruṁ nām Priyā che.", "hi": "नमस्ते! मेरा नाम प्रिया है।", "en": "Hello! My name is Priya."},
       {"sp": "Jay", "t": "નમસ્તે! હું જય. તમે કેમ છો?", "r": "Namaste! Huṁ Jay. Tame kem cho?", "hi": "नमस्ते! मैं जय हूँ। आप कैसे हैं?", "en": "Hello! I'm Jay. How are you?"},
       {"sp": "Priya", "t": "હું મજામાં છું, આભાર. તમે ક્યાંના છો?", "r": "Huṁ majāmāṁ chuṁ, ābhār. Tame kyāṁnā cho?", "hi": "मैं मज़े में हूँ, धन्यवाद। आप कहाँ से हैं?", "en": "I'm fine, thank you. Where are you from?"},
       {"sp": "Jay", "t": "હું મુંબઈનો. હું ગુજરાતી શીખું છું.", "r": "Huṁ mumbaīno. Huṁ gujarātī śīkhuṁ chuṁ.", "hi": "मैं मुंबई से हूँ। मैं गुजराती सीख रहा हूँ।", "en": "I'm from Mumbai. I'm learning Gujarati."},
       {"sp": "Priya", "t": "સરસ! ફરી મળીશું.", "r": "Saras! Pharī maḷīśuṁ.", "hi": "बढ़िया! फिर मिलेंगे।", "en": "Great! See you again."}
     ]},
    {"title": "At a tea kitli",
     "lines": [
       {"sp": "You", "t": "ભાઈ, એક ચા આપો.", "r": "Bhāī, ek chā āpo.", "hi": "भैया, एक चाय दीजिए।", "en": "Brother, one tea please. (The Gujarati tea stall is a કીટલી — kitli, named for the kettle)"},
       {"sp": "Vendor", "t": "ખાંડ કેટલી?", "r": "Khāṁḍ keṭlī?", "hi": "चीनी कितनी?", "en": "How much sugar?"},
       {"sp": "You", "t": "એક ચમચી. કેટલા થયા?", "r": "Ek chamchī. Keṭlā thayā?", "hi": "एक चम्मच। कितने हुए?", "en": "One spoon. How much?"},
       {"sp": "Vendor", "t": "દસ રૂપિયા.", "r": "Das rūpiyā.", "hi": "दस रुपये।", "en": "Ten rupees."},
       {"sp": "You", "t": "સારું. આભાર!", "r": "Sāruṁ. Ābhār!", "hi": "ठीक है। धन्यवाद!", "en": "OK. Thank you!"}
     ]},
    {"title": "Asking the way",
     "lines": [
       {"sp": "You", "t": "માફ કરશો, સ્ટેશન ક્યાં છે?", "r": "Māph karśo, sṭeśan kyāṁ che?", "hi": "माफ़ कीजिए, स्टेशन कहाँ है?", "en": "Excuse me, where is the station?"},
       {"sp": "Local", "t": "સીધા જાઓ, પછી જમણે.", "r": "Sīdhā jāo, pachhī jamṇe.", "hi": "सीधे जाइए, फिर दाएँ।", "en": "Go straight, then right."},
       {"sp": "You", "t": "દૂર છે?", "r": "Dūr che?", "hi": "क्या दूर है?", "en": "Is it far?"},
       {"sp": "Local", "t": "ના, નજીક છે. પાંચ મિનિટ.", "r": "Nā, najīk che. Pāṁch miniṭ.", "hi": "नहीं, पास है। पाँच मिनट।", "en": "No, it's near. Five minutes."},
       {"sp": "You", "t": "ખૂબ ખૂબ આભાર!", "r": "Khūb khūb ābhār!", "hi": "बहुत-बहुत धन्यवाद!", "en": "Thank you very much!"}
     ]}
  ],

