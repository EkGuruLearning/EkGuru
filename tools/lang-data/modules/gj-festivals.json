{
 "dialogue": {
  "lines": [
   {
    "en": "Happy New Year! Wish you joy!",
    "hi": "नए साल की शुभकामनाएँ!",
    "r": "Nutan varshabhinandan! Aanand thao!",
    "sp": "Neighbour",
    "t": "નૂતન વર્ષાભિનંદન! આનંદ થાઓ!"
   },
   {
    "en": "Same to you! Come, eat sweets.",
    "hi": "तुम्हें भी! आओ, मिठाई खाओ।",
    "r": "Tamne pan! Aavo, mithai khao.",
    "sp": "Mother",
    "t": "તમને પણ! આવો, મિઠાઈ ખાઓ."
   },
   {
    "en": "The rangoli looks beautiful!",
    "hi": "रंगोली सुंदर लगती है!",
    "r": "Rangoli saras laage chhe!",
    "sp": "Neighbour",
    "t": "રંગોળી સરસ લાગે છે!"
   },
   {
    "en": "In the evening there is garba.",
    "hi": "शाम को गरबा है।",
    "r": "Sanje garbo chhe.",
    "sp": "Mother",
    "t": "સાંજે ગરબો છે."
   },
   {
    "en": "We'll all come. Wear new clothes!",
    "hi": "हम सब आएँगे। नए कपड़े पहनना!",
    "r": "Ame badha aavishu. Nava kapda pahero!",
    "sp": "Neighbour",
    "t": "અમે બધા આવીશું. નવા કપડા પહેરો!"
   }
  ],
  "title": "New Year greetings"
 },
