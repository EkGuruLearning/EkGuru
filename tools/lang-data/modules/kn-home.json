{
 "dialogue": {
  "lines": [
   {
    "en": "Grandma, what is cooking?",
    "hi": "दादी, क्या बन रहा है?",
    "r": "Ajji, ēnu aḍuge āguttide?",
    "sp": "Granddaughter",
    "t": "ಅಜ್ಜಿ, ಏನು ಅಡುಗೆ ಆಗುತ್ತಿದೆ?"
   },
   {
    "en": "Bisi bele bath, my dear!",
    "hi": "बिसी बेले बाथ, मेरी बच्ची!",
    "r": "Bisi beḷe bāt, nanna magu!",
    "sp": "Grandmother",
    "t": "ಬಿಸಿ ಬೆಳೆ ಬಾತ್, ನನ್ನ ಮಗು!"
   },
   {
    "en": "Wash your hands and sit.",
    "hi": "हाथ धोकर बैठो।",
    "r": "Kai toḷedu kūtu.",
    "sp": "Grandmother",
    "t": "ಕೈ ತೊಳೆದು ಕೂತು."
   },
   {
    "en": "Grandma, the food smells nice!",
    "hi": "दादी, खाना महक रहा है!",
    "r": "Ajji, ūṭa ghamagham anuttide!",
    "sp": "Granddaughter",
    "t": "ಅಜ್ಜಿ, ಊಟ ಘಮಘಮ ಅನ್ನುತ್ತಿದೆ!"
   },
   {
    "en": "Eat well. Shall I serve more?",
    "hi": "अच्छे से खा। और परोसूँ?",
    "r": "Channāgi tinnu. Innu barisalā?",
    "sp": "Grandmother",
    "t": "ಚೆನ್ನಾಗಿ ತಿನ್ನು. ಇನ್ನು ಬರಿಸಲಾ?"
   },
   {
    "en": "Yes grandma! Your hand is magic.",
    "hi": "हाँ दादी! तुम्हारे हाथ में जादू है।",
    "r": "Haudu ajji! Ninna kaili māyavide.",
    "sp": "Granddaughter",
    "t": "ಹೌದು ಅಜ್ಜಿ! ನಿನ್ನ ಕೈಲಿ ಮಾಯವಿದೆ."
   }
  ],
  "title": "Grandma's kitchen"
 },
 "lede": "Rooms, kitchen and family — Kannada for home life.",
 "phrases": [
  {
   "en": "Come, let's eat",
   "hi": "आओ, खाना खाएँ",
   "r": "Banni, ūṭa māḍōṇa",
   "t": "ಬನ್ನಿ, ಊಟ ಮಾಡೋಣ"
  },
  {
   "en": "The food is ready",
   "hi": "खाना तैयार है",
   "r": "Ūṭa tayārāgide",
   "t": "ಊಟ ತಯಾರಾಗಿದೆ"
  },
  {
   "en": "Wash your hands",
   "hi": "हाथ धो लो",
   "r": "Kai toḷeyiri",
   "t": "ಕೈ ತೊಳೆಯಿರಿ"
  },
  {
   "en": "Sit down",
   "hi": "बैठो",
   "r": "Kūti",
   "t": "ಕೂತಿ"
  },
  {
   "en": "Eat a little more",
   "hi": "थोड़ा और खा",
   "r": "Svalpa innu tinnu",
   "t": "ಸ್ವಲ್ಪ ಇನ್ನು ತಿನ್ನು"
  },
  {
   "en": "It is very tasty!",
   "hi": "बहुत स्वादिष्ट है!",
   "r": "Tumbā ruchiyāgide!",
   "t": "ತುಂಬಾ ರುಚಿಯಾಗಿದೆ!"
  },
  {
   "en": "Enough, I am full",
   "hi": "बस, पेट भर गया",
   "r": "Sāku, hoṭṭe tuṁbide",
   "t": "ಸಾಕು, ಹೊಟ್ಟೆ ತುಂಬಿದೆ"
  },
  {
   "en": "Drink water",
   "hi": "पानी पियो",
   "r": "Nīru kuḍiyiri",
   "t": "ನೀರು ಕುಡಿಯಿರಿ"
  },
  {
   "en": "Go to sleep",
   "hi": "सोने जाओ",
   "r": "Midiyalu hōgi",
   "t": "ಮಲಗಲು ಹೋಗಿ"
  },
  {
   "en": "Wake up early",
   "hi": "जल्दी उठो",
   "r": "Bēga ēli",
   "t": "ಬೇಗ ಏಳಿ"
  },
  {
   "en": "Close the door",
   "hi": "दरवाज़ा बंद करो",
   "r": "Bāgilu muchhiri",
   "t": "ಬಾಗಿಲು ಮುಚ್ಚಿರಿ"
  },
  {
   "en": "Switch off the light",
   "hi": "बत्ती बुझा दो",
   "r": "Dīpava ārisi",
   "t": "ದೀಪವಾ ಆರಿಸಿ"
  }
 ],
