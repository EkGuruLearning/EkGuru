{
  "dialogue": {
    "lines": [
      {
        "en": "Wake up! Today is Thai Pongal.",
        "hi": "उठो! आज तैपोंगल है।",
        "r": "Eḻundiru! Iṉṛu taippoṅgal.",
        "sp": "Grandmother",
        "t": "எழுந்திரு! இன்று தைப்பொங்கல்."
      },
      {
        "en": "Grandma, did you draw the kolam?",
        "hi": "दादी, कोलम बना दिया?",
        "r": "Pāṭṭi, kōlam pōṭṭāyā?",
        "sp": "Girl",
        "t": "பாட்டி, கோலம் போட்டாயா?"
      },
      {
        "en": "Done. Fetch the sugarcane.",
        "hi": "बना दिया। गन्ना ला।",
        "r": "Pōṭṭuviṭṭēṉ. Karumbai eḍu.",
        "sp": "Grandmother",
        "t": "போட்டுவிட்டேன். கரும்பை எடு."
      },
      {
        "en": "The Pongal is boiling over!",
        "hi": "पोंगल उबल रहा है!",
        "r": "Poṅgal poṅgugiṛadu!",
        "sp": "Girl",
        "t": "பொங்கல் பொங்குகிறது!"
      },
      {
        "en": "Pongalo Pongal!",
        "hi": "पोंगलो पोंगल!",
        "r": "Poṅgalō poṅgal!",
        "sp": "Grandmother",
        "t": "பொங்கலோ பொங்கல்!"
      },
      {
        "en": "Let's thank the sun.",
        "hi": "सूरज को शुक्रिया कहें।",
        "r": "Sūriyaṉukku naṉṛi solvōm.",
        "sp": "Girl",
        "t": "சூரியனுக்கு நன்றி சொல்வோம்."
      }
    ],
    "title": "Pongal morning"
  },
  "lede": "Pongal, kolam and temple cars — celebrate the Tamil year.",
  "phrases": [
    {
      "en": "Happy Pongal",
      "hi": "पोंगल की शुभकामनाएँ",
      "r": "Iṉiya poṅgal nalvāḻttugaḷ",
      "t": "இனிய பொங்கல் நல்வாழ்த்துகள்"
    },
    {
      "en": "Happy Diwali",
      "hi": "दीपावली की शुभकामनाएँ",
      "r": "Iṉiya tībavaḷi nalvāḻttugaḷ",
      "t": "இனிய தீபாவளி நல்வாழ்த்துகள்"
    },
    {
      "en": "Eid Mubarak",
      "hi": "ईद मुबारक",
      "r": "Īt mubārak",
      "t": "ஈத் முபாரக்"
    },
    {
      "en": "Merry Christmas",
      "hi": "क्रिसमस की शुभकामनाएँ",
      "r": "Kiristumas vāḻttugaḷ",
      "t": "கிறிஸ்துமஸ் வாழ்த்துகள்"
    },
    {
      "en": "Happy New Year",
      "hi": "नववर्ष की शुभकामनाएँ",
      "r": "Iṉiya puttāṇḍu nalvāḻttugaḷ",
      "t": "இனிய புத்தாண்டு நல்வாழ்த்துகள்"
    },
    {
      "en": "Let's go to the temple",
      "hi": "मंदिर चलो",
      "r": "Kōyilukkup pōgalām",
      "t": "கோயிலுக்குப் போகலாம்"
    },
    {
      "en": "The idol is beautiful",
      "hi": "मूर्ति सुंदर है",
      "r": "Silai miga aḻagu",
      "t": "சிலை மிக அழகு"
    },
    {
      "en": "Light the lamp",
      "hi": "दीया जलाओ",
      "r": "Viḷakkēṛṛu",
      "t": "விளக்கேற்று"
    },
    {
      "en": "Take the blessing",
      "hi": "आशीर्वाद लो",
      "r": "Āsīrvādam vāṅgu",
      "t": "ஆசீர்வாதம் வாங்கு"
    },
    {
      "en": "Come for the feast",
      "hi": "भोज पर आओ",
      "r": "Virundukku vā",
      "t": "விருந்துக்கு வா"
    },
    {
      "en": "What did you get?",
      "hi": "तुम्हें क्या मिला?",
      "r": "Uṉakku enna kiḍaittadu?",
      "t": "உனக்கு என்ன கிடைத்தது?"
    },
    {
      "en": "Pongalo Pongal!",
      "hi": "पोंगलो पोंगल!",
      "r": "Poṅgalō poṅgal!",
      "t": "பொங்கலோ பொங்கல்!"
    }
  ],
