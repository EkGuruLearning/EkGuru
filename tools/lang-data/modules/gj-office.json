{
 "dialogue": {
  "lines": [
   {
    "en": "Welcome! What is your name?",
    "hi": "आइए! आपका नाम क्या है?",
    "r": "Aavo! Tamaru naam shu?",
    "sp": "Manager",
    "t": "આવો! તમારું નામ શું?"
   },
   {
    "en": "My name is Kumar.",
    "hi": "मेरा नाम कुमार है।",
    "r": "Maru naam Kumar.",
    "sp": "Newcomer",
    "t": "મારું નામ કુમાર."
   },
   {
    "en": "This is your desk. Switch on the computer.",
    "hi": "यह आपकी मेज़ है। कंप्यूटर चालू कीजिए।",
    "r": "Aa tamaru table. Computer chalu karo.",
    "sp": "Manager",
    "t": "આ તમારું ટેબલ. કમ્પ્યૂટર ચાલુ કરો."
   },
   {
    "en": "OK. What is the email address?",
    "hi": "ठीक है। ईमेल पता क्या है?",
    "r": "Barabar. Email sarnaamu shu?",
    "sp": "Newcomer",
    "t": "બરાબર. ઇમેઇલ સરનામું શું?"
   },
   {
    "en": "Don't fear, the assistant will tell you.",
    "hi": "चिंता मत कीजिए, सहायक बता देगा।",
    "r": "Bisho nahi, assistant kaheshe.",
    "sp": "Manager",
    "t": "બીશો નહીં, આસિસ્ટન્ટ કહેશે."
   },
   {
    "en": "Thanks! I'll come on time tomorrow.",
    "hi": "शुक्रिया! कल समय पर आऊँगा।",
    "r": "Aabhar! Kaale samaysar aavish.",
    "sp": "Newcomer",
    "t": "આભાર! કાલે સમયસર આવીશ."
   }
  ],
  "title": "First day at office"
 },
 "lede": "Desks, files and deadlines — Gujarati for work life.",
 "phrases": [
  {
   "en": "I have a meeting",
   "hi": "मेरी मीटिंग है",
