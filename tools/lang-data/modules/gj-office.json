   "t": "બૉસ તમને બોલાવ્યા"
  },
  {
   "en": "Sign here",
   "hi": "यहाँ दस्तख़त करो",
   "r": "Ahiya sahi karo",
   "t": "અહીંયા સહી કરો"
  },
  {
   "en": "Send the email",
   "hi": "ईमेल भेजो",
   "r": "Email mokalo",
   "t": "ઇમેઇલ મોકલો"
  },
  {
   "en": "Take a printout",
   "hi": "प्रिंट निकालो",
   "r": "Print kaadho",
   "t": "પ્રિન્ટ કાઢો"
  },
  {
   "en": "When is the salary?",
   "hi": "वेतन कब मिलेगा?",
   "r": "Pagar kyare malshe?",
   "t": "પગાર ક્યારે મળશે?"
  },
  {
   "en": "I need leave tomorrow",
   "hi": "मुझे कल छुट्टी चाहिए",
   "r": "Kaale mane raja joie",
   "t": "કાલે મને રજા જોઈએ"
  },
  {
   "en": "The work is finished",
   "hi": "काम ख़त्म हो गया",
   "r": "Kaam puru thayu",
   "t": "કામ પૂરું થયું"
  },
  {
   "en": "Come on time",
   "hi": "समय पर आओ",
   "r": "Samaysar aavo",
   "t": "સમયસર આવો"
  },
  {
   "en": "Good job!",
   "hi": "शाबाश!",
   "r": "Saras kaam!",
   "t": "સરસ કામ!"
  },
  {
   "en": "I will call back",
   "hi": "मैं वापस फ़ोन करूँगा",
   "r": "Hu paachho phone karish",
   "t": "હું પાછો ફોન કરીશ"
  },
  {
   "en": "See you tomorrow",
   "hi": "कल मिलते हैं",
   "r": "Kaale malishu",
   "t": "કાલે મળીશું"
  }
