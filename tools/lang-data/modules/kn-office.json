{
 "dialogue": {
  "lines": [
   {
    "en": "Welcome! What is your name?",
    "hi": "आइए! आपका नाम क्या है?",
    "r": "Banni! Nimma hesarēnu?",
    "sp": "Manager",
    "t": "ಬನ್ನಿ! ನಿಮ್ಮ ಹೆಸರೇನು?"
   },
   {
    "en": "My name is Kumar.",
    "hi": "मेरा नाम कुमार है।",
    "r": "Nanna hesaru Kumāṛ.",
    "sp": "Newcomer",
    "t": "ನನ್ನ ಹೆಸರು ಕುಮಾರ್."
   },
   {
    "en": "This is your desk. Switch on the computer.",
    "hi": "यह आपकी मेज़ है। कंप्यूटर चालू कीजिए।",
    "r": "Idu nimma mēju. Kampyūṭar ān māḍi.",
    "sp": "Manager",
    "t": "ಇದು ನಿಮ್ಮ ಮೇಜು. ಕಂಪ್ಯೂಟರ್ ಆನ್ ಮಾಡಿ."
   },
   {
    "en": "OK. What is the email address?",
    "hi": "ठीक है। ईमेल पता क्या है?",
    "r": "Sari. Īmēl viḷāsa ēnu?",
    "sp": "Newcomer",
    "t": "ಸರಿ. ಈಮೇಲ್ ವಿಳಾಸ ಏನು?"
   },
   {
    "en": "Don't fear, the assistant will tell you.",
    "hi": "चिंता मत कीजिए, सहायक बता देगा।",
    "r": "Hedarabēḍi, asisṭeṇṭ hēḷuttāre.",
    "sp": "Manager",
    "t": "ಹೆದರಬೇಡಿ, ಅಸಿಸ್ಟೆಂಟ್ ಹೇಳುತ್ತಾರೆ."
   },
   {
    "en": "Thanks! I'll come on time tomorrow.",
    "hi": "शुक्रिया! कल समय पर आऊँगा।",
    "r": "Dhanyavādagaḷu! Nāḷe samayakke baruttēne.",
    "sp": "Newcomer",
    "t": "ಧನ್ಯವಾದಗಳು! ನಾಳೆ ಸಮಯಕ್ಕೆ ಬರುತ್ತೇನೆ."
   }
  ],
  "title": "First day at office"
 },
 "lede": "Desks, files and deadlines — Kannada for work life.",
 "phrases": [
  {
   "en": "I have a meeting",
   "hi": "मेरी मीटिंग है",
   "r": "Nanage mīṭiṅg ide",
   "t": "ನನಗೆ ಮೀಟಿಂಗ್ ಇದೆ"
  },
  {
   "en": "The boss called you",
   "hi": "बॉस ने तुम्हें बुलाया",
   "r": "Bās nimmannu karedaru",
   "t": "ಬಾಸ್ ನಿಮ್ಮನ್ನು ಕರೆದರು"
  },
  {
   "en": "Sign here",
   "hi": "यहाँ दस्तख़त करो",
   "r": "Illi sahi māḍi",
   "t": "ಇಲ್ಲಿ ಸಹಿ ಮಾಡಿ"
  },
  {
   "en": "Send the email",
   "hi": "ईमेल भेजो",
   "r": "Īmēl kaḷuhisi",
   "t": "ಈಮೇಲ್ ಕಳುಹಿಸಿ"
  },
  {
   "en": "Take a printout",
   "hi": "प्रिंट निकालो",
   "r": "Priṇṭ tegeyiri",
   "t": "ಪ್ರಿಂಟ್ ತೆಗೆಯಿರಿ"
  },
  {
   "en": "When is the salary?",
   "hi": "वेतन कब मिलेगा?",
   "r": "Sambaḷa yāvāga?",
   "t": "ಸಂಬಳ ಯಾವಾಗ?"
  },
  {
   "en": "I need leave tomorrow",
   "hi": "मुझे कल छुट्टी चाहिए",
   "r": "Nāḷe raje bēku",
   "t": "ನಾಳೆ ರಜೆ ಬೇಕು"
  },
  {
   "en": "The work is finished",
   "hi": "काम ख़त्म हो गया",
   "r": "Kelasa mugidide",
   "t": "ಕೆಲಸ ಮುಗಿದಿದೆ"
  },
  {
   "en": "Come on time",
   "hi": "समय पर आओ",
   "r": "Samayakke banni",
   "t": "ಸಮಯಕ್ಕೆ ಬನ್ನಿ"
  },
  {
   "en": "Good job!",
   "hi": "शाबाश!",
   "r": "Oḷḷeya kelasa!",
   "t": "ಒಳ್ಳೆಯ ಕೆಲಸ!"
  },
  {
   "en": "I will call back",
   "hi": "मैं वापस फ़ोन करूँगा",
   "r": "Nānu vāpas phōn māḍuttēne",
   "t": "ನಾನು ವಾಪಸ್ ಫೋನ್ ಮಾಡುತ್ತೇನೆ"
  },
  {
   "en": "See you tomorrow",
   "hi": "कल मिलते हैं",
   "r": "Nāḷe sigōṇa",
   "t": "ನಾಳೆ ಸಿಗೋಣ"
  }
 ],
