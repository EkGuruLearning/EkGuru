{
 "dialogue": {
  "lines": [
   {
    "en": "What happened to you?",
    "hi": "आपको क्या हुआ?",
    "r": "Tamne shu thayu?",
    "sp": "Doctor",
    "t": "તમને શું થયું?"
   },
   {
    "en": "Doctor, fever for two days.",
    "hi": "डॉक्टर, दो दिन से बुख़ार है।",
    "r": "Doktar, be divasthi tav chhe.",
    "sp": "Patient",
    "t": "ડૉક્ટર, બે દિવસથી તાવ છે."
   },
   {
    "en": "Any cough or cold?",
    "hi": "खाँसी-ज़ुकाम है?",
    "r": "Udharas-shardi chhe?",
    "sp": "Doctor",
    "t": "ઉધરસ-શરદી છે?"
   },
   {
    "en": "Only a cough.",
    "hi": "सिर्फ़ ख़ाँसी है।",
    "r": "Phakt udharas chhe.",
    "sp": "Patient",
    "t": "ફક્ત ઉધરસ છે."
   },
   {
    "en": "Don't fear. Take this tablet.",
    "hi": "घबराइए मत। यह गोली लीजिए।",
    "r": "Bisho nahi. Aa goli lo.",
    "sp": "Doctor",
    "t": "બીશો નહીં. આ ગોળી લો."
   },
   {
    "en": "Thanks doctor. Any diet restrictions?",
    "hi": "शुक्रिया डॉक्टर। कोई परहेज़?",
    "r": "Aabhar doktar. Kai pathya chhe?",
    "sp": "Patient",
    "t": "આભાર ડૉક્ટર. કંઈ પથ્ય છે?"
   }
  ],
  "title": "At the clinic"
 },
 "lede": "Body, symptoms and the clinic — Gujarati for staying well.",
 "phrases": [
  {
   "en": "I am not feeling well",
   "hi": "मेरी तबीयत ठीक नहीं है",
   "r": "Mane saru lagtu nathi",
   "t": "મને સારું લાગતું નથી"
  },
  {
   "en": "I have a fever",
   "hi": "मुझे बुख़ार है",
   "r": "Mane tav chhe",
   "t": "મને તાવ છે"
  },
  {
   "en": "My head aches",
   "hi": "मेरे सिर में दर्द है",
   "r": "Mathu dukhe chhe",
   "t": "માથું દુખે છે"
  },
  {
   "en": "Call a doctor",
   "hi": "डॉक्टर को बुलाओ",
   "r": "Doktarne bolavo",
   "t": "ડૉક્ટરને બોલાવો"
  },
  {
   "en": "Take me to hospital",
   "hi": "मुझे अस्पताल ले चलो",
   "r": "Mane hospital lai jao",
   "t": "મને હોસ્પિટલ લઈ જાઓ"
  },
  {
   "en": "Where is the pharmacy?",
   "hi": "दवाख़ाना कहाँ है?",
   "r": "Davani dukan kya chhe?",
   "t": "દવાની દુકાન ક્યાં છે?"
  },
  {
   "en": "Take this medicine",
   "hi": "यह दवा लो",
   "r": "Aa dava lo",
   "t": "આ દવા લો"
  },
  {
   "en": "Drink hot water",
   "hi": "गरम पानी पियो",
   "r": "Garam pani pivo",
   "t": "ગરમ પાણી પીવો"
  },
  {
   "en": "Take rest",
   "hi": "आराम करो",
   "r": "Aaram karo",
   "t": "આરામ કરો"
  },
  {
   "en": "Get well soon",
   "hi": "जल्दी ठीक हो जाओ",
   "r": "Jaldi saja thao",
   "t": "જલ્દી સાજા થાઓ"
  },
  {
   "en": "Open your mouth",
   "hi": "मुँह खोलो",
   "r": "Modhu kholo",
   "t": "મોઢું ખોલો"
  },
  {
   "en": "Breathe deeply",
   "hi": "गहरी साँस लो",
   "r": "Undo shvas lo",
   "t": "ઊંડો શ્વાસ લો"
  }
