{
  "dialogue": {
    "lines": [
      {
        "en": "Did you finish homework?",
        "hi": "होमवर्क पूरा किया?",
        "r": "Hōmvark pūrti chēśāvā?",
        "sp": "Father",
        "t": "హోమ్‌వర్క్ పూర్తి చేశావా?"
      },
      {
        "en": "Only maths left, father.",
        "hi": "सिर्फ़ गणित बाक़ी है, पापा।",
        "r": "Lekkalu mātramē migilāyi, nānna.",
        "sp": "Son",
        "t": "లెక్కలు మాత్రమే మిగిలాయి, నాన్న."
      },
      {
        "en": "Where's the doubt? Show me.",
        "hi": "कहाँ शंका है? दिखा।",
        "r": "Ekkaḍa anumānaṁ? Chūpiñchu.",
        "sp": "Father",
        "t": "ఎక్కడ అనుమానం? చూపించు."
      },
      {
        "en": "I don't get this sum.",
        "hi": "यह सवाल समझ नहीं आया।",
        "r": "Ī lekka arthaṁ kālēdu.",
        "sp": "Son",
        "t": "ఈ లెక్క అర్థం కాలేదు."
      },
      {
        "en": "Look, you must do it like this.",
        "hi": "देख, ऐसे करना चाहिए।",
        "r": "Chūḍu, ilā chēyāli.",
        "sp": "Father",
        "t": "చూడు, ఇలా చేయాలి."
      },
      {
        "en": "Got it! Tomorrow I'll show it first.",
        "hi": "समझ गया! कल सबसे पहले दिखाऊँगा।",
        "r": "Arthamaindi! Rēpu mundugā chūpistānu.",
        "sp": "Son",
        "t": "అర్థమైంది! రేపు ముందుగా చూపిస్తాను."
      }
    ],
    "title": "Homework trouble"
  },
