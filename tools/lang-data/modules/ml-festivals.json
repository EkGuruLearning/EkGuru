{
 "dialogue": {
  "lines": [
   {
    "en": "Happy Onam! Greetings!",
    "hi": "ओणम की शुभकामनाएँ!",
    "r": "Onashamsakal!",
    "sp": "Neighbour",
    "t": "ഓണാശംസകൾ!"
   },
   {
    "en": "Same to you! Come for the feast.",
    "hi": "आपको भी! सद्या के लिए आइए।",
    "r": "Ningngalkkum! Sadhyaykk varu.",
    "sp": "Mother",
    "t": "നിങ്ങൾക്കും! സദ്യയ്ക്ക് വരൂ."
   },
   {
    "en": "The flower carpet is beautiful!",
    "hi": "पूकलम सुंदर है!",
    "r": "Pukkalam manoharam!",
    "sp": "Neighbour",
    "t": "പൂക്കളം മനോഹരം!"
   },
   {
    "en": "In the evening there is boat race on TV.",
    "hi": "शाम को टीवी पर नौका दौड़ है।",
    "r": "Vaikunneram tiviyil vallamkali unt.",
    "sp": "Mother",
    "t": "വൈകുന്നേരം ടിവിയിൽ വള്ളംകളി ഉണ്ട്."
   },
   {
    "en": "We'll all come. Wear new clothes!",
    "hi": "हम सब आएँगे। नए कपड़े पहनना!",
    "r": "Nanngal ellavarum varam. Putuvastram ittu!",
    "sp": "Neighbour",
    "t": "ഞങ്ങൾ എല്ലാവരും വരാം. പുതുവസ്ത്രം ഇട്ടൂ!"
   }
  ],
  "title": "Onam greetings"
 },
 "lede": "Onam, Vishu and temple fairs — Malayalam for celebrations.",
