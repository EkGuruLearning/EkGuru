   "t": "ബോസ് നിങ്ങളെ വിളിച്ചു"
  },
  {
   "en": "Sign here",
   "hi": "यहाँ दस्तख़त करो",
   "r": "Ivite oppitu",
   "t": "ഇവിടെ ഒപ്പിടൂ"
  },
  {
   "en": "Send the email",
   "hi": "ईमेल भेजो",
   "r": "Imeil ayaykku",
   "t": "ഇമെയിൽ അയയ്ക്കൂ"
  },
  {
   "en": "Take a printout",
   "hi": "प्रिंट निकालो",
   "r": "Print etukku",
   "t": "പ്രിന്റ് എടുക്കൂ"
  },
  {
   "en": "When is the salary?",
   "hi": "वेतन कब मिलेगा?",
   "r": "Shampalam eppozhaan?",
   "t": "ശമ്പളം എപ്പോഴാണ്?"
  },
  {
   "en": "I need leave tomorrow",
   "hi": "मुझे कल छुट्टी चाहिए",
   "r": "Nale enikk avadhi venam",
   "t": "നാളെ എനിക്ക് അവധി വേണം"
  },
  {
   "en": "The work is finished",
   "hi": "काम ख़त्म हो गया",
   "r": "Joli tirnnu",
   "t": "ജോലി തീർന്നു"
  },
  {
   "en": "Come on time",
   "hi": "समय पर आओ",
   "r": "Krityasamayatt varu",
   "t": "കൃത്യസമയത്ത് വരൂ"
  },
  {
   "en": "Good job!",
   "hi": "शाबाश!",
   "r": "Nalla joli!",
   "t": "നല്ല ജോലി!"
  },
  {
   "en": "I will call back",
   "hi": "मैं वापस फ़ोन करूँगा",
   "r": "Ñan tirike vilikkam",
   "t": "ഞാൻ തിരികെ വിളിക്കാം"
  },
  {
   "en": "See you tomorrow",
   "hi": "कल मिलते हैं",
   "r": "Nale kanam",
   "t": "നാളെ കാണാം"
  }
