{
 "dialogue": {
  "lines": [
   {
    "en": "Welcome! What is your name?",
    "hi": "आइए! आपका नाम क्या है?",
    "r": "Varu! Ningngalute perentaan?",
    "sp": "Manager",
    "t": "വരൂ! നിങ്ങളുടെ പേരെന്താണ്?"
   },
   {
    "en": "My name is Kumar.",
    "hi": "मेरा नाम कुमार है।",
    "r": "Ente per Kumar.",
    "sp": "Newcomer",
    "t": "എന്റെ പേര് കുമാർ."
   },
   {
    "en": "This is your desk. Switch on the computer.",
    "hi": "यह आपकी मेज़ है। कंप्यूटर चालू कीजिए।",
    "r": "It ningngalute meshayaan. Kampyuttar on cheyyu.",
    "sp": "Manager",
    "t": "ഇത് നിങ്ങളുടെ മേശയാണ്. കമ്പ്യൂട്ടർ ഓൺ ചെയ്യൂ."
   },
   {
    "en": "OK. What is the email address?",
    "hi": "ठीक है। ईमेल पता क्या है?",
    "r": "Shari. Imeil vilasamentaan?",
    "sp": "Newcomer",
    "t": "ശരി. ഇമെയിൽ വിലാസമെന്താണ്?"
   },
   {
    "en": "Don't fear, the assistant will tell you.",
    "hi": "चिंता मत कीजिए, सहायक बता देगा।",
    "r": "Pedikkanta, asistant paranñutarum.",
    "sp": "Manager",
    "t": "പേടിക്കണ്ട, അസിസ്റ്റന്റ് പറഞ്ഞുതരും."
   },
   {
    "en": "Thanks! I'll come on time tomorrow.",
    "hi": "शुक्रिया! कल समय पर आऊँगा।",
    "r": "Nandi! Nale krityasamayatt varam.",
    "sp": "Newcomer",
    "t": "നന്ദി! നാളെ കൃത്യസമയത്ത് വരാം."
   }
  ],
  "title": "First day at office"
 },
 "lede": "Desks, files and deadlines — Malayalam for work life.",
 "phrases": [
  {
   "en": "I have a meeting",
   "hi": "मेरी मीटिंग है",
