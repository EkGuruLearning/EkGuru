{
 "dialogue": {
  "lines": [
   {
    "en": "Teacher, I finished my homework.",
    "hi": "गुरुजी, मैंने अपना काम पूरा किया।",
    "r": "Gurugaḷē, nanna manekelasa mugisidēne.",
    "sp": "Student",
    "t": "ಗುರುಗಳೇ, ನನ್ನ ಮನೆಕೆಲಸ ಮುಗಿಸಿದ್ದೇನೆ."
   },
   {
    "en": "Very good! Read the lesson loudly.",
    "hi": "बहुत अच्छा! पाठ ज़ोर से पढ़ो।",
    "r": "Tumbā oḷḷeyadu! Pāṭhavannu gaṭṭiyāgi ōdu.",
    "sp": "Teacher",
    "t": "ತುಂಬಾ ಒಳ್ಳೆಯದು! ಪಾಠವನ್ನು ಗಟ್ಟಿಯಾಗಿ ಓದು."
   },
   {
    "en": "I don't understand this word.",
    "hi": "यह शब्द समझ नहीं आया।",
    "r": "Ī śabda artha āgalilla.",
    "sp": "Student",
    "t": "ಈ ಶಬ್ದ ಅರ್ಥ ಆಗಲಿಲ್ಲ."
   },
   {
    "en": "Look in the dictionary.",
    "hi": "शब्दकोश में देखो।",
    "r": "Nighaṇṭinalli nōḍu.",
    "sp": "Teacher",
    "t": "ನಿಘಂಟಿನಲ್ಲಿ ನೋಡು."
   },
   {
    "en": "OK teacher. What is the exam date?",
    "hi": "ठीक है गुरुजी। परीक्षा कब है?",
    "r": "Sari gurugaḷē. Parīkshe yāvāga?",
    "sp": "Student",
    "t": "ಸರಿ ಗುರುಗಳೇ. ಪರೀಕ್ಷೆ ಯಾವಾಗ?"
   },
   {
    "en": "Next month. Now sit and study.",
    "hi": "अगले महीने। अब बैठकर पढ़ो।",
    "r": "Mundina tiṅgaḷu. Īga kūtu ōdu.",
    "sp": "Teacher",
    "t": "ಮುಂದಿನ ತಿಂಗಳು. ಈಗ ಕೂತು ಓದು."
   }
  ],
  "title": "In the classroom"
 },
 "lede": "Schools, lessons and exams — Kannada for the classroom.",
 "phrases": [
  {
   "en": "Open the book",
   "hi": "किताब खोलो",
   "r": "Pustaka tereyiri",
   "t": "ಪುಸ್ತಕ ತೆರೆಯಿರಿ"
  },
  {
   "en": "Read loudly",
   "hi": "ज़ोर से पढ़ो",
   "r": "Gaṭṭiyāgi ōdi",
   "t": "ಗಟ್ಟಿಯಾಗಿ ಓದಿ"
  },
  {
   "en": "Write neatly",
   "hi": "साफ़-साफ़ लिखो",
   "r": "Channāgi bareyiri",
   "t": "ಚೆನ್ನಾಗಿ ಬರೆಯಿರಿ"
  },
  {
   "en": "Listen carefully",
   "hi": "ध्यान से सुनो",
   "r": "Gaṇakke tegedukoḷḷi",
   "t": "ಗಮನವಿಟ್ಟು ಕೇಳಿ"
  },
  {
   "en": "Say it again",
   "hi": "फिर से कहो",
   "r": "Matte hēḷi",
   "t": "ಮತ್ತೆ ಹೇಳಿ"
  },
  {
   "en": "I understood",
   "hi": "मैं समझ गया",
   "r": "Nanage arthavāyitu",
   "t": "ನನಗೆ ಅರ್ಥವಾಯಿತು"
  },
  {
   "en": "I did not understand",
   "hi": "समझ नहीं आया",
   "r": "Artha āgalilla",
   "t": "ಅರ್ಥ ಆಗಲಿಲ್ಲ"
  },
  {
   "en": "What is the homework?",
   "hi": "गृहकार्य क्या है?",
   "r": "Manekelasa ēnu?",
   "t": "ಮನೆಕೆಲಸ ಏನು?"
  },
  {
   "en": "When is the exam?",
   "hi": "परीक्षा कब है?",
   "r": "Parīkshe yāvāga?",
   "t": "ಪರೀಕ್ಷೆ ಯಾವಾಗ?"
  },
  {
   "en": "I passed!",
   "hi": "मैं पास हो गया!",
   "r": "Nānu pāsu!",
   "t": "ನಾನು ಪಾಸು!"
  },
  {
   "en": "Sit quietly",
   "hi": "चुपचाप बैठो",
   "r": "Sumne kūti",
   "t": "ಸುಮ್ಮನೆ ಕೂತಿ"
  },
  {
   "en": "Well done!",
   "hi": "शाबाश!",
   "r": "Tumbā oḷḷeyadu!",
   "t": "ತುಂಬಾ ಒಳ್ಳೆಯದು!"
  }
