{
 "dialogue": {
  "lines": [
   {
    "en": "Grandma, what is cooking?",
    "hi": "दादी, क्या बन रहा है?",
    "r": "Muttashshi, entaan veykkunnat?",
    "sp": "Granddaughter",
    "t": "മുത്തശ്ശി, എന്താണ് വെയ്ക്കുന്നത്?"
   },
   {
    "en": "Puttu and kadala, my dear!",
    "hi": "पुट्टु और कडाला, मेरी बच्ची!",
    "r": "Puttum katalayum, ente monu!",
    "sp": "Grandmother",
    "t": "പുട്ടും കടലയും, എന്റെ മോളൂ!"
   },
   {
    "en": "Wash your hands and sit.",
    "hi": "हाथ धोकर बैठो।",
    "r": "Kai kazhuki irikku.",
    "sp": "Grandmother",
    "t": "കൈ കഴുകി ഇരിക്കൂ."
   },
   {
    "en": "Grandma, the food smells nice!",
    "hi": "दादी, खाना महक रहा है!",
    "r": "Muttashshi, un manam varunnu!",
    "sp": "Granddaughter",
    "t": "മുത്തശ്ശി, ഊണ് മണം വരുന്നു!"
   },
   {
    "en": "Eat well. Shall I serve more?",
    "hi": "अच्छे से खा। और परोसूँ?",
    "r": "Nannayi unnu. Iniyum vilambatte?",
    "sp": "Grandmother",
    "t": "നന്നായി ഉണ്ണൂ. ഇനിയും വിളമ്പട്ടെ?"
   },
   {
    "en": "Yes grandma! Your hand is magic.",
    "hi": "हाँ दादी! तुम्हारे हाथ में जादू है।",
    "r": "Ate muttashshi! Ninte kaiyil mantrikamunt.",
    "sp": "Granddaughter",
    "t": "അതെ മുത്തശ്ശി! നിന്റെ കൈയില് മന്ത്രികമുണ്ട്."
   }
  ],
  "title": "Grandma's kitchen"
 },
