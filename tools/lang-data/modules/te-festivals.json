{
  "dialogue": {
    "lines": [
      {
        "en": "Wake up! Today is Sankranti.",
        "hi": "उठो! आज संक्रांति है।",
        "r": "Lēvarā! Īrōju saṅkrānti.",
        "sp": "Grandmother",
        "t": "లేవరా! ఈరోజు సంక్రాంతి."
      },
      {
        "en": "Grandma, did you draw the muggu?",
        "hi": "दादी, मुग्गु बना दिया?",
        "r": "Avvā, muggu vēśāvā?",
        "sp": "Girl",
        "t": "అవ్వా, ముగ్గు వేశావా?"
      },
      {
        "en": "Done. Fetch the sugarcane.",
        "hi": "बना दिया। गन्ना ला।",
        "r": "Vēśānu. Cheraku tīsukurā.",
        "sp": "Grandmother",
        "t": "వేశాను. చెరకు తీసుకురా."
      },
      {
        "en": "The kites are flying!",
        "hi": "पतंगें उड़ रही हैं!",
        "r": "Pataṅgulu egurutunnāyi!",
        "sp": "Girl",
        "t": "పతంగులు ఎగురుతున్నాయి!"
      },
      {
        "en": "Wow! How lovely they are!",
        "hi": "वाह! कितनी सुंदर हैं!",
        "r": "Āhā! Enta bāgunnāyō!",
        "sp": "Grandmother",
        "t": "ఆహా! ఎంత బాగున్నాయో!"
      },
      {
        "en": "Let's thank the sun.",
        "hi": "सूरज को शुक्रिया कहें।",
        "r": "Sūryuḍiki dhanyavādālu chepdāṁ.",
        "sp": "Girl",
        "t": "సూర్యుడికి ధన్యవాదాలు చెప్దాం."
      }
    ],
    "title": "Sankranti morning"
  },
  "lede": "Sankranti, muggu and jathara — celebrate the Telugu year.",
  "phrases": [
    {
      "en": "Happy Sankranti",
      "hi": "संक्रांति की शुभकामनाएँ",
      "r": "Saṅkrānti śubhākāṅkshalu",
      "t": "సంక్రాంతి శుభాకాంక్షలు"
    },
    {
      "en": "Happy Diwali",
      "hi": "दीपावली की शुभकामनाएँ",
      "r": "Dīpāvaḷi śubhākāṅkshalu",
      "t": "దీపావళి శుభాకాంక్షలు"
    },
    {
      "en": "Eid Mubarak",
      "hi": "ईद मुबारक",
      "r": "Īd mubārak",
      "t": "ఈద్ ముబారక్"
    },
    {
      "en": "Merry Christmas",
      "hi": "क्रिसमस की शुभकामनाएँ",
      "r": "Krismas śubhākāṅkshalu",
      "t": "క్రిస్మస్ శుభాకాంక్షలు"
    },
    {
      "en": "Happy New Year",
      "hi": "नववर्ष की शुभकामनाएँ",
      "r": "Nūtana saṁvatsara śubhākāṅkshalu",
      "t": "నూతన సంవత్సర శుభాకాంక్షలు"
    },
    {
      "en": "Let's go to the temple",
      "hi": "मंदिर चलो",
      "r": "Guḍiki veḷdāṁ",
      "t": "గుడికి వెళ్దాం"
    },
    {
      "en": "The idol is beautiful",
      "hi": "मूर्ति सुंदर है",
      "r": "Vigrahaṁ chālā andaṅgā undi",
      "t": "విగ్రహం చాలా అందంగా ఉంది"
    },
    {
      "en": "Light the lamp",
      "hi": "दीया जलाओ",
      "r": "Dīpaṁ veligiñchu",
      "t": "దీపం వెలిగించు"
    },
    {
      "en": "Take the blessing",
      "hi": "आशीर्वाद लो",
      "r": "Āśīrvādaṁ tīsukō",
      "t": "ఆశీర్వాదం తీసుకో"
    },
    {
      "en": "Come for the feast",
      "hi": "भोज पर आओ",
      "r": "Vinduku rā",
      "t": "విందుకు రా"
    },
    {
      "en": "What did you get?",
      "hi": "तुम्हें क्या मिला?",
      "r": "Nīku ēmochchindi?",
      "t": "నీకు ఏమొచ్చింది?"
    },
    {
      "en": "Happy Ugadi!",
      "hi": "उगादि की शुभकामनाएँ!",
      "r": "Ugādi śubhākāṅkshalu!",
      "t": "ఉగాది శుభాకాంక్షలు!"
    }
  ],
