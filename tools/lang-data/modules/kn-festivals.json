  },
  {
   "en": "Wear new clothes",
   "hi": "नए कपड़े पहनो",
   "r": "Hosa baṭṭe hākkoḷḷi",
   "t": "ಹೊಸ ಬಟ್ಟೆ ಹಾಕಿಕೊಳ್ಳಿ"
  },
  {
   "en": "Light the lamp",
   "hi": "दीया जलाओ",
   "r": "Dīpa hachchiri",
   "t": "ದೀಪ ಹಚ್ಚಿರಿ"
  },
  {
   "en": "Offer prayers",
   "hi": "पूजा करो",
   "r": "Pūje māḍi",
   "t": "ಪೂಜೆ ಮಾಡಿ"
  },
  {
   "en": "Go to the temple",
   "hi": "मंदिर जाओ",
   "r": "Dēvasthānakke hōgi",
   "t": "ದೇವಸ್ಥಾನಕ್ಕೆ ಹೋಗಿ"
  },
  {
   "en": "Happy Dasara!",
   "hi": "दशहरा मुबारक!",
   "r": "Dasarā habba śubhavāgali!",
   "t": "ದಸರಾ ಹಬ್ಬ ಶುಭವಾಗಲಿ!"
  }
 ],
