{
 "dialogue": {
  "lines": [
   {
    "en": "Happy Ugadi! New Year greetings!",
    "hi": "उगादि की शुभकामनाएँ!",
    "r": "Ugādiya śubhāśayagaḷu!",
    "sp": "Neighbour",
    "t": "ಉಗಾದಿಯ ಶುಭಾಶಯಗಳು!"
   },
   {
    "en": "Same to you! Come, eat bevu-bella.",
    "hi": "आपको भी! आइए, बेवु-बेल्ला खाइए।",
    "r": "Nimage kūḍa! Banni, bēvu-bella tinnī.",
    "sp": "Mother",
    "t": "ನಿಮಗೆ ಕೂಡ! ಬನ್ನಿ, ಬೇವು-ಬೆಲ್ಲ ತಿನ್ನಿ."
   },
   {
    "en": "Sweet and bitter — like life.",
    "hi": "मीठा और कड़वा — ज़िंदगी जैसा।",
    "r": "Sihi hāgū kahi — jīvana hāge.",
    "sp": "Neighbour",
    "t": "ಸಿಹಿ ಹಾಗೂ ಕಹಿ — ಜೀವನ ಹಾಗೆ."
   },
   {
    "en": "In the evening there is a procession.",
    "hi": "शाम को जुलूस है।",
    "r": "Sanje meravaṇige ide.",
    "sp": "Mother",
    "t": "ಸಂಜೆ ಮೆರವಣಿಗೆ ಇದೆ."
   },
   {
    "en": "We'll all come. Wear new clothes!",
    "hi": "हम सब आएँगे। नए कपड़े पहनना!",
    "r": "Nāvu ellarū baruttēve. Hosa baṭṭe hāko!",
    "sp": "Neighbour",
    "t": "ನಾವು ಎಲ್ಲರೂ ಬರುತ್ತೇವೆ. ಹೊಸ ಬಟ್ಟೆ ಹಾಕೋ!"
   }
  ],
  "title": "Ugadi greetings"
 },
 "lede": "Ugadi, Dasara and village fairs — Kannada for celebrations.",
 "phrases": [
  {
   "en": "Happy festival!",
   "hi": "त्यौहार मुबारक!",
   "r": "Habba śubhava!",
   "t": "ಹಬ್ಬ ಶುಭವಾಗಲಿ!"
  },
  {
   "en": "Happy New Year!",
   "hi": "नया साल मुबारक!",
   "r": "Hosa varsha śubhava!",
   "t": "ಹೊಸ ವರ್ಷ ಶುಭವಾಗಲಿ!"
  },
  {
   "en": "Come to our house",
   "hi": "हमारे घर आओ",
