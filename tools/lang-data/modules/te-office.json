{
  "dialogue": {
    "lines": [
      {
        "en": "Welcome! What is your name?",
        "hi": "आइए! आपका नाम क्या है?",
        "r": "Raṇḍi! Mī pēru ēṇṭi?",
        "sp": "Manager",
        "t": "రండి! మీ పేరు ఏంటి?"
      },
      {
        "en": "My name is Kumar.",
        "hi": "मेरा नाम कुमार है।",
        "r": "Nā pēru Kumāṛ.",
        "sp": "Newcomer",
        "t": "నా పేరు కుమార్."
      },
      {
        "en": "This is your desk. Switch on the computer.",
        "hi": "यह आपकी मेज़ है। कंप्यूटर चालू कीजिए।",
        "r": "Idi mī ṭēbul. Kampyūṭar ān chēyaṇḍi.",
        "sp": "Manager",
        "t": "ఇది మీ టేబుల్. కంప్యూటర్ ఆన్ చేయండి."
      },
      {
        "en": "OK. What is the email address?",
        "hi": "ठीक है। ईमेल पता क्या है?",
        "r": "Sarē. Īmeyil aḍras ēṇṭi?",
        "sp": "Newcomer",
        "t": "సరే. ఈమెయిల్ అడ్రస్ ఏంటి?"
      },
      {
        "en": "Don't worry, the assistant will tell you.",
        "hi": "चिंता मत कीजिए, सहायक बता देगा।",
        "r": "Bhayapaḍakaṇḍi, asisṭeṇṭ cheptāru.",
        "sp": "Manager",
        "t": "భయపడకండి, అసిస్టెంట్ చెప్తారు."
      },
      {
        "en": "Thanks! I'll come on time tomorrow.",
        "hi": "शुक्रिया! कल समय पर आऊँगा।",
        "r": "Dhanyavādālu! Rēpu samayāniki vastānu.",
        "sp": "Newcomer",
        "t": "ధన్యవాదాలు! రేపు సమయానికి వస్తాను."
      }
    ],
    "title": "First day at office"
  },
  "lede": "Desks, files and deadlines — Telugu for work life.",
  "phrases": [
    {
      "en": "I have a meeting",
      "hi": "मेरी मीटिंग है",
      "r": "Nāku mīṭiṅg undi",
      "t": "నాకు మీటింగ్ ఉంది"
    },
    {
      "en": "The boss called you",
      "hi": "बॉस ने तुम्हें बुलाया",
      "r": "Bās mimmalni pilichāru",
      "t": "బాస్ మిమ్మల్ని పిలిచారు"
    },
    {
      "en": "Sign here",
      "hi": "यहाँ दस्तख़त करो",
      "r": "Ikkaḍa santakaṁ chēyaṇḍi",
      "t": "ఇక్కడ సంతకం చేయండి"
    },
    {
      "en": "Send the email",
      "hi": "ईमेल भेजो",
      "r": "Īmeyil pampaṇḍi",
      "t": "ఈమెయిల్ పంపండి"
    },
    {
      "en": "Take a printout",
      "hi": "प्रिंट निकालो",
      "r": "Priṇṭ tīyaṇḍi",
      "t": "ప్రింట్ తీయండి"
    },
    {
      "en": "When is the salary?",
      "hi": "वेतन कब मिलेगा?",
      "r": "Jītaṁ eppuḍu?",
      "t": "జీతం ఎప్పుడు?"
    },
    {
      "en": "I need leave tomorrow",
      "hi": "मुझे कल छुट्टी चाहिए",
      "r": "Rēpu selavu kāvāli",
      "t": "రేపు సెలవు కావాలి"
    },
    {
      "en": "The work is finished",
      "hi": "काम ख़त्म हो गया",
      "r": "Pani pūrtayindi",
      "t": "పని పూర్తయింది"
    },
    {
      "en": "Come on time",
      "hi": "समय पर आओ",
      "r": "Samayāniki raṇḍi",
      "t": "సమయానికి రండి"
    },
    {
      "en": "Good job!",
      "hi": "शाबाश!",
      "r": "Mañchi pani!",
      "t": "మంచి పని!"
    },
    {
      "en": "I will call back",
      "hi": "मैं वापस फ़ोन करूँगा",
      "r": "Tirigi phōn chēstānu",
      "t": "తిరిగి ఫోన్ చేస్తాను"
    },
    {
      "en": "See you tomorrow",
      "hi": "कल मिलते हैं",
      "r": "Rēpu kaluddāṁ",
      "t": "రేపు కలుద్దాం"
    }
  ],
