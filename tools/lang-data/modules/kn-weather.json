 "dialogue": {
  "lines": [
   {
    "en": "Look, dark clouds in the sky!",
    "hi": "देखो, आसमान में काले बादल!",
    "r": "Nōḍu, ākāśadalli kappu mōḍagaḷu!",
    "sp": "Brother",
    "t": "ನೋಡು, ಆಕಾಶದಲ್ಲಿ ಕಪ್ಪು ಮೋಡಗಳು!"
   },
   {
    "en": "Yes. Rain will come today.",
    "hi": "हाँ। आज बारिश आएगी।",
    "r": "Haudu. Ivattu maḷe baruttade.",
    "sp": "Sister",
    "t": "ಹೌದು. ಇವತ್ತು ಮಳೆ ಬರುತ್ತದೆ."
