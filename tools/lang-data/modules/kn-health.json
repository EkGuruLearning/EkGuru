{
 "dialogue": {
  "lines": [
   {
    "en": "What happened to you?",
    "hi": "आपको क्या हुआ?",
    "r": "Nimage ēnāgide?",
    "sp": "Doctor",
    "t": "ನಿಮಗೆ ಏನಾಗಿದೆ?"
   },
   {
    "en": "Doctor, fever for two days.",
    "hi": "डॉक्टर, दो दिन से बुख़ार है।",
    "r": "Ḍākṭarē, eraḍu dinagaḷinda jvara.",
    "sp": "Patient",
    "t": "ಡಾಕ್ಟರೇ, ಎರಡು ದಿನಗಳಿಂದ ಜ್ವರ."
   },
   {
    "en": "Any cough or cold?",
    "hi": "खाँसी-ज़ुकाम है?",
    "r": "Kemmu, śīta ideyē?",
    "sp": "Doctor",
    "t": "ಕೆಮ್ಮು, ಶೀತ ಇದೆಯೇ?"
   },
   {
    "en": "Only a cough.",
    "hi": "सिर्फ़ ख़ाँसी है।",
    "r": "Kemmu mātra ide.",
    "sp": "Patient",
    "t": "ಕೆಮ್ಮು ಮಾತ್ರ ಇದೆ."
   },
   {
    "en": "Don't fear. Take this tablet.",
    "hi": "घबराइए मत। यह गोली लीजिए।",
    "r": "Hedarabēḍi. Ī mātre tegedukoḷḷi.",
    "sp": "Doctor",
    "t": "ಹೆದರಬೇಡಿ. ಈ ಮಾತ್ರೆ ತೆಗೆದುಕೊಳ್ಳಿ."
   },
   {
    "en": "Thanks doctor. Any diet restrictions?",
    "hi": "शुक्रिया डॉक्टर। कोई परहेज़?",
    "r": "Dhanyavādagaḷu ḍākṭarē. Pathya ēnādarū ideyē?",
    "sp": "Patient",
    "t": "ಧನ್ಯವಾದಗಳು ಡಾಕ್ಟರೇ. ಪಥ್ಯ ಏನಾದರೂ ಇದೆಯೇ?"
   }
  ],
  "title": "At the clinic"
 },
 "lede": "Body, symptoms and the clinic — Kannada for staying well.",
 "phrases": [
  {
   "en": "I am not feeling well",
   "hi": "मेरी तबीयत ठीक नहीं है",
   "r": "Nanage ārāmilla",
   "t": "ನನಗೆ ಆರಾಮಿಲ್ಲ"
  },
  {
   "en": "I have a fever",
   "hi": "मुझे बुख़ार है",
   "r": "Nanage jvara",
   "t": "ನನಗೆ ಜ್ವರ"
  },
  {
   "en": "My head aches",
   "hi": "मेरे सिर में दर्द है",
   "r": "Tale nōyuttide",
   "t": "ತಲೆ ನೋಯುತ್ತಿದೆ"
  },
  {
   "en": "Call a doctor",
   "hi": "डॉक्टर को बुलाओ",
   "r": "Ḍākṭarannu kareyiri",
   "t": "ಡಾಕ್ಟರನ್ನು ಕರೆಯಿರಿ"
  },
  {
   "en": "Take me to hospital",
   "hi": "मुझे अस्पताल ले चलो",
   "r": "Nannannu āspatrege karedukoṇḍu hōgi",
   "t": "ನನ್ನನ್ನು ಆಸ್ಪತ್ರೆಗೆ ಕರೆದುಕೊಂಡು ಹೋಗಿ"
  },
  {
   "en": "Where is the pharmacy?",
   "hi": "दवाख़ाना कहाँ है?",
   "r": "Ōshadhi aṅgaḍi elli?",
   "t": "ಔಷಧಿ ಅಂಗಡಿ ಎಲ್ಲಿ?"
  },
  {
   "en": "Take this medicine",
   "hi": "यह दवा लो",
   "r": "Ī ōshadhi tegedukoḷḷi",
   "t": "ಈ ಔಷಧಿ ತೆಗೆದುಕೊಳ್ಳಿ"
  },
  {
   "en": "Drink hot water",
   "hi": "गरम पानी पियो",
   "r": "Bisi nīru kuḍiyiri",
   "t": "ಬಿಸಿ ನೀರು ಕುಡಿಯಿರಿ"
  },
  {
   "en": "Take rest",
   "hi": "आराम करो",
   "r": "Viśrānti tegedukoḷḷi",
   "t": "ವಿಶ್ರಾಂತಿ ತೆಗೆದುಕೊಳ್ಳಿ"
  },
  {
   "en": "Get well soon",
   "hi": "जल्दी ठीक हो जाओ",
   "r": "Bēga guṇavāgali",
   "t": "ಬೇಗ ಗುಣವಾಗಲಿ"
  },
  {
   "en": "Open your mouth",
   "hi": "मुँह खोलो",
   "r": "Bāyi tereyiri",
   "t": "ಬಾಯಿ ತೆರೆಯಿರಿ"
  },
  {
   "en": "Breathe deeply",
   "hi": "गहरी साँस लो",
   "r": "Āḷavāgi usirāḍi",
   "t": "ಆಳವಾಗಿ ಉಸಿರಾಡಿ"
  }
 ],
