{
 "dialogue": {
  "lines": [
   {
    "en": "Teacher, I finished my homework.",
    "hi": "गुरुजी, मैंने अपना काम पूरा किया।",
    "r": "Guruji, majha gruhpath sampala.",
    "sp": "Student",
    "t": "गुरुजी, माझा गृहपाठ संपला."
   },
   {
    "en": "Very good! Read the lesson loudly.",
    "hi": "बहुत अच्छा! पाठ ज़ोर से पढ़ो।",
    "r": "Khup chhan! Dhada mothyane vach.",
    "sp": "Teacher",
    "t": "खूप छान! धडा मोठ्याने वाच."
   },
   {
    "en": "I don't understand this word.",
    "hi": "यह शब्द समझ नहीं आया।",
    "r": "Ha shabd samajla nahi.",
    "sp": "Student",
    "t": "हा शब्द समजला नाही."
   },
   {
    "en": "Look in the dictionary.",
    "hi": "शब्दकोश में देखो।",
    "r": "Shabdakoshat bagh.",
    "sp": "Teacher",
    "t": "शब्दकोशात बघ."
   },
   {
    "en": "OK teacher. When is the exam?",
    "hi": "ठीक है गुरुजी। परीक्षा कब है?",
    "r": "Thik ahe guruji. Pariksha kevha ahe?",
    "sp": "Student",
    "t": "ठीक आहे गुरुजी. परीक्षा केव्हा आहे?"
   },
   {
    "en": "Next month. Now sit and study.",
    "hi": "अगले महीने। अब बैठकर पढ़ो।",
    "r": "Pudhchya mahinyat. Ata basun abhyas kar.",
    "sp": "Teacher",
    "t": "पुढच्या महिन्यात. आता बसून अभ्यास कर."
   }
  ],
  "title": "In the classroom"
 },
