{"dialogue": {"lines": [{"en": "Welcome! What is your name?", "hi": "आइए! आपका नाम क्या है?", "r": "Aao ji! Tuhada naam ki hai?", "sp": "Manager", "t": "ਆਓ ਜੀ! ਤੁਹਾਡਾ ਨਾਮ ਕੀ ਹੈ?"}, {"en": "My name is Kumar.", "hi": "मेरा नाम कुमार है।", "r": "Mera naam Kumar.", "sp": "Newcomer", "t": "ਮੇਰਾ ਨਾਮ ਕੁਮਾਰ."}, {"en": "This is your desk. Switch on the computer.", "hi": "यह आपकी मेज़ है। कंप्यूटर चालू कीजिए।", "r": "Eh tuhada desk. Computer chalu karo.", "sp": "Manager", "t": "ਇਹ ਤੁਹਾਡਾ ਡੈਸਕ. ਕੰਪਿਊਟਰ ਚਾਲੂ ਕਰੋ."}, {"en": "OK. What is the email address?", "hi": "ठीक है। ईमेल पता क्या है?", "r": "Theek hai. Email pata ki hai?", "sp": "Newcomer", "t": "ਠੀਕ ਹੈ। ਈਮੇਲ ਪਤਾ ਕੀ ਹੈ?"}, {"en": "Don't worry, the assistant will tell you.", "hi": "चिंता मत कीजिए, सहायक बता देगा।", "r": "Fikar na karo, sahayak das devega.", "sp": "Manager", "t": "ਫ਼ਿਕਰ ਨਾ ਕਰੋ, ਸਹਾਇਕ ਦੱਸ ਦੇਵੇਗਾ."}, {"en": "Thanks! I'll come on time tomorrow.", "hi": "शुक्रिया! कल समय पर आऊँगा।", "r": "Shukriya! Kallh samay sir aavanga.", "sp": "Newcomer", "t": "ਸ਼ੁਕਰੀਆ! ਕੱਲ੍ਹ ਸਮੇਂ ਸਿਰ ਆਵਾਂਗਾ।"}], "title": "First day at office"}, "lede": "Desks, files and deadlines — Punjabi for work life.", "phrases": [{"en": "I have a meeting", "hi": "मेरी मीटिंग है", "r": "Meri meeting hai", "t": "ਮੇਰੀ ਮੀਟਿੰਗ ਹੈ"}, {"en": "The boss called you", "hi": "बॉस ने तुम्हें बुलाया", "r": "Boss ne tuhanu bulaya", "t": "ਬੌਸ ਨੇ ਤੁਹਾਨੂੰ ਬੁਲਾਇਆ"}, {"en": "Sign here", "hi": "यहाँ दस्तख़त करो", "r": "Itthe dastakhat karo", "t": "ਇੱਥੇ ਦਸਤਖ਼ਤ ਕਰੋ"}, {"en": "Send the email", "hi": "ईमेल भेजो", "r": "Email bhejo", "t": "ਈਮੇਲ ਭੇਜੋ"}, {"en": "Take a printout", "hi": "प्रिंट निकालो", "r": "Print kaddo", "t": "ਪ੍ਰਿੰਟ ਕੱਢੋ"}, {"en": "When is the salary?", "hi": "वेतन कब मिलेगा?", "r": "Tankhah kadon milegi?", "t": "ਤਨਖ਼ਾਹ ਕਦੋਂ ਮਿਲੇਗੀ?"}, {"en": "I need leave tomorrow", "hi": "मुझे कल छुट्टी चाहिए", "r": "Kallh mainu chhutti chahidi", "t": "ਕੱਲ੍ਹ ਮੈਨੂੰ ਛੁੱਟੀ ਚਾਹੀਦੀ"}, {"en": "The work is finished", "hi": "काम ख़त्म हो गया", "r": "Kamm mukk gaya", "t": "ਕੰਮ ਮੁੱਕ ਗਿਆ"}, {"en": "Come on time", "hi": "समय पर आओ", "r": "Samay sir aao", "t": "ਸਮੇਂ ਸਿਰ ਆਓ"}, {"en": "Good job!", "hi": "शाबाश!", "r": "Shabash!", "t": "ਸ਼ਾਬਾਸ਼!"}, {"en": "I will call back", "hi": "मैं वापस फ़ोन करूँगा", "r": "Main murh phone karanga", "t": "ਮੈਂ ਮੁੜ੍ਹ ਫ਼ੋਨ ਕਰਾਂਗਾ"}, {"en": "See you tomorrow", "hi": "कल मिलते हैं", "r": "Kallh milde haan", "t": "ਕੱਲ੍ਹ ਮਿਲਦੇ ਹਾਂ"}], "quiz": [{"a": "salary", "explain": "ਤਨਖ਼ਾਹ (tankhah) = salary.", "id": "pj-35", "lesson": "office", "level": "beginner", "opts": ["salary", "bonus", "loan", "bill"], "q": "ਤਨਖ਼ਾਹ means…", "topic": "office", "type": "vocab"}, {"a": "ਕੰਪਿਊਟਰ", "explain": "ਕੰਪਿਊਟਰ (computer) = computer.", "id": "pj-36", "lesson": "office", "level": "beginner", "opts": ["ਕੰਪਿਊਟਰ", "ਪ੍ਰਿੰਟਰ", "ਫ਼ਾਈਲ", "ਡੈਸਕ"], "q": "Which is 'computer'?", "topic": "office", "type": "vocab"}, {"a": "come on time", "explain": "ਸਮੇਂ ਸਿਰ ਆਓ — ਸਮਾਂ = time.", "id": "pj-37", "lesson": "office", "level": "beginner", "opts": ["come on time", "go home early", "work fast", "take leave"], "q": "'ਸਮੇਂ ਸਿਰ ਆਓ' means…", "topic": "office", "type": "meaning"}, {"a": "ਕੱਲ੍ਹ ਮੈਨੂੰ ਛੁੱਟੀ ਚਾਹੀਦੀ", "explain": "ਕੱਲ੍ਹ ਮੈਨੂੰ ਛੁੱਟੀ ਚਾਹੀਦੀ — ਛੁੱਟੀ = leave.", "id": "pj-38", "lesson": "office", "level": "elementary", "opts": ["ਕੱਲ੍ਹ ਮੈਨੂੰ ਛੁੱਟੀ ਚਾਹੀਦੀ", "ਕੱਲ੍ਹ ਮੀਟਿੰਗ ਹੈ", "ਕੱਲ੍ਹ ਤਨਖ਼ਾਹ ਮਿਲੇਗੀ", "ਕੱਲ੍ਹ ਛੁੱਟੀ ਨਹੀਂ"], "q": "Ask for tomorrow's leave. You say…", "topic": "office", "type": "usage"}, {"a": "signature", "explain": "ਦਸਤਖ਼ਤ (dastakhat) = signature.", "id": "pj-39", "lesson": "office", "level": "beginner", "opts": ["signature", "stamp", "file", "seal"], "q": "ਦਸਤਖ਼ਤ means…", "topic": "office", "type": "vocab"}, {"a": "photocopy", "explain": "ਜ਼ੇਰਾਕਸ (jerox) — from Xerox! Punjabi for photocopy.", "id": "pj-40", "lesson": "office", "level": "elementary", "opts": ["photocopy", "printout", "scanner", "file"], "q": "ਜ਼ੇਰਾਕਸ means…", "topic": "office", "type": "vocab"}, {"a": "the work is finished", "explain": "ਕੰਮ ਮੁੱਕ ਗਿਆ — ਮੁੱਕਣਾ = to finish.", "id": "pj-41", "lesson": "office", "level": "elementary", "opts": ["the work is finished", "the work begins", "the work is difficult", "the work can wait"], "q": "'ਕੰਮ ਮੁੱਕ ਗਿਆ' means…", "topic": "office", "type": "meaning"}, {"a": "ਈਮੇਲ ਭੇਜੋ", "explain": "ਈਮੇਲ ਭੇਜੋ — ਭੇਜੋ = send.", "id": "pj-42", "lesson": "office", "level": "elementary", "opts": ["ਈਮੇਲ ਭੇਜੋ", "ਚਿੱਠੀ ਲਿਖੋ", "ਫ਼ੋਨ ਕਰੋ", "ਮੀਟਿੰਗ ਵਿੱਚ ਆਓ"], "q": "Tell someone to send the email. You say…", "topic": "office", "type": "usage"}, {"a": "leave", "explain": "ਛੁੱਟੀ (chhutti) = leave.", "id": "pj-43", "lesson": "office", "level": "beginner", "opts": ["leave", "holiday", "salary", "bonus"], "q": "ਛੁੱਟੀ means…", "topic": "office", "type": "vocab"}, {"a": "good job!", "explain": "ਸ਼ਾਬਾਸ਼! — well done!", "id": "pj-44", "lesson": "office", "level": "beginner", "opts": ["good job!", "go home!", "sit down!", "wait here!"], "q": "'ਸ਼ਾਬਾਸ਼!' means…", "topic": "office", "type": "meaning"}], "slug": "office", "title": "Office & work", "words": [{"en": "head office", "hi": "मुख्य कार्यालय", "r": "mukh daftar", "t": "ਮੁੱਖ ਦਫ਼ਤਰ"}, {"en": "company", "hi": "कंपनी", "r": "company", "t": "ਕੰਪਨੀ"}, {"en": "department", "hi": "विभाग", "r": "vibhag", "t": "ਵਿਭਾਗ"}, {"en": "boss", "hi": "बॉस", "r": "boss", "t": "ਬੌਸ"}, {"en": "manager", "hi": "मैनेजर", "r": "manager", "t": "ਮੈਨੇਜਰ"}, {"en": "employee", "hi": "कर्मचारी", "r": "mulajam", "t": "ਮੁਲਾਜ਼ਮ"}, {"en": "colleague", "hi": "सहकर्मी", "r": "sehikarmi", "t": "ਸਹਿਕਰਮੀ"}, {"en": "assistant", "hi": "सहायक", "r": "sahayak", "t": "ਸਹਾਇਕ"}, {"en": "clerk", "hi": "क्लर्क", "r": "clerk", "t": "ਕਲਰਕ"}, {"en": "meeting", "hi": "मीटिंग", "r": "meeting", "t": "ਮੀਟਿੰਗ"}, {"en": "conference", "hi": "सम्मेलन", "r": "sanmelan", "t": "ਸੰਮੇਲਨ"}, {"en": "cabin", "hi": "केबिन", "r": "cabin", "t": "ਕੈਬਿਨ"}, {"en": "reception", "hi": "रिसेप्शन", "r": "reception", "t": "ਰਿਸੈਪਸ਼ਨ"}, {"en": "receptionist", "hi": "रिसेप्शनिस्ट", "r": "receptionist", "t": "ਰਿਸੈਪਸ਼ਨਿਸਟ"}, {"en": "security guard", "hi": "चौकीदार", "