{
 "dialogue": {
  "lines": [
   {
    "en": "Grandma, what is cooking?",
    "hi": "दादी, क्या बन रहा है?",
    "r": "Aaji, kay shijtay?",
    "sp": "Granddaughter",
    "t": "आजी, काय शिजतंय?"
   },
   {
    "en": "Puran poli, my dear!",
    "hi": "पुरणपोळी, मेरी बच्ची!",
    "r": "Puranpoli, majhya bala!",
    "sp": "Grandmother",
    "t": "पुरणपोळी, माझ्या बाळा!"
   },
   {
    "en": "Wash your hands and sit.",
    "hi": "हाथ धोकर बैठो।",
    "r": "Hat dhun bas.",
    "sp": "Grandmother",
    "t": "हात धुऊन बस."
   },
   {
    "en": "Grandma, the food smells nice!",
    "hi": "दादी, खाना महक रहा है!",
    "r": "Aaji, jevan khamangtay!",
    "sp": "Granddaughter",
    "t": "आजी, जेवण खमंगतंय!"
   },
   {
    "en": "Eat well. Shall I serve more?",
    "hi": "अच्छे से खा। और परोसूँ?",
    "r": "Chhan jev. Aankhi vadhu ka?",
    "sp": "Grandmother",
    "t": "छान जेव. आणखी वाढू का?"
   },
   {
    "en": "Yes grandma! Your hand is magic.",
    "hi": "हाँ दादी! तुम्हारे हाथ में जादू है।",
    "r": "Hoy aaji! Tujhya hatat jaadu ahe.",
    "sp": "Granddaughter",
    "t": "होय आजी! तुझ्या हातात जादू आहे."
   }
  ],
  "title": "Grandma's kitchen"
 },
