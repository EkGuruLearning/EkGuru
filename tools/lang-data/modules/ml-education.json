 "dialogue": {
  "lines": [
   {
    "en": "Teacher, I finished my homework.",
    "hi": "गुरुजी, मैंने अपना काम पूरा किया।",
    "r": "Tichare, ente vittujoli tirnnu.",
    "sp": "Student",
    "t": "ടീച്ചറേ, എന്റെ വീട്ടുജോലി തീർന്നു."
   },
   {
    "en": "Very good! Read the lesson loudly.",
    "hi": "बहुत अच्छा! पाठ ज़ोर से पढ़ो।",
    "r": "Valare nannayi! Patham urakke vayikku.",
    "sp": "Teacher",
    "t": "വളരെ നന്നായി! പാഠം ഉറക്കെ വായിക്കൂ."
   },
   {
    "en": "I don't understand this word.",
    "hi": "यह शब्द समझ नहीं आया।",
    "r": "I vakk manassilayilla.",
    "sp": "Student",
    "t": "ഈ വാക്ക് മനസ്സിലായില്ല."
   },
   {
    "en": "Look in the dictionary.",
    "hi": "शब्दकोश में देखो।",
    "r": "Nighantuvil nokku.",
    "sp": "Teacher",
    "t": "നിഘണ്ടുവിൽ നോക്കൂ."
   },
   {
    "en": "OK teacher. When is the exam?",
    "hi": "ठीक है टीचर। परीक्षा कब है?",
    "r": "Shari tichare. Pariksha eppozhaan?",
    "sp": "Student",
    "t": "ശരി ടീച്ചറേ. പരീക്ഷ എപ്പോഴാണ്?"
   },
   {
    "en": "Next month. Now sit and study.",
    "hi": "अगले महीने। अब बैठकर पढ़ो।",
    "r": "Atutta masam. Ippol irinn padikku.",
    "sp": "Teacher",
    "t": "അടുത്ത മാസം. ഇപ്പോൾ ഇരുന്ന് പഠിക്കൂ."
   }
  ],
  "title": "In the classroom"
 },
