{"dialogue": {"lines": [{"en": "What is the weather today?", "hi": "आज मौसम कैसा है?", "r": "Ajj mausam kiho jiha hai?", "sp": "Brother", "t": "ਅੱਜ ਮੌਸਮ ਕਿਹੋ ਜਿਹਾ ਹੈ?"}, {"en": "It will rain. Take an umbrella.", "hi": "बारिश आएगी। छाता ले लो।", "r": "Meenh pauga. Chhatri lai lao.", "sp": "Sister", "t": "ਮੀਂਹ ਪਊਗਾ। ਛਤਰੀ ਲੈ ਲਓ।"}, {"en": "It rained yesterday too.", "hi": "कल भी बारिश हुई।", "r": "Kallh vi meenh peya.", "sp": "Brother", "t": "ਕੱਲ੍ਹ ਵੀ ਮੀਂਹ ਪਿਆ।"}, {"en": "Good rain means good crops.", "hi": "अच्छी बारिश मतलब अच्छी फ़सल।", "r": "Changa meenh matlab changi fasal.", "sp": "Sister", "t": "ਚੰਗਾ ਮੀਂਹ ਮਤਲਬ ਚੰਗੀ ਫ਼ਸਲ।"}, {"en": "Yes! The monsoon is lovely.", "hi": "हाँ! मानसून सुहाना है।", "r": "Haan! Saun-bhadon suhana hai.", "sp": "Brother", "t": "ਹਾਂ! ਸਾਉਣ ਭਾਦੋਂ ਸੁਹਾਣਾ ਹੈ।"}], "title": "Rain talk"}, "lede": "Rain, seasons and harvest — Punjabi for the skies.", "phrases": [{"en": "It is raining", "hi": "बारिश हो रही है", "r": "Meenh pai riha hai", "t": "ਮੀਂਹ ਪੈ ਰਿਹਾ ਹੈ"}, {"en": "It is very hot", "hi": "बहुत गर्मी है", "r": "Bahut garmi hai", "t": "ਬਹੁਤ ਗਰਮੀ ਹੈ"}, {"en": "It is cold today", "hi": "आज ठंड है", "r": "Ajj thandh hai", "t": "ਅੱਜ ਠੰਢ ਹੈ"}, {"en": "What a pleasant wind!", "hi": "कितनी अच्छी हवा!", "r": "Kinni changi hava!", "t": "ਕਿੰਨੀ ਚੰਗੀ ਹਵਾ!"}, {"en": "Take an umbrella", "hi": "छाता ले लो", "r": "Chhatri lai lao", "t": "ਛਤਰੀ ਲੈ ਲਓ"}, {"en": "The sun rose", "hi": "सूरज निकला", "r": "Suraj charheya", "t": "ਸੂਰਜ ਚੜ੍ਹਿਆ"}, {"en": "Night fell", "hi": "रात हो गई", "r": "Raat pai gai", "t": "ਰਾਤ ਪੈ ਗਈ"}, {"en": "Look at the moon!", "hi": "चाँद देखो!", "r": "Chann vekho!", "t": "ਚੰਨ ਵੇਖੋ!"}, {"en": "How beautiful the stars are!", "hi": "तारे कितने सुंदर हैं!", "r": "Taare kinne sohne!", "t": "ਤਾਰੇ ਕਿੰਨੇ ਸੋਹਣੇ!"}, {"en": "Good morning!", "hi": "सुप्रभात!", "r": "Shubh saver!", "t": "ਸ਼ੁੱਭ ਸਵੇਰ!"}, {"en": "Good night!", "hi": "शुभ रात्रि!", "r": "Shubh raatri!", "t": "ਸ਼ੁੱਭ ਰਾਤਰੀ!"}, {"en": "See you in the evening", "hi": "शाम को मिलते हैं", "r": "Sham nu milde haan", "t": "ਸ਼ਾਮ ਨੂੰ ਮਿਲਦੇ ਹਾਂ"}], "quiz": [{"a": "weather", "explain": "ਮੌਸਮ (mausam) = weather.", "id": "pj-55", "lesson": "weather", "level": "beginner", "opts": ["weather", "rain", "wind", "cloud"], "q": "ਮੌਸਮ means…", "topic": "weather", "type": "vocab"}, {"a": "ਮੀਂਹ", "explain": "ਮੀਂਹ (meenh) = rain.", "id": "pj-56", "lesson": "weather", "level": "beginner", "opts": ["ਮੀਂਹ", "ਤੂਫ਼ਾਨ", "ਬੱਦਲ", "ਬਿਜਲੀ"], "q": "Which is 'rain'?", "topic": "weather", "type": "vocab"}, {"a": "it is very hot", "explain": "ਬਹੁਤ ਗਰਮੀ ਹੈ — ਗਰਮੀ = heat.", "id": "pj-57", "lesson": "weather", "level": "beginner", "opts": ["it is very hot", "it is cold today", "it is raining", "night fell"], "q": "'ਬਹੁਤ ਗਰਮੀ ਹੈ' means…", "topic": "weather", "type": "meaning"}, {"a": "ਛਤਰੀ ਲੈ ਲਓ", "explain": "ਛਤਰੀ ਲੈ ਲਓ — ਛਤਰੀ = umbrella.", "id": "pj-58", "lesson": "weather", "level": "elementary", "opts": ["ਛਤਰੀ ਲੈ ਲਓ", "ਟੋਪੀ ਪਾਓ", "ਜੁੱਤੀ ਲਾਹੋ", "ਸਵੈਟਰ ਪਾਓ"], "q": "Tell someone to take an umbrella. You say…", "topic": "weather", "type": "usage"}, {"a": "sun", "explain": "ਸੂਰਜ (suraj) = sun.", "id": "pj-59", "lesson": "weather", "level": "beginner", "opts": ["sun", "moon", "star", "sky"], "q": "ਸੂਰਜ means…", "topic": "weather", "type": "vocab"}, {"a": "monsoon", "explain": "ਸਾਉਣ ਭਾਦੋਂ — the monsoon months!", "id": "pj-60", "lesson": "weather", "level": "elementary", "opts": ["monsoon", "summer", "winter", "spring"], "q": "ਸਾਉਣ ਭਾਦੋਂ means…", "topic": "weather", "type": "vocab"}, {"a": "the sun rose", "explain": "ਸੂਰਜ ਚੜ੍ਹਿਆ — ਚੜ੍ਹਨਾ = to rise.", "id": "pj-61", "lesson": "weather", "level": "elementary", "opts": ["the sun rose", "the sun set", "night fell", "the moon rose"], "q": "'ਸੂਰਜ ਚੜ੍ਹਿਆ' means…", "topic": "weather", "type": "meaning"}, {"a": "ਸ਼ਾਮ ਨੂੰ ਮਿਲਦੇ ਹਾਂ", "explain": "ਸ਼ਾਮ ਨੂੰ ਮਿਲਦੇ ਹਾਂ — ਸ਼ਾਮ = evening.", "id": "pj-62", "lesson": "weather", "level": "elementary", "opts": ["ਸ਼ਾਮ ਨੂੰ ਮਿਲਦੇ ਹਾਂ", "ਸਵੇਰੇ ਮਿਲਦੇ ਹਾਂ", "ਕੱਲ੍ਹ ਮਿਲਦੇ ਹਾਂ", "ਮੁੜ੍ਹ ਮਿਲਦੇ ਹਾਂ"], "q": "Say 'see you in the evening'. You say…", "topic": "weather", "type": "usage"}, {"a": "cold", "explain": "ਠੰਢ (thandh) = cold.", "id": "pj-63", "lesson": "weather", "level": "beginner", "opts": ["cold", "heat", "wind", "fog"], "q": "ਠੰਢ means…", "topic": "weather", "type": "vocab"}, {"a": "rainbow", "explain": "ਸਤਰੰਗ (satrang) — seven colours!", "id": "pj-64", "lesson": "weather", "level": "beginner", "opts": ["rainbow", "lightning", "cloud", "dew"], "q": "ਸਤਰੰਗ means…", "topic": "weather", "type": "vocab"}], "slug": "weather", "title": "Weather & seasons", "words": [{"en": "season", "hi": "ऋतु", "r": "rutt", "t": "ਰੁੱਤ"}, {"en": "weather", "hi": "मौसम", "r": "mausam", "t": "ਮੌਸਮ"}, {"en": "climate", "hi": "जलवायु", "r": "aabohava", "t": "ਆਬੋਹਵਾ"}, {"en": "temperature", "hi": "तापमान", "r": "taapman", "t": "ਤਾਪਮਾਨ"}, {"en": "forecast", "hi": "पूर्वानुमान", "r": "peshengoi", "t": "ਪੇਸ਼ੀਨਗੋਈ"}, {"en": "atmosphere", "hi": "वातावरण", "r": "vatavaran", "t": "ਵਾਤਾਵਰਨ"}, {"en": "air", "hi": "हवा", "r": "hava", "t": "ਹਵਾ"}, {"en": "wind", "hi": "तेज़ हवा", "r": "tej hava", "t": "ਤੇਜ਼ ਹਵਾ"}, {"en": "breeze", "hi": "मंद हवा", "r": "hauli hava", "t": "ਹੌਲੀ ਹਵਾ"}, {"en": "storm", "hi": "तूफ़ान", "r": "toofan", "t": "ਤੂਫ਼ਾਨ"}, {"en": "cyclone", "hi": "समुद्री तूफ़ान", "r": "samundari toofan", "t": "ਸਮੁੰਦਰੀ ਤੂਫ਼ਾਨ"}, {"en": "cloud", "hi": "बादल", "r": "baddal", "t": "ਬੱਦਲ"}, {"en": "black cloud", "hi": "काले बादल", "r": "kale baddal", "t": "ਕਾਲੇ ਬੱਦਲ"}, {"en": "thunder", "hi": "गरज", "r": "garaj", "t": "ਗਰਜ"}, {"en": "lightning", "hi": "बिजली", "r": "bijli", "t": "ਬਿਜਲੀ"}, {"en": "rain", "hi": "बारिश", "r": "meenh", "t": "ਮੀਂਹ"}, {"en": "drizzle", "hi": "फुहार", "r": "fuhar", "t": "ਫੁਹਾਰ"}, {"en": "heavy rain", "hi": "मूसलधार बारिश", "r": "musladhar meenh", "t": "ਮੂਸਲਾਧਾਰ ਮੀਂਹ"}, {"en": "rainy season", "hi": "वर्षा ऋतु", "r": "varkha rutt", "t": "ਵਰਖਾ ਰੁੱਤ"}, {"en": "drop", "hi": "बूँद", "r": "bund", "t": "ਬੂੰਦ"}, {"en": "puddle", "hi": "छोटा छप्पड़", "r": "chhota chhapparh", "t": "ਛੋਟਾ ਛੱਪੜ"}, {"en": "umbrella", "hi": "छाता", "r": "chhatri", "t": "ਛਤਰੀ"}, {"en": "raincoat", "hi": "रेनकोट", "r": "raincoat", "t": "ਰੇਨਕੋਟ"}, {"en": "monsoon", "hi": "सावन-भादों", "note": "the monsoon months", "r": "saun-bhadon", "t": "ਸਾਉਣ ਭਾਦੋਂ"}, {"en": "flood", "hi": "बाढ़", "r": "harh", "t": "ਹੜ੍ਹ"}, {"en": "drought", "hi": "सूखा", "r": "soka", "t": "ਸੋਕਾ"}, {"en": "summer", "hi": "गर्मियाँ", "r": "garmiyan", "t": "ਗਰਮੀਆਂ"}, {"en": "heat", "hi": "गर्मी", "r": "garmi", "t": "ਗਰਮੀ"}, {"en": "hot sun", "hi": "कड़ी धूप", "r": "karhake di dhupp", "t": "ਕੜਾਕੇ ਦੀ ਧੁੱਪ"}, {"en": "sunshine", "hi": "धूप", "r": "dhupp", "t": "ਧੁੱਪ"}, {"en": "shadow", "hi": "छाँव", "r": "chhan", "t": "ਛਾਂ"}, {"en": "sweat", "hi": "पसीना", "r": "pasina", "t": "ਪਸੀਨਾ"}, {"en": "thirst", "hi": "प्यास", "r": "pyas", "t": "ਪਿਆਸ"}, {"en": "winter", "hi": "सर्दी", "r": "sardi", "t": "ਸਰਦੀ"}, {"en": "cold", "hi": "ठंड", "r": "thandh", "t": "ਠੰਢ"}, {"en": "dew", "hi": "ओस", "r": "os", "t": "ਓਸ"}, {"en": "fog", "hi": "कोहरा", "r": "dhund", "t": "ਧੁੰਦ"}, {"en": "frost", "hi": "पाला", "r": "pala", "t": "ਪਾਲ਼ਾ"}, {"en": "ice", "hi": "बर्फ़", "r": "baraf", "t": "ਬਰਫ਼"}, {"en": "snow", "hi": "बर्फ़बारी", "r": "barafbari", "t": "ਬਰਫ਼ਬਾਰੀ"}, {"en": "blanket", "hi": "कंबल", "r": "kambal", "t": "ਕੰਬਲ"}, {"en": "sweater", "hi": "स्वेटर", "r": "sweater", "t": "ਸਵੈਟਰ"}, {"en": "spring", "hi": "बसंत", "r": "basant", "t": "ਬਸੰਤ"}, {"en": "autumn", "hi": "पतझड़", "r": "patjharh", "t": "ਪਤਝੜ"}, {"en": "morning time", "hi": "सुबह का समय", "r": "saver da vela", "t": "ਸਵੇਰ ਦਾ ਵੇਲਾ"}, {"en": "midday", "hi": "दोपहर का समय", "r": "dupehar da sama", "t": "ਦੁਪਹਿਰ ਦਾ ਸਮਾਂ"}, {"en": "afternoon", "hi": "ढलती दुपहरी", "r": "pichhli dupehar", "t": "ਪਿਛਲੀ ਦੁਪਹਿਰ"}, {"en": "evening time", "hi": "शाम का समय", "r": "sham da vela", "t": "ਸ਼ਾਮ ਦਾ ਵੇਲਾ"}, {"en": "sunset", "hi": "सूर्यास्त", "r": "suraj chhipna", "t": "ਸੂਰਜ ਛਿਪਣਾ"}, {"en": "night time", "hi": "रात का समय", "r": "raat da vela", "t": "ਰਾਤ ਦਾ ਵੇਲਾ"}, {"en": "midnight", "hi": "आधी रात", "r": "ad