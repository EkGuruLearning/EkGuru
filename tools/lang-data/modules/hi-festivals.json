{"dialogue": {"lines": [{"en": "Happy Diwali, son!", "r": "Shubh Deepavali, beta!", "sp": "Mother", "t": "शुभ दीवाली, बेटा!"}, {"en": "Happy Diwali, mother! Light the lamp.", "r": "Shubh Deepavali, maa! Deeya jalaao.", "sp": "Son", "t": "शुभ दीवाली, माँ! दीया जलाओ।"}, {"en": "I lit it. Eat sweets, child.", "r": "Jala diya. Mithaai khaao, beta.", "sp": "Mother", "t": "जला दिया। मिठाई खाओ, बेटा।"}, {"en": "So tasty! Now let's burst crackers.", "r": "Kitni svaadisht! Ab pataakhe phodenge.", "sp": "Son", "t": "कितनी स्वादिष्ट! अब पटाखे फोड़ेंगे।"}], "title": "Diwali evening"}, "lede": "Festivals, worship and celebration — Hindi for the days that shine.", "phrases": [{"en": "happy festival!", "r": "tyauhaar mubaarak!", "t": "त्यौहार मुबारक!"}, {"en": "eat sweets", "r": "mithaai khaaiye", "t": "मिठाई खाइए"}, {"en": "light the lamp", "r": "deeya jalaiye", "t": "दीया जलाइए"}, {"en": "go to the temple", "r": "mandir jaiye", "t": "मंदिर जाइए"}, {"en": "offer flowers", "r": "phool chadhaaiye", "t": "फूल चढ़ाइए"}, {"en": "take the prasad", "r": "prasaad lijiye", "t": "प्रसाद लीजिए"}, {"en": "tie the rakhi", "r": "raakhi baandhiye", "t": "राखी बाँधिए"}, {"en": "play Holi", "r": "holi kheliye", "t": "होली खेलिए"}, {"en": "burst crackers", "r": "pataakhe phodiye", "t": "पटाखे फोड़िए"}, {"en": "wear new clothes", "r": "naye kapde pehniye", "t": "नए कपड़े पहनिए"}, {"en": "sing the hymn", "r": "bhajan gaaiye", "t": "भजन गाइए"}, {"en": "visit the fair", "r": "mele mein jaiye", "t": "मेले में जाइए"}], "quiz": [{"a": "festival", "explain": "त्यौहार (tyauhaar) = festival.", "id": "hi-75", "lesson": "hindi/advanced/festivals", "level": "beginner", "opts": ["festival", "fast", "fair", "wedding"], "q": "त्यौहार means…", "topic": "festivals", "type": "vocab"}, {"a": "दीवाली", "explain": "दीवाली = Diwali, the festival of lamps.", "id": "hi-76", "lesson": "hindi/advanced/festivals", "level": "beginner", "opts": ["दीवाली", "दशहरा", "होली", "ईद"], "q": "Which is 'Diwali'?", "topic": "festivals",