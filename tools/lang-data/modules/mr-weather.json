{
 "dialogue": {
  "lines": [
   {
    "en": "Look, dark clouds in the sky!",
    "hi": "देखो, आसमान में काले बादल!",
    "r": "Bagh, aakashat kale dhag!",
    "sp": "Brother",
    "t": "बघ, आकाशात काळे ढग!"
   },
   {
    "en": "Yes. Rain will come today.",
    "hi": "हाँ। आज बारिश आएगी।",
    "r": "Hoy. Aaj paus yenar.",
    "sp": "Sister",
    "t": "होय. आज पाऊस येणार."
   },
   {
    "en": "Take the umbrella. The wind is strong.",
    "hi": "छाता ले लो। हवा तेज़ है।",
    "r": "Chhatri ghe. Vara jordar ahe.",
    "sp": "Brother",
    "t": "छत्री घे. वारा जोरदार आहे."
   },
   {
    "en": "I love the smell of first rain!",
    "hi": "मुझे पहली बारिश की खुशबू अच्छी लगती है!",
    "r": "Mrugachya pausacha vas mala aavadto!",
    "sp": "Sister",
    "t": "मृगाच्या पावसाचा वास मला आवडतो!"
   },
   {
    "en": "Don't stand in lightning.",
    "hi": "बिजली में खड़े मत रहो।",
    "r": "Vijet ubha rahu nako.",
    "sp": "Mother",
    "t": "विजेत उभा राहू नको."
   },
   {
    "en": "Come inside, let's drink hot tea!",
    "hi": "अंदर आओ, गरम चाय पिएँ!",
    "r": "Aat ye, garam chaha piuya!",
    "sp": "Mother",
    "t": "आत ये, गरम चहा पिऊया!"
   }
  ],
  "title": "Rain is coming"
 },
