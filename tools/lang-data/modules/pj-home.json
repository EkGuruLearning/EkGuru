 "dialogue": {
  "lines": [
   {
    "en": "Grandma, what is cooking?",
    "hi": "दादी, क्या बन रहा है?",
    "r": "Bebe, ki pakk riha hai?",
    "sp": "Granddaughter",
    "t": "ਬੇਬੇ, ਕੀ ਪੱਕ ਰਿਹਾ ਹੈ?"
   },
   {
    "en": "Sarson da saag, my dear!",
    "hi": "सरसों का साग, मेरी बच्ची!",
    "r": "Sarson da saag, mere bachcha!",
    "sp": "Grandmother",
    "t": "ਸਰਸੋਂ ਦਾ ਸਾਗ, ਮੇਰੇ ਬੱਚਾ!"
   },
   {
    "en": "Wash your hands and sit.",
    "hi": "हाथ धोकर बैठो।",
    "r": "Hatth dho ke baija.",
    "sp": "Grandmother",
    "t": "ਹੱਥ ਧੋ ਕੇ ਬਹਿ ਜਾ।"
   },
   {
    "en": "Grandma, the food smells nice!",
    "hi": "दादी, खाना महक रहा है!",
    "r": "Bebe, khana mehak riha hai!",
    "sp": "Granddaughter",
    "t": "ਬੇਬੇ, ਖਾਣਾ ਮਹਿਕ ਰਿਹਾ ਹੈ!"
   },
   {
    "en": "Eat well. Shall I serve more?",
    "hi": "अच्छे से खा। और परोसूँ?",
    "r": "Changi tarah kha. Hor parosan?",
    "sp": "Grandmother",
    "t": "ਚੰਗੀ ਤਰ੍ਹਾਂ ਖਾ। ਹੋਰ ਪਰੋਸਾਂ?"
   },
   {
    "en": "Yes grandma! Your hand is magic.",
    "hi": "हाँ दादी! तुम्हारे हाथ में जादू है।",
    "r": "Haan bebe! Tere hatth vich jadu hai.",
    "sp": "Granddaughter",
    "t": "ਹਾਂ ਬੇਬੇ! ਤੇਰੇ ਹੱਥ ਵਿੱਚ ਜਾਦੂ ਹੈ।"
   }
  ],
  "title": "Grandma's kitchen"
