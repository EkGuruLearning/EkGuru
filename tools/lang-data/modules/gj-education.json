{
 "dialogue": {
  "lines": [
   {
    "en": "Good morning, teacher!",
    "hi": "नमस्ते।",
    "r": "Sahab, pranam!",
    "sp": "Student",
    "t": "સાહેબ, પ્રણામ!"
   },
   {
    "en": "Pranam! Did you finish the homework?",
    "hi": "प्रणाम! गृहकार्य पूरा किया?",
    "r": "Pranam! Lesan puru karyu?",
    "sp": "Teacher",
    "t": "પ્રણામ! લેસન પૂરું કર્યું?"
   },
   {
    "en": "Yes teacher. My essay is long!",
    "hi": "हाँ। मेरा निबंध लंबा है!",
    "r": "Haa sahab. Maro nibandh lambo chhe!",
    "sp": "Student",
    "t": "હા સાહેબ. મારો નિબંધ લાંબો છે!"
   },
   {
    "en": "Good! Read it aloud.",
    "hi": "शाबाश! ज़ोर से पढ़ो।",
    "r": "Saras! Motethi vancho.",
    "sp": "Teacher",
    "t": "સરસ! મોટેથી વાંચો."
   },
   {
    "en": "Teacher, give me a story book!",
    "hi": "मुझे कहानी की किताब दीजिए!",
    "r": "Mane vartani chopdi aapo!",
    "sp": "Student",
    "t": "મને વાર્તાની ચોપડી આપો!"
   },
   {
    "en": "Take it. Study well!",
    "hi": "लो। अच्छे से पढ़ो!",
    "r": "Lo. Saras rite bhano!",
    "sp": "Teacher",
    "t": "લો. સરસ રીતે ભણો!"
   }
  ],
  "title": "In the classroom"
 },
