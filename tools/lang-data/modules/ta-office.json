{
  "dialogue": {
    "lines": [
      {
        "en": "Welcome! What is your name?",
        "hi": "आइए! आपका नाम क्या है?",
        "r": "Vāruṅgaḷ! Uṅgaḷ peyar enna?",
        "sp": "Manager",
        "t": "வாருங்கள்! உங்கள் பெயர் என்ன?"
      },
      {
        "en": "My name is Kumar.",
        "hi": "मेरा नाम कुमार है।",
        "r": "Eṉ peyar Kumāṛ.",
        "sp": "Newcomer",
        "t": "என் பெயர் குமார்."
      },
      {
        "en": "This is your desk. Switch on the computer.",
        "hi": "यह आपकी मेज़ है। कंप्यूटर चालू कीजिए।",
        "r": "Idu uṅgaḷ mēsai. Kaṇiṉiyai iyakkuṅgaḷ.",
        "sp": "Manager",
        "t": "இது உங்கள் மேசை. கணினியை இயக்குங்கள்."
      },
      {
        "en": "OK. What is the email address?",
        "hi": "ठीक है। ईमेल पता क्या है?",
        "r": "Sari. Miṉṉañjal mugavari enna?",
        "sp": "Newcomer",
        "t": "சரி. மின்னஞ்சல் முகவரி என்ன?"
      },
      {
        "en": "Don't worry, the assistant will tell you.",
        "hi": "चिंता मत कीजिए, सहायक बता देगा।",
        "r": "Kavalai paḍādīrgaḷ, udaviyāḷar solvār.",
        "sp": "Manager",
        "t": "கவலைப்படாதீர்கள், உதவியாளர் சொல்வார்."
      },
      {
        "en": "Thanks! I'll come on time tomorrow.",
        "hi": "शुक्रिया! कल समय पर आऊँगा।",
        "r": "Naṉṛi! Nāḷai nērattil varugiṟēṉ.",
        "sp": "Newcomer",
        "t": "நன்றி! நாளை நேரத்தில் வருகிறேன்."
      }
    ],
    "title": "First day at office"
  },
  "lede": "Desks, files and deadlines — Tamil for work life.",
  "phrases": [
    {
      "en": "I have a meeting",
      "hi": "मेरी मीटिंग है",
      "r": "Enakku kūṭṭam irukkiṛadu",
      "t": "எனக்கு கூட்டம் இருக்கிறது"
    },
    {
      "en": "The boss called you",
      "hi": "बॉस ने तुम्हें बुलाया",
      "r": "Mudalāḷi uṅgaḷai kūppiṭṭār",
      "t": "முதலாளி உங்களை கூப்பிட்டார்"
    },
    {
      "en": "Sign here",
      "hi": "यहाँ दस्तख़त करो",
      "r": "Iṅgē kaiyoppamiḍuṅgaḷ",
      "t": "இங்கே கையொப்பமிடுங்கள்"
    },
    {
      "en": "Send the email",
      "hi": "ईमेल भेजो",
      "r": "Miṉṉañjal anuppuṅgaḷ",
      "t": "மின்னஞ்சல் அனுப்புங்கள்"
    },
    {
      "en": "Take a printout",
      "hi": "प्रिंट निकालो",
      "r": "Piriṇṭ eḍuṅgaḷ",
      "t": "பிரிண்ட் எடுங்கள்"
    },
    {
      "en": "When is the salary?",
      "hi": "वेतन कब मिलेगा?",
      "r": "Sambaḷam eppōdu?",
      "t": "சம்பளம் எப்போது?"
    },
    {
      "en": "I need leave tomorrow",
      "hi": "मुझे कल छुट्टी चाहिए",
      "r": "Nāḷai viḍuppu vēṇḍum",
      "t": "நாளை விடுப்பு வேண்டும்"
    },
    {
      "en": "The work is finished",
      "hi": "काम ख़त्म हो गया",
      "r": "Vēlai muḍinduviṭṭadu",
      "t": "வேலை முடிந்துவிட்டது"
    },
    {
      "en": "Come on time",
      "hi": "समय पर आओ",
      "r": "Nērattil vāruṅgaḷ",
      "t": "நேரத்தில் வாருங்கள்"
    },
    {
      "en": "Good job!",
      "hi": "शाबाश!",
      "r": "Nalla vēlai!",
      "t": "நல்ல வேலை!"
    },
    {
      "en": "I will call back",
      "hi": "मैं वापस फ़ोन करूँगा",
      "r": "Tirumba pōṉ seygiṟēṉ",
      "t": "திரும்ப போன் செய்கிறேன்"
    },
    {
      "en": "See you tomorrow",
      "hi": "कल मिलते हैं",
      "r": "Nāḷai pārkkalām",
      "t": "நாளை பார்க்கலாம்"
    }
  ],
