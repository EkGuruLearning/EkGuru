{
 "dialogue": {
  "lines": [
   {
    "en": "Happy Gudhi Padwa! New Year greetings!",
    "hi": "गुढीपाडव्याच्या शुभेच्छा!",
    "r": "Gudhipadvyachya shubhechha!",
    "sp": "Neighbour",
    "t": "गुढीपाडव्याच्या शुभेच्छा!"
   },
   {
    "en": "Same to you! Come, eat sweets.",
    "hi": "तुम्हालाही! या, गोड खा.",
    "r": "Tumhalahi! Ya, god kha.",
    "sp": "Mother",
    "t": "तुम्हालाही! या, गोड खा."
   },
   {
    "en": "The gudi looks beautiful!",
    "hi": "गुढी सुंदर दिसते!",
    "r": "Gudhi sundar distey!",
    "sp": "Neighbour",
    "t": "गुढी सुंदर दिसते!"
   },
   {
    "en": "In the evening there is a procession.",
    "hi": "शाम को जुलूस है।",
    "r": "Sandhyakali miravnuk ahe.",
    "sp": "Mother",
    "t": "संध्याकाळी मिरवणूक आहे."
   },
   {
    "en": "We'll all come. Wear new clothes!",
    "hi": "हम सब आएँगे। नए कपड़े पहनना!",
    "r": "Aamhi sagle yeu. Nave kapde ghal!",
    "sp": "Neighbour",
    "t": "आम्ही सगळे येऊ. नवे कपडे घाल!"
   }
  ],
  "title": "Gudhi Padwa greetings"
 },
 "lede": "Gudhi Padwa, Ganpati and village jatras — Marathi for celebrations.",
