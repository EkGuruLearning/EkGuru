{
  "dialogue": {
    "lines": [
      {
        "en": "How's tomorrow's weather?",
        "hi": "कल मौसम कैसा है?",
        "r": "Nāḷai vāṉilai eppaḍi?",
        "sp": "Meena",
        "t": "நாளை வானிலை எப்படி?"
      },
      {
        "en": "Less sun, no rain.",
        "hi": "धूप कम, बारिश नहीं।",
        "r": "Veyil kuṛaivu, maḻai illai.",
        "sp": "Ravi",
        "t": "வெயில் குறைவு, மழை இல்லை."
      },
      {
        "en": "Then let's go to the beach!",
        "hi": "तो समुद्र तट चलें!",
        "r": "Appaḍiyāṉāl kaḍaṛkaraikkup pōgalām!",
        "sp": "Meena",
        "t": "அப்படியானால் கடற்கரைக்குப் போகலாம்!"
      },
      {
        "en": "OK! We'll leave in the morning.",
        "hi": "ठीक! सुबह निकलते हैं।",
        "r": "Sari! Kālaiyil puṛappaḍalām.",
        "sp": "Ravi",
        "t": "சரி! காலையில் புறப்படலாம்."
      },
      {
        "en": "Take umbrella and water.",
        "hi": "छाता, पानी ले लेना।",
        "r": "Kuḍai, taṇṇīr eḍuttukkoḷ.",
        "sp": "Meena",
        "t": "குடை, தண்ணீர் எடுத்துக்கொள்."
      },
      {
        "en": "OK, I won't forget!",
        "hi": "ठीक, नहीं भूलूँगा!",
        "r": "Sari, maṛakkamāṭṭēṉ!",
        "sp": "Ravi",
        "t": "சரி, மறக்கமாட்டேன்!"
      }
    ],
    "title": "Picnic plan"
  },
  "lede": "Sky, seasons and creatures — Tamil for the outdoors.",
  "phrases": [
    {
      "en": "It is raining",
      "hi": "बारिश हो रही है",
      "r": "Maḻai peygiṛadu",
      "t": "மழை பெய்கிறது"
    },
    {
      "en": "The sun is hot",
      "hi": "धूप तेज़ है",
      "r": "Veyil adigam",
      "t": "வெயில் அதிகம்"
    },
    {
      "en": "Take an umbrella",
      "hi": "छाता ले लो",
      "r": "Kuḍai eḍuttukkoḷ",
      "t": "குடை எடுத்துக்கொள்"
    },
    {
      "en": "How is the weather?",
      "hi": "मौसम कैसा है?",
      "r": "Vāṉilai eppaḍi?",
      "t": "வானிலை எப்படி?"
    },
    {
      "en": "Summer is coming",
      "hi": "गर्मी आ रही है",
      "r": "Kōḍai varugiṛadu",
      "t": "கோடை வருகிறது"
    },
    {
      "en": "The river is full",
      "hi": "नदी भरी है",
      "r": "Āṛu niṛaindirukkiṛadu",
      "t": "ஆறு நிறைந்திருக்கிறது"
    },
    {
      "en": "Look at the rainbow!",
      "hi": "इंद्रधनुष देखो!",
      "r": "Vāṉavillaip pār!",
      "t": "வானவில்லைப் பார்!"
    },
    {
      "en": "Don't go in the storm",
      "hi": "तूफ़ान में मत जाओ",
      "r": "Puyalil pōgādē",
      "t": "புயலில் போகாதே"
    },
    {
      "en": "The flowers bloomed",
      "hi": "फूल खिल गए",
      "r": "Pūkkaḷ pūttirukkiṉṛaṉa",
      "t": "பூக்கள் பூத்திருக்கின்றன"
    },
    {
      "en": "The cow is grazing",
      "hi": "गाय चर रही है",
      "r": "Māḍu mēygiṛadu",
      "t": "மாடு மேய்கிறது"
    },
    {
      "en": "Climb the hill slowly",
      "hi": "पहाड़ी पर धीरे चढ़ो",
      "r": "Kuṉṛil meduvāga ēṛu",
      "t": "குன்றில் மெதுவாக ஏறு"
    },
    {
      "en": "Nature is beautiful",
      "hi": "प्रकृति सुंदर है",
      "r": "Iyaṛkai aḻagāṉadu",
      "t": "இயற்கை அழகானது"
    }
  ],
