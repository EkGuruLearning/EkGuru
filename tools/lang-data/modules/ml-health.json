{
 "dialogue": {
  "lines": [
   {
    "en": "What happened to you?",
    "hi": "आपको क्या हुआ?",
    "r": "Ningngalkk ent pattii?",
    "sp": "Doctor",
    "t": "നിങ്ങൾക്ക് എന്ത് പറ്റി?"
   },
   {
    "en": "Doctor, fever for two days.",
    "hi": "डॉक्टर, दो दिन से बुख़ार है।",
    "r": "Dokttare, rant divasamayi pani.",
    "sp": "Patient",
    "t": "ഡോക്ടറേ, രണ്ട് ദിവസമായി പനി."
   },
   {
    "en": "Any cough or cold?",
    "hi": "खाँसी-ज़ुकाम है?",
    "r": "Chumayo jaladoshamo undo?",
    "sp": "Doctor",
    "t": "ചുമയോ ജലദോഷമോ ഉണ്ടോ?"
   },
   {
    "en": "Only a cough.",
    "hi": "सिर्फ़ ख़ाँसी है।",
    "r": "Chuma matrame ullu.",
    "sp": "Patient",
    "t": "ചുമ മാത്രമേ ഉള്ളൂ."
   },
   {
    "en": "Don't fear. Take this tablet.",
    "hi": "घबराइए मत। यह गोली लीजिए।",
    "r": "Pedikkanta. I gulika kazhikku.",
    "sp": "Doctor",
    "t": "പേടിക്കണ്ട. ഈ ഗുളിക കഴിക്കൂ."
   },
   {
    "en": "Thanks doctor. Any diet restrictions?",
    "hi": "शुक्रिया डॉक्टर। कोई परहेज़?",
    "r": "Nandi dokttare. Pathyam vallatumundo?",
    "sp": "Patient",
    "t": "നന്ദി ഡോക്ടറേ. പഥ്യം വല്ലതുമുണ്ടോ?"
   }
  ],
  "title": "At the clinic"
 },
 "lede": "Body, symptoms and the clinic — Malayalam for staying well.",
 "phrases": [
  {
   "en": "I am not feeling well",
   "hi": "मेरी तबीयत ठीक नहीं है",
   "r": "Enikk sukhamilla",
   "t": "എനിക്ക് സുഖമില്ല"
  },
  {
   "en": "I have a fever",
   "hi": "मुझे बुख़ार है",
   "r": "Enikk paniyan",
   "t": "എനിക്ക് പനിയാണ്"
  },
  {
   "en": "My head aches",
   "hi": "मेरे सिर में दर्द है",
   "r": "Tala vedanikkunnu",
   "t": "തല വേദനിക്കുന്നു"
  },
  {
   "en": "Call a doctor",
   "hi": "डॉक्टर को बुलाओ",
   "r": "Dokttare vilikku",
   "t": "ഡോക്ടറെ വിളിക്കൂ"
  },
  {
   "en": "Take me to hospital",
   "hi": "मुझे अस्पताल ले चलो",
   "r": "Enne ashupatriyil kontupoku",
   "t": "എന്നെ ആശുപത്രിയിൽ കൊണ്ടുപോകൂ"
  },
  {
   "en": "Where is the pharmacy?",
   "hi": "दवाख़ाना कहाँ है?",
   "r": "Marunnukata eviteyan?",
   "t": "മരുന്നുകട എവിടെയാണ്?"
  },
  {
   "en": "Take this medicine",
   "hi": "यह दवा लो",
   "r": "I marunn kazhikku",
   "t": "ഈ മരുന്ന് കഴിക്കൂ"
  },
  {
   "en": "Drink hot water",
   "hi": "गरम पानी पियो",
   "r": "Chutuvelam kutikku",
   "t": "ചൂടുവെള്ളം കുടിക്കൂ"
  },
  {
   "en": "Take rest",
   "hi": "आराम करो",
   "r": "Vishramikku",
   "t": "വിശ്രമിക്കൂ"
  },
  {
   "en": "Get well soon",
   "hi": "जल्दी ठीक हो जाओ",
   "r": "Pettenn sukhamakatte",
   "t": "പെട്ടെന്ന് സുഖമാകട്ടെ"
  },
  {
   "en": "Open your mouth",
   "hi": "मुँह खोलो",
   "r": "Vaya turakku",
   "t": "വായ തുറക്കൂ"
  },
  {
   "en": "Breathe deeply",
   "hi": "गहरी साँस लो",
   "r": "Azhattil shvasikku",
   "t": "ആഴത്തിൽ ശ്വസിക്കൂ"
  }
 ],
