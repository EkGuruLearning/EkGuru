{
 "dialogue": {
  "lines": [
   {
    "en": "What is the weather today?",
    "hi": "आज मौसम कैसा है?",
    "r": "Aaje havaman kevu chhe?",
    "sp": "Brother",
    "t": "આજે હવામાન કેવું છે?"
   },
   {
    "en": "It will rain. Take an umbrella.",
    "hi": "बारिश आएगी। छाता ले लो।",
    "r": "Varsad aavshe. Chhatri lai lo.",
    "sp": "Sister",
    "t": "વરસાદ આવશે. છત્રી લઈ લો."
   },
   {
    "en": "It rained yesterday too.",
    "hi": "कल भी बारिश हुई।",
    "r": "Kaale pan varsad padyo.",
    "sp": "Brother",
    "t": "કાલે પણ વરસાદ પડ્યો."
   },
   {
    "en": "Good rain means good crops.",
    "hi": "अच्छी बारिश मतलब अच्छी फ़सल।",
    "r": "Saro varsad etle saru pak.",
    "sp": "Sister",
    "t": "સારો વરસાદ એટલે સારો પાક."
   },
   {
    "en": "Yes! The monsoon is lovely.",
    "hi": "हाँ! मानसून सुहाना है।",
    "r": "Haa! Chomasu majanu chhe.",
    "sp": "Brother",
    "t": "હા! ચોમાસું મજાનું છે."
   }
  ],
  "title": "Rain talk"
 },
