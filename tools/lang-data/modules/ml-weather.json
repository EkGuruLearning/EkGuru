{
 "dialogue": {
  "lines": [
   {
    "en": "Look, dark clouds in the sky!",
    "hi": "देखो, आसमान में काले बादल!",
    "r": "Nokku, akashattil karmeghangal!",
    "sp": "Brother",
    "t": "നോക്കൂ, ആകാശത്തിൽ കാർമേഘങ്ങൾ!"
   },
   {
    "en": "Yes. Rain will come today.",
    "hi": "हाँ। आज बारिश आएगी।",
    "r": "Ate. Inn mazha varum.",
    "sp": "Sister",
    "t": "അതെ. ഇന്ന് മഴ വരും."
   },
   {
    "en": "Take the umbrella. The wind is strong.",
    "hi": "छाता ले लो। हवा तेज़ है।",
    "r": "Kuta etukko. Katt shaktimataan.",
    "sp": "Brother",
    "t": "കുട എടുക്കൂ. കാറ്റ് ശക്തമാണ്."
   },
   {
    "en": "I love the smell of first rain!",
    "hi": "मुझे पहली बारिश की खुशबू अच्छी लगती है!",
    "r": "Adyamazhayute manam enikk ishtam!",
    "sp": "Sister",
    "t": "ആദ്യമഴയുടെ മണം എനിക്ക് ഇഷ്ടം!"
   },
   {
    "en": "Don't stand in lightning.",
    "hi": "बिजली में खड़े मत रहो।",
    "r": "Minnlil nilkkarut.",
    "sp": "Mother",
    "t": "മിന്നലിൽ നിൽക്കരുത്."
   },
   {
    "en": "Come inside, let's drink hot tea!",
    "hi": "अंदर आओ, गरम चाय पिएँ!",
    "r": "Akatt varu, chuta chaya kutikkam!",
    "sp": "Mother",
    "t": "അകത്ത് വരൂ, ചൂട് ചായ കുടിക്കാം!"
   }
  ],
  "title": "Rain is coming"
