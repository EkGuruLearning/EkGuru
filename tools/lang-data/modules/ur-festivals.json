{"dialogue": {"lines": [{"en": "Eid Mubarak! Come, eat sheer khurma!", "hi": "ईद मुबारक! आओ, शीर ख़ुरमा खाओ।", "r": "Eid Mubarak! Aaiye, sheer khurma khaiye!", "sp": "Host", "t": "عید مبارک! آئیے، شیر خرما کھائیے!"}, {"en": "Eid Mubarak to you too! Eidi for the kids!", "hi": "तुम्हें भी ईद मुबारक! बच्चों को ईदी!", "r": "Aap ko bhi Eid Mubarak! Bachchon ko eidi!", "sp": "Guest", "t": "آپ کو بھی عید مبارک! بچوں کو عیدی!"}, {"en": "The house looks beautiful!", "hi": "घर सुंदर लग रहा है!", "r": "Ghar khubsurat lag raha hai!", "sp": "Guest", "t": "گھر خوبصورت لگ رہا ہے!"}, {"en": "Thanks! Stay for dinner.", "hi": "शुक्रिया! खाने पर रुकिए।", "r": "Shukriya! Khane par rukiye.", "sp": "Host", "t": "شکریہ! کھانے پر رکھیے۔"}, {"en": "Sure! We will all come.", "hi": "ज़रूर! हम सब आएँगे।", "r": "Zarur! Ham sab aayenge.", "sp": "Guest", "t": "ضرور! ہم سب آئیں گے۔"}], "title": "Eid greetings"}, "lede": "Eid, Shab-e-Barat and Urs — Urdu for celebrations.", "phrases": [{"en": "Happy festival!", "hi": "त्यौहार मुबारक!", "r": "Teohar Mubarak!", "t": "تیوہار مبارک!"}, {"en": "Happy New Year!", "hi": "नया साल मुबारक!", "r": "Naya saal Mubarak!", "t": "نیا سال مبارک!"}, {"en": "Come to our house", "hi": "हमारे घर आओ", "r": "Hamare ghar aaiye", "t": "ہمارے گھر آئیے"}, {"en": "Eat sweets", "hi": "मिठाई खाओ", "r": "Mithai khaiye", "t": "مٹھائی کھائیے"}, {"en": "Wear new clothes", "hi": "नए कपड़े पहनो", "r": "Nae kaprhe pehniye", "t": "نئے کپڑے پہنیے"}, {"en": "Light the lamp", "hi": "दीया जलाओ", "r": "Diya jalaiye", "t": "دیا جلائیے"}, {"en": "Offer prayers", "hi": "दुआ करो", "r": "Dua kijiye", "t": "دعا کیجیے"}, {"en": "Go to the mosque", "hi": "मस्जिद जाओ", "r": "Masjid jaiye", "t": "مسجد جائیے"}, {"en": "Happy Eid!", "hi": "ईद मुबारक!", "r": "Eid Mubarak!", "t": "عید مبارک!"}], "quiz": [{"a": "festival", "explain": "تیوہار (teohar) = festival.", "id": "ur-75", "lesson": "festivals", "level": "beginner", "opts": ["festival", "fast", "fair", "temple"], "q": "تیوہار means…", "topic": "fest