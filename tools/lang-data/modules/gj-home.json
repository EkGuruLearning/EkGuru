{
 "dialogue": {
  "lines": [
   {
    "en": "Grandma, what is cooking?",
    "hi": "दादी, क्या बन रहा है?",
    "r": "Ba, shu randhay chhe?",
    "sp": "Granddaughter",
    "t": "બા, શું રંધાય છે?"
   },
   {
    "en": "Undhiyu, my dear!",
    "hi": "उंधियू, मेरी बच्ची!",
    "r": "Undhiyu, mari dikari!",
    "sp": "Grandmother",
    "t": "ઉંધિયું, મારી દીકરી!"
   },
   {
    "en": "Wash your hands and sit.",
    "hi": "हाथ धोकर बैठो।",
    "r": "Haath dhoine bes.",
    "sp": "Grandmother",
    "t": "હાથ ધોઈને બેસ."
   },
   {
    "en": "Grandma, the food smells nice!",
    "hi": "दादी, खाना महक रहा है!",
    "r": "Ba, khavanu meke chhe!",
    "sp": "Granddaughter",
    "t": "બા, ખાવાનું મેકે છે!"
   },
   {
    "en": "Eat well. Shall I serve more?",
    "hi": "अच्छे से खा। और परोसूँ?",
    "r": "Saras rite kha. Vadhare pirasu?",
    "sp": "Grandmother",
    "t": "સરસ રીતે ખા. વધારે પીરસું?"
   },
   {
    "en": "Yes grandma! Your hand is magic.",
    "hi": "हाँ दादी! तुम्हारे हाथ में जादू है।",
    "r": "Haa ba! Tara haathma jadu chhe.",
    "sp": "Granddaughter",
    "t": "હા બા! તારા હાથમાં જાદુ છે."
   }
  ],
  "title": "Grandma's kitchen"
 },
