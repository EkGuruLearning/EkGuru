{
  "dialogue": {
    "lines": [
      {
        "en": "What happened to you?",
        "hi": "आपको क्या हुआ?",
        "r": "Mīku ēmaindi?",
        "sp": "Doctor",
        "t": "మీకు ఏమైంది?"
      },
      {
        "en": "Doctor, fever for two days.",
        "hi": "डॉक्टर, दो दिन से बुख़ार है।",
        "r": "Ḍākṭar, reṇḍu rōjula nuñchi jvaraṁ.",
        "sp": "Patient",
        "t": "డాక్టర్, రెండు రోజుల నుంచి జ్వరం."
      },
      {
        "en": "Any cough or cold?",
        "hi": "खाँसी-ज़ुकाम है?",
        "r": "Daggu, jalubu undā?",
        "sp": "Doctor",
        "t": "దగ్గు, జలుబు ఉందా?"
      },
      {
        "en": "Only a cough.",
        "hi": "सिर्फ़ ख़ाँसी है।",
        "r": "Daggu mātramē undi.",
        "sp": "Patient",
        "t": "దగ్గు మాత్రమే ఉంది."
      },
      {
        "en": "Don't worry. Take this tablet.",
        "hi": "घबराइए मत। यह गोली लीजिए।",
        "r": "Bhayapaḍakaṇḍi. Ī ṭābleṭ tīsukōṇḍi.",
        "sp": "Doctor",
        "t": "భయపడకండి. ఈ టాబ్లెట్ తీసుకోండి."
      },
      {
        "en": "Thank you, doctor. Any diet restrictions?",
        "hi": "शुक्रिया डॉक्टर। कोई परहेज़?",
        "r": "Dhanyavādālu ḍākṭar. Pathyaṁ ēmainā undā?",
        "sp": "Patient",
        "t": "ధన్యవాదాలు డాక్టర్. పథ్యం ఏమైనా ఉందా?"
      }
    ],
    "title": "At the clinic"
  },
  "lede": "Body, symptoms and the clinic — Telugu for staying well.",
  "phrases": [
    {
      "en": "I am not feeling well",
      "hi": "मेरी तबीयत ठीक नहीं है",
      "r": "Oṇṭlō bāgālēdu",
      "t": "ఒంట్లో బాగాలేదు"
    },
    {
      "en": "I have a fever",
      "hi": "मुझे बुख़ार है",
      "r": "Nāku jvaraṁ",
      "t": "నాకు జ్వరం"
    },
    {
      "en": "My head aches",
      "hi": "मेरे सिर में दर्द है",
      "r": "Talanoppigā undi",
      "t": "తలనొప్పిగా ఉంది"
    },
    {
      "en": "Call a doctor",
      "hi": "डॉक्टर को बुलाओ",
      "r": "Ḍākṭarni pilavaṇḍi",
      "t": "డాక్టర్‌ని పిలవండి"
    },
    {
      "en": "Take me to hospital",
      "hi": "मुझे अस्पताल ले चलो",
      "r": "Nannu āsupatriki tīsukeḷḷaṇḍi",
      "t": "నన్ను ఆసుపత్రికి తీసుకెళ్ళండి"
    },
    {
      "en": "Where is the pharmacy?",
      "hi": "दवाख़ाना कहाँ है?",
      "r": "Mandula dukāṇaṁ ekkaḍa?",
      "t": "మందుల దుకాణం ఎక్కడ?"
    },
    {
      "en": "Take this medicine",
      "hi": "यह दवा लो",
      "r": "Ī mandu tīsukōṇḍi",
      "t": "ఈ మందు తీసుకోండి"
    },
    {
      "en": "Drink hot water",
      "hi": "गरम पानी पियो",
      "r": "Vēḍinīḷḷu tāgaṇḍi",
      "t": "వేడినీళ్ళు తాగండి"
    },
    {
      "en": "Take rest",
      "hi": "आराम करो",
      "r": "Viśrānti tīsukōṇḍi",
      "t": "విశ్రాంతి తీసుకోండి"
    },
    {
      "en": "Get well soon",
      "hi": "जल्दी ठीक हो जाओ",
      "r": "Tvaragā kōlukōṇḍi",
      "t": "త్వరగా కోలుకోండి"
    },
    {
      "en": "Open your mouth",
      "hi": "मुँह खोलो",
      "r": "Nōru teravaṇḍi",
      "t": "నోరు తెరవండి"
    },
    {
      "en": "Breathe deeply",
      "hi": "गहरी साँस लो",
      "r": "Gaṭṭigā ūpiri pīlchaṇḍi",
      "t": "గట్టిగా ఊపిరి పీల్చండి"
    }
  ],
