    {
      "id": "es-subject-pronouns",
      "concept": "Subject pronouns — who is doing the action",
      "pattern": "yo · tú · él/ella · nosotros/nosotras · vosotros/vosotras · ellos/ellas",
      "examples": [
        {
          "target": "yo hablo",
          "roman": "yoh AH-bloh",
          "gloss": "I speak"
        },
        {
          "target": "tú hablas",
          "roman": "too AH-blahs",
          "gloss": "you speak (familiar)"
        },
        {
          "target": "usted habla",
          "roman": "oos-TED AH-blah",
          "gloss": "you speak (formal)"
        }
      ],
      "exceptions": [
        "tú (familiar) vs usted (formal): usted takes the same verb form as él/ella.",
        "vosotros/vosotras is used in Spain, rarely in Latin America."
      ],
      "learnerNote": "Spanish has two words for “you” — tú for friends, usted for formality — much like Hindi's aap/tum/tu distinction.",
      "commonMistakes": [
        "Using tú with someone who expects usted",
        "Keeping the subject pronoun where Spanish only needs it for contrast or emphasis"
      ],
      "level": "beginner",
      "prerequisite": null,
      "sourceUrl": null,
      "sourceTitle": null
    },
    {
      "id": "es-noun-gender",
      "concept": "Gender — every noun is masculine or feminine",
      "pattern": "el + masculine (el libro) · la + feminine (la casa)",
      "examples": [
        {
          "target": "el libro",
          "roman": "el LEE-broh",
          "gloss": "the book (masculine)"
        },
        {
          "target": "la casa",
          "roman": "lah KAH-sah",
          "gloss": "the house (feminine)"
        },
        {
          "target": "el agua",
          "roman": "el AH-gwah",
          "gloss": "the water (feminine noun, masculine article el for pronunciation)"
        }
      ],
      "exceptions": [
        "el agua / el águila: feminine nouns starting with a stressed a- take el.",
        "Words ending in -ma, -pa, -ta are usually masculine: el problema."
      ],
      "learnerNote": "Nouns ending in -o are usually masculine, -a usually feminine — with a small set of exceptions to memorise.",
      "commonMistakes": [
        "“la problema” instead of “el problema”",
        "Treating gender as optional because English has none"
      ],
      "level": "beginner",
      "prerequisite": "es-subject-pronouns",
      "sourceUrl": null,
      "sourceTitle": null
    },
    {
      "id": "es-ser-estar",
      "concept": "Ser vs estar — two verbs for “to be”",
      "pattern": "ser = what something is (permanent) · estar = how/where it is (state, location)",
      "examples": [
        {
          "target": "Soy de India.",
          "roman": "soy deh EEN-dyah",
          "gloss": "I am from India (origin → ser)"
        },
        {
          "target": "Estoy bien.",
          "roman": "es-TOY byen",
          "gloss": "I am fine (state → estar)"
        },
        {
          "target": "Está en la mesa.",
          "roman": "es-TAH en lah MEH-sah",
          "gloss": "It is on the table (location → estar)"
        }
      ],
      "exceptions": [
        "Time uses ser: “Son las tres” (it is three o'clock).",
        "Location is always estar, even for permanent places: “Madrid está en España”."
      ],
      "learnerNote": "The two-to-be verbs split meaning: identity vs state. Get this early and a whole class of errors disappears.",
      "commonMistakes": [
        "“Soy bien” instead of “Estoy bien”",
        "Using estar for origin: “Estoy de India” instead of “Soy de India”"
      ],
      "level": "beginner",
      "prerequisite": "es-subject-pronouns",
      "sourceUrl": null,
      "sourceTitle": null
    },
    {
      "id": "es-question-forms",
      "concept": "Questions — flip the order and mark both ends with ¿…?",
      "pattern": "¿ + verb + subject? — ¿Hablas inglés?",
      "examples": [
        {
          "target": "¿Hablas inglés?",
          "roman": "AH-blahs een-GLES",
          "gloss": "do you speak English?"
        },
        {
          "target": "¿Dónde está el baño?",
          "roman": "DOHN-deh es-TAH el BAH-nyoh",
          "gloss": "where is the bathroom?"
        },
        {
          "target": "¿Cuánto cuesta?",
          "roman": "KWAHN-toh KWES-tah",
          "gloss": "how much does it cost?"
        }
      ],
      "exceptions": [
        "Yes/no questions can also just rise in intonation: “¿Hablas inglés?”",
        "Question words (dónde, cuánto, qué) carry the accent mark."
      ],
      "learnerNote": "Spanish marks questions at both ends — the opening ¿ is not optional.",
