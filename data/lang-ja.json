          "gloss": "I drink water"
        },
        {
          "target": "私の本",
          "roman": "watashi no hon",
          "gloss": "my book"
        },
        {
          "target": "猫がいます",
          "roman": "neko ga imasu",
          "gloss": "there is a cat"
        }
      ],
      "exceptions": [
