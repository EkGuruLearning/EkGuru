    {
      "id": "ja-the-copula-desu",
      "concept": "The copula — です (desu)",
      "pattern": "noun + です = 'is / am / are'",
      "examples": [
        {
          "target": "水です",
          "roman": "mizu desu",
          "gloss": "it is water"
        },
        {
          "target": "友達です",
          "roman": "tomodachi desu",
          "gloss": "(he/she) is a friend"
        },
        {
          "target": "本じゃありません",
          "roman": "hon ja arimasen",
          "gloss": "it is not a book"
        }
      ],
      "exceptions": [
        "Negative is じゃありません or ではありません."
      ],
      "learnerNote": "です does the job of 'is/am/are' — Japanese has no be-verb conjugations.",
      "commonMistakes": [
        "Using です in casual speech everywhere",
        "Forgetting the negative form"
      ],
