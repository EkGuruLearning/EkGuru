 "ad_policy": {
  "schema_version": 1,
  "reviewed_at": "2026-09-20",
  "rule": "Page classes define future eligibility, but the global runtime gate currently disables the AdSense loader on every page. No custom banner authorizes personalized advertising.",
  "loader_allowed": [],
  "attr": "data-ad-class",
  "classes": {
   "ADMIN": {
    "match": [
     "/admin.html",
     "/admin/**",
     "/tools/**"
    ],
    "why": "owner console and build tooling: never public, never monetised"
   },
   "TRANSACTIONAL": {
    "match": [
     "/support/**",
     "/join.html",
     "/join/**",
     "/booking/**",
     "/checkout/**",
     "/payment/**",
     "/contact/**"
    ],
    "why": "money, forms and booking: an ad next to a payment or a signup is a policy risk"
   },
   "UTILITY": {
    "match": [
     "/404.html",
     "/offline.html",
     "/offline/**",
     "/search/**",
     "/tutor/**",
     "/tutor.html",
     "/google*.html",
     "/sitemap*",
     "/privacy/**",
     "/terms/**",
     "/disclaimer/**",
     "/copyright/**",
     "/cookie-policy/**",
     "/monetization-disclosure/**"
    ],
    "why": "navigation, reference and legal pages: nothing of their own to read"
   },
   "INTERACTIVE_LEARNING": {
    "match": [
     "/courses/**",
     "/learn/**/practice/**",
     "/learn/**/review/**",
     "/learn/**/quiz/**",
     "/languages/**/practice/**",
     "/languages/**/quiz/**",
     "/languages/**/review/**",
     "/languages/**/worksheets/**",
     "/languages/**/typing/**",
     "/languages/**/level/**",
     "/toolbox/**"
    ],
    "why": "a learner is mid-task: quiz, worksheet, typing, review or the course player. The honest way to promise no ad intents is to not load the script"
   },
   "HIGH_CONTENT": {
    "match": [
     "/",
     "/index.html",
     "/learn/**",
     "/languages/**",
     "/world-languages/**",
     "/answers/**",
     "/ask/**",
     "/hindi/**",
     "/materials/**",
     "/daily-hindi/**",
     "/learn-hindi-by-country/**",
     "/about/**"
    ],
    "why": "a page whose whole job is to be read"
   },
   "MEDIUM_CONTENT": {
    "match": [
     "/ar/**",
     "/de/**",
     "/es/**",
     "/fr/**",
     "/ja/**",
     "/pt/**",
     "/name-in-hindi/**",
     "/hindi-tutor/**",
     "/urdu/**",
     "/zh/**",
     "/vi/**",
     "/ru/**",
     "/fa/**",
     "/tr/**",
     "/id/**",
     "/bn/**",
     "/ta/**",
     "/te/**",
     "/ml/**",
     "/mr/**",
     "/gu/**",
     "/kn/**",
     "/pa/**"
    ],
    "why": "useful, shorter or translated pages: conservative formats only"
   }
  },
  "excluded_classes": {
   "ADMIN": "never",
   "TRANSACTIONAL": "never",
   "UTILITY": "never",
   "INTERACTIVE_LEARNING": "never",
   "HIGH_CONTENT": "future candidate only; disabled globally",
   "MEDIUM_CONTENT": "future candidate only; disabled globally"
  },
  "notes": [
   "Every page carries a class as data-ad-class so future placement remains auditable.",
   "Legal, search, form, payment, booking, error, admin and interactive-learning pages remain permanently excluded.",
   "The current custom preferences notice is not a Google-certified CMP/TCF deployment. The loader stays absent until the owner activates and verifies one account-side."
  ]
 },
