{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekguru.shop/schemas/reference-t3.schema.json",
  "title": "T3 language reference (facts, script sample, 20 sourced phrases, a language-specific guide)",
  "type": "object",
  "required": ["code", "facts", "script_sample", "phrases", "guide", "sources"],
  "properties": {
    "code": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "facts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["text", "source_url"], "properties": { "source_url": { "type": "string", "pattern": "^https?://" } } } },
    "script_sample": { "type": "object", "required": ["text", "unicode_block"] },
    "phrases": { "type": "array", "minItems": 20, "items": { "type": "object", "required": ["t", "en", "source_url"], "properties": { "source_url": { "type": "string", "pattern": "^https?://" } } } },
    "guide": { "type": "string", "minLength": 400 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["title", "url"] } }
  }
}
