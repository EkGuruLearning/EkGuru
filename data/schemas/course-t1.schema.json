{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekguru.shop/schemas/course-t1.schema.json",
  "title": "T1 full-course level (one of the eleven rungs)",
  "type": "object",
  "required": ["code", "name", "file_level", "level"],
  "properties": {
    "code": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "file_level": { "enum": ["A1", "A1+", "A2", "A2+", "B1", "B1+", "B2", "B2+", "C1", "C1+", "C2"] },
    "level": {
      "type": "object",
      "required": ["title", "goals", "units", "test", "extra"],
      "properties": {
        "units": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/unit" } },
        "test": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "minItems": 10, "maxItems": 20 } } },
        "extra": { "$ref": "#/$defs/extra" }
      }
    }
  },
  "$defs": {
    "unit": { "type": "object", "required": ["id", "title", "lessons"], "properties": { "lessons": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/lesson" } } } },
    "lesson": {
      "type": "object",
      "required": ["id", "title", "learn", "vocab", "grammar", "dialogue", "practice", "quiz", "worksheet"],
      "properties": {
        "vocab": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["t", "en"], "properties": { "t": { "type": "string", "minLength": 1 }, "r": { "type": "string" }, "ipa": { "type": "string" }, "en": { "type": "string", "minLength": 1 } } } },
        "grammar": { "type": "object", "required": ["title", "explain", "examples"] },
        "dialogue": { "type": "array", "minItems": 2 },
        "practice": { "type": "array", "minItems": 10 },
        "quiz": { "type": "array", "minItems": 3 },
        "worksheet": { "type": "object", "required": ["title", "tasks"] }
      }
    },
    "extra": {
      "type": "object",
      "required": ["culture", "reading", "listening", "idioms", "mistakes", "task"],
      "properties": {
        "culture": { "type": "object", "required": ["text", "source_url"], "properties": { "source_url": { "type": "string", "pattern": "^https?://" } } },
        "reading": { "type": "object", "required": ["text", "original"], "properties": { "original": { "const": true } } },
        "listening": { "type": "object", "required": ["script", "voice_tag"] },
        "idioms": { "type": "array", "minItems": 10, "items": { "type": "object", "required": ["t", "literal", "meaning"] } },
        "mistakes": { "type": "array", "minItems": 3 },
        "task": { "type": "object", "required": ["title", "instructions"] }
      }
    }
  }
}
