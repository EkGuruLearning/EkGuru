          "gloss": "he is at home"
        },
        {
          "target": "They are busy",
          "roman": "thay ahr BIZ-ee",
          "gloss": "they are busy"
        }
      ],
      "exceptions": [
        "am only after I; is only after a singular third person."
      ],
      "learnerNote": "Match the be-verb to the subject. Hindi speakers often drop it — don't.",
      "commonMistakes": [
        "'I is' instead of 'I am'",
        "Dropping the verb: 'She happy'"
      ],
      "level": "beginner",
