      "id": "en-the-verb-to-be-am-is",
      "concept": "The verb 'to be' — am · is · are",
      "pattern": "I am · you/we/they are · he/she/it is",
      "examples": [
        {
          "target": "I am happy",
          "roman": "eye am HAP-ee",
          "gloss": "I am happy"
        },
        {
          "target": "He is at home",
