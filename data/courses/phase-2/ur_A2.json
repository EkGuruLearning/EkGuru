            "grammar": {
              "title": "Experiencer with مجھے",
              "explain": "Urdu often expresses physical states with مجھے (mujhe, “to me”) plus a noun or sensation and ہے (hai).",
              "pattern": "مجھے + condition + ہے",
              "examples": [
                {
                  "t": "مجھے بخار ہے۔",
                  "r": "mujhe bukhār hai.",
                  "en": "I have a fever."
                },
                {
                  "t": "میرے سر میں درد ہے۔",
                  "r": "mere sar men dard hai.",
                  "en": "My head hurts."
                },
                {
                  "t": "آپ کو کیا ہوا؟",
                  "r": "āp ko kyā huā?",
                  "en": "What happened to you?"
                }
              ],
              "mistakes": [
                "Do not copy English “I have” word for word; health states commonly use مجھے."
              ]
