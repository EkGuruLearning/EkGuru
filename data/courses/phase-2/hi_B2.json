{"code": "hi", "name": "Hindi", "native": "हिन्दी", "phase": 2, "medium": "en", "file_level": "B2", "level": {"title": "Advanced: subjunctive, passive, debate, culture", "goals": ["Use subjunctive and hypotheticals fluently", "Use passives and compound verbs", "Debate and discuss Indian culture"], "units": [{"id": "B2-U1", "title": "Subjunctive and hypotheticals", "lessons": [{"id": "B2-U1-L1", "title": "Subjunctive: जाऊँ/जाए", "learn": "Wishes and maybes! मैं जाऊँ (that I go), वह जाए (that he go). चाहता हूँ कि… (I want that…), शायद… (maybe…), ताकि… (so that…)! Root + ऊँ/ए — short and sweet!", "vocab": [{"t": "कि", "r": "ki", "en": "that", "pos": "conjunction"}, {"t": "शायद", "r": "shāyad", "en": "maybe", "pos": "adverb"}, {"t": "काश", "r": "kāsh", "en": "if only", "pos": "phrase"}, {"t": "अगर", "r": "agar", "en": "if", "pos": "conjunction"}, {"t": "तो", "r": "to", "en": "then", "pos": "phrase"}, {"t": "चाहे", "r": "chāhe", "en": "even if / whether", "pos": "conjunction"}, {"t": "ताकि", "r": "tāki", "en": "so that", "pos": "conjunction"}, {"t": "मानो", "r": "māno", "en": "as if", "pos": "conjunction"}], "grammar": {"title": "Subjunctive: root + ऊँ/ए/एँ", "explain": "मैं जाऊँ (I go-subj), तुम जाओ, वह जाए, हम जाएँ! चाहता हूँ कि तुम आओ (I want you to come). शायद वह आए (maybe he'll come)!", "pattern": "जाऊँ/जाओ/जाए/जाएँ · कि/शायद/ताकि", "examples": [{"t": "मैं चाहता हूँ कि तुम आओ।", "r": "main chāhtā hūṅ ki tum āo.", "en": "I want you to come. (boy)"}, {"t": "शायद वह आए।", "r": "shāyad vah āe.", "en": "Maybe he/she will come."}, {"t": "ताकि तुम समझो।", "r": "tāki tum samjho.", "en": "So that you understand."}], "mistakes": ["Saying कि तुम आते हो — कि-clauses take आओ!", "Saying शायद आएगा — शायद loves आए!"]}, "dialogue": [{"sp": "प्रिया", "t": "मैं चाहती हूँ कि तुम आओ।", "r": "main chāhtī hūṅ ki tum āo.", "en": "I want you to come. (girl)"}, {"sp": "राहुल", "t": "शायद मैं आऊँ!", "r": "shāyad main āūṅ!", "en": "Maybe I'll come!"}, {"sp": "प्रिया", "t": "ताकि हम खेलें!", "r": "tāki ham khelen!", "en": "So that we play!"}, {"sp": "राहुल", "t": "ठीक है!", "r": "ṭhīk hai!", "en": "OK!"}], "practice": [{"type": "translate_en", "q": "Say (boy): I want you to come", "answer": "मैं चाहता हूँ कि तुम आओ"}, {"type": "fill", "q": "शायद वह ___। (come-subj)", "answer": "आए"}, {"type": "choose", "q": "'So that we play' is…", "options": ["ताकि हम खेलते हैं", "ताकि हम खेलें", "ताकि हम खेलेंगे", "ताकि हम खेलो"], "answer": "ताकि हम खेलें"}, {"type": "reorder", "q": "Order: आओ / तुम / कि / चाहता हूँ / मैं", "answer": "मैं चाहता हूँ कि तुम आओ"}, {"type": "speak", "q": "Say aloud: शायद मैं आऊँ!", "answer": "शायद मैं आऊँ!"}], "quiz": [{"q": "तुम आओ (subj) is used after…", "options": ["कल", "कि/चाहता हूँ", "ने", "से"], "answer": 1, "why": "कि-clauses → subjunctive."}, {"q": "शायद वह आए means…", "options": ["he will come", "maybe he'll come", "he came", "he must come"], "answer": 1, "why": "शायद + subj = maybe."}, {"q": "ताकि means…", "options": ["because", "so that", "although", "until"], "answer": 1, "why": "ताकि = purpose."}, {"q": "हम जाएँ means…", "options": ["we go (habit)", "we go (subj)", "we went", "we will go"], "answer": 1, "why": "-एँ = subj-we."}, {"q": "काश means…", "options": ["maybe", "if only", "because", "then"], "answer": 1, "why": "काश = wistful if-only."}], "flashcards": "auto:vocab", "worksheet": {"title": "Subjunctive worksheet", "tasks": [{"instruction": "Translate to Hindi.", "items": ["that", "maybe", "so that"], "key": ["कि", "शायद", "ताकि"]}, {"instruction": "Subjunctives.", "items": ["I want you to come (boy)", "Maybe he/she will come", "So that we play"], "key": ["मैं चाहता हूँ कि तुम आओ", "शायद वह आए", "ताकि हम खेलें"]}, {"instruction": "Invite.", "items": ["Maybe I'll come!", "OK!"], "key": ["शायद मैं आऊँ", "ठीक है"]}]}}, {"id": "B2-U1-L2", "title": "अगर…तो + होता", "learn": "Dream-grammar! अगर बारिश होती, तो मैं घर रहता (If it rained, I'd stay home). अगर + past, तो + होता/रहता! वरना (otherwise), काश (if only)!", "vocab": [{"t": "अगर", "r": "agar", "en": "if", "pos": "conjunction"}, {"t": "तो", "r": "to", "en": "then", "pos": "phrase"}, {"t": "वरना", "r": "varnā", "en": "otherwise", "pos": "conjunction"}, {"t": "नहीं तो", "r": "nahīṅ to", "en": "if not", "pos": "phrase"}, {"t": "होता", "r": "hotā", "en": "would be (m)", "pos": "verb"}, {"t": "रहता", "r": "rahtā", "en": "would stay (m)", "pos": "verb"}, {"t": "जाता", "r": "jātā", "en": "would go (m)", "pos": "verb"}, {"t": "काश", "r": "kāsh", "en": "if only", "pos": "phrase"}], "grammar": {"title": "अगर + past, तो + -ता/होता", "explain": "अगर मैं जाता, तो खुश होता (if I went, I'd be happy). अगर पैसे होते, तो यात्रा करता (if I had money, I'd travel)!", "pattern": "अगर…तो…+ होता", "examples": [{"t": "अगर बारिश होती, तो मैं घर रहता।", "r": "agar bārish hotī, to main ghar rahtā.", "en": "If it rained, I'd stay home. (boy)"}, {"t": "अगर पैसे होते, तो यात्रा करता।", "r": "agar paise hote, to yātrā kartā.", "en": "If I had money, I'd travel. (boy)"}, {"t": "काश तुम आते!", "r": "kāsh tum āte!", "en": "If only you came!"}], "mistakes": ["Saying अगर…गा — hypotheticals use -ता/होता, not -गा!", "Forgetting तो: अगर…तो — a pair!"]}, "dialogue": [{"sp": "राहुल", "t": "अगर पैसे होते, तो क्या करते?", "r": "agar paise hote, to kyā karte?", "en": "If you had money, what would you do?"}, {"sp": "प्रिया", "t": "मैं यात्रा करती!", "r": "main yātrā kartī!", "en": "I'd travel! (girl)"}, {"sp": "राहुल", "t": "काश! वरना घर रहेंगे।", "r": "kāsh! varnā ghar rahenge.", "en": "If only! Otherwise we'll stay home."}, {"sp": "प्रिया", "t": "कोई बात नहीं!", "r": "koī bāt nahīṅ!", "en": "No problem!"}], "practice": [{"type": "translate_en", "q": "Say (boy): If it rained, I'd stay home", "answer": "अगर बारिश होती, तो मैं घर रहता"}, {"type": "fill", "q": "काश तुम ___! (came-hypo)", "answer": "आते"}, {"type": "choose", "q": "'If I had money, I'd travel (boy)' is…", "options": ["अगर पैसे हैं, तो यात्रा करूँगा", "अगर पैसे होते, तो यात्रा करता", "अगर पैसे थे, तो यात्रा की", "अगर पैसे होंगे, तो यात्रा करूँगा"], "answer": "अगर पैसे होते, तो यात्रा करता"}, {"type": "reorder", "q": "Order: घर रहता / मैं / तो / होती / बारिश / अगर", "answer": "अगर बारिश होती तो मैं घर रहता"}, {"type": "speak", "q": "Say aloud: काश तुम आते!", "answer": "काश तुम आते!"}], "quiz": [{"q": "अगर…तो uses…", "options": ["-गा future", "-ता/होता", "-रहा", "imperative"], "answer": 1, "why": "Hypothetical = -ता forms."}, {"q": "होता means…", "options": ["is", "would be (m)", "was", "will be"], "answer": 1, "why": "होता = hypothetical be."}, {"q": "वरना means…", "options": ["because", "otherwise", "although", "then"], "answer": 1, "why": "वरना = else/otherwise."}, {"q": "काश तुम आते means…", "options": ["you came", "if only you came", "you will come", "you must come"], "answer": 1, "why": "काश = wistful wish."}, {"q": "तो pairs with…", "options": ["लेकिन", "अगर", "क्योंकि", "जब"], "answer": 1, "why": "अगर…तो — if…then."}], "flashcards": "auto:vocab", "worksheet": {"title": "Hypotheticals worksheet", "tasks": [{"instruction": "Translate to Hindi.", "items": ["if", "then", "otherwise"], "key": ["अगर", "तो", "वरना"]}, {"instruction": "Dream.", "items": ["If it rained, I'd stay home (boy)", "If I had money, I'd travel (boy)", "If only you came!"], "key": ["अगर बारिश होती, तो मैं घर रहता", "अगर पैसे होते, तो यात्रा करता", "काश तुम आते"]}, {"instruction": "Chat.", "items": ["If you had money, what would you do?", "I'd travel! (girl)"], "key": ["अगर पैसे होते, तो क्या करते", "मैं यात्रा करती"]}]}}]}, {"id": "B2-U2", "title": "Passive and debate", "lessons": [{"id": "B2-U2-L1", "title": "Passive: खाया जाता है", "learn": "Things GET done! खाना खाया जाता है (food is eaten), किताब लिखी गई (the book was written). Stem + या + जाता है! Compounds: खा लिया (ate up), कर दिया (did it)!", "vocab": [{"t": "जाना", "r": "jānā", "en": "to go (passive aux)", "pos": "verb"}, {"t": "सकना", "r": "saknā", "en": "can (able)", "pos": "verb"}, {"t": "चुकना", "r": "chuknā", "en": "to finish completely", "pos": "verb"}, {"t": "डालना", "r": "ḍālnā", "en": "to do forcefully", "pos": "verb"}, {"t": "खाया जाता", "r": "khāyā jātā", "en": "is eaten", "pos": "phrase"}, {"t": "बनाया गया", "r": "banāyā gayā", "en": "was made", "pos": "phrase"}, {"t": "लिखा गया", "r": "likhā gayā", "en": "was written", "pos": "phrase"}, {"t": "समझा गया", "r": "samjhā gayā", "en": "was understood", "pos": "phrase"}], "grammar": {"title": "Stem + या जाता है · compounds", "explain": "खाना खाया जाता है (food is eaten), घर बनाया गया (house was built). Compounds: खा लिया (ate it up — for self), खा दिया (ate it up — away)!", "pattern": "या जाता है · root + लिया/दिया", "examples": [{"t": "खाना खाया जाता है।", "r": "khānā khāyā jātā hai.", "en": "Food is eaten."}, {"t": "मैंने खाना खा लिया।", "r": "mainne khānā khā liyā.", "en": "I ate up the food."}, {"t": "किताब लिखी गई।", "r": "kitāb likhī gaī.", "en": "The book was written."}], "mistakes": ["Saying खाना खाता है for passive — passive: खाया जाता है!", "Mixing लिया/दिया: लिया = for-self, दिया = away!"]}, "dialogue": [{"sp": "प्रिया", "t": "खाना खाया गया?", "r": "khānā khāyā gayā?", "en": "Was the food eaten?"}, {"sp": "राहुल", "t": "हाँ, मैंने खा लिया!", "r": "hāṅ, mainne khā liyā!", "en": "Yes, I ate it up!"}, {"sp": "प्रिया", "t": "किताब लिखी गई?", "r": "kitāb likhī gaī?", "en": "Was the book written?"}, {"sp": "राहुल", "t": "हाँ, लिखी गई!", "r": "hāṅ, likhī gaī!", "en": "Yes, written!"}], "practice": [{"type": "translate_en", "q": "Say: Food is eaten", "answer": "खाना खाया जाता है"}, {"type": "fill", "q": "किताब ___ गई। (written, f)", "answer": "लिखी"}, {"type": "choose", "q": "'I ate up the food' is…", "options": ["मैंने खाना खाया", "मैंने खाना खा लिया", "मैं खाना खाता हूँ", "खाना खाया जाता है"], "answer": "मैंने खाना खा लिया"}, {"type": "reorder", "q": "Order: जाता है / खाया / खाना", "answer": "खाना खाया जाता है"}, {"type": "speak", "q": "Say aloud: खाना खाया जाता है।", "answer": "खाना खाया जाता है।"}], "quiz": [{"q": "खाया जाता है means…", "options": ["eats", "is eaten", "ate", "will eat"], "answer": 1, "why": "या + जाता = passive."}, {"q": "लिखी गई means…", "options": ["writes", "was written (f)", "will write", "is writing"], "answer": 1, "why": "यी + गई = past-passive-f."}, {"q": "खा लिया adds…", "options": ["nothing", "completion for-self", "question", "future"], "answer": 1, "why": "लिया = up/for-self."}, {"q": "सकना means…", "options": ["must", "can (able)", "want", "finish"], "answer": 1, "why": "सकना = be-able."}, {"q": "चुकना means…", "options": ["start", "finish completely", "try", "fail"], "answer": 1, "why": "खा चुका = fully-eaten."}], "flashcards": "auto:vocab", "worksheet": {"title": "Passive worksheet", "tasks": [{"instruction": "Translate to Hindi.", "items": ["to go (passive)", "can (able)", "was made"], "key": ["जाना", "सकना", "बनाया गया"]}, {"instruction": "Passives.", "items": ["Food is eaten", "The book was written", "I ate up the food"], "key": ["खाना खाया जाता है", "किताब लिखी गई", "मैंने खाना खा लिया"]}, {"instruction": "Check.", "items": ["Was the food eaten?", "Yes!"], "key": ["खाना खाया गया", "हाँ"]}]}}, {"id": "B2-U2-L2", "title": "Debate connectors", "learn": "Argue in Hindi! हालाँकि (although), इसलिए (that's why), इसके अलावा (besides), दूसरी ओर (on the other hand), संक्षेप में (in short), वास्तव में (actually)!", "vocab": [{"t": "हालाँकि", "r": "hālāṅki", "en": "although", "pos": "conjunction"}, {"t": "इसलिए", "r": "islie", "en": "that's why", "pos": "adverb"}, {"t": "इसके अलावा", "r": "iske alāvā", "en": "besides", "pos": "phrase"}, {"t": "दूसरी ओर", "r": "dūsrī or", "en": "on the other hand", "pos": "phrase"}, {"t": "संक्षेप में", "r": "sankshep men", "en": "in short", "pos": "phrase"}, {"t": "वास्तव में", "r": "vāstav men", "en": "actually", "pos": "phrase"}, {"t": "सच कहूँ तो", "r": "sach kahūṅ to", "en": "frankly", "pos": "phrase"}, {"t": "कुल मिलाकर", "r": "kul milākar", "en": "overall", "pos": "phrase"}], "grammar": {"title": "Connector chains", "explain": "मेट्रो अच्छी है, हालाँकि भीड़ है। इसके अलावा, सस्ती है! इसलिए मैं मेट्रो से जाता हूँ। (The metro is good, although crowded. Besides, cheap! So I go by metro!)", "pattern": "हालाँकि… इसके अलावा… इसलिए…", "examples": [{"t": "मेट्रो अच्छी है, हालाँकि भीड़ है।", "r": "meṭro achchhī hai, hālāṅki bhīṛ hai.", "en": "The metro is good, although crowded."}, {"t": "इसके अलावा, सस्ती है!", "r": "iske alāvā, sastī hai!", "en": "Besides, it's cheap!"}, {"t": "इसलिए मैं मेट्रो से जाता हूँ।", "r": "islie main meṭro se jātā hūṅ.", "en": "So I go by metro. (boy)"}], "mistakes": ["Stopping at लेकिन — add हालाँकि + इसके अलावा!", "Saying इसलिए at sentence END — इसलिए starts!"]}, "dialogue": [{"sp": "प्रिया", "t": "मेट्रो अच्छी है, हालाँकि भीड़ है।", "r": "meṭro achchhī hai, hālāṅki bhīṛ hai.", "en": "The metro is good, although crowded."}, {"sp": "राहुल", "t": "लेकिन गाड़ी तेज़ है!", "r": "lekin gāṛī tez hai!", "en": "But the car is fast!"}, {"sp": "प्रिया", "t": "इसके अलावा, मेट्रो सस्ती है!", "r": "iske alāvā, meṭro sastī hai!", "en": "Besides, the metro is cheap!"}, {"sp": "राहुल", "t": "संक्षेप में, दोनों अच्छे!", "r": "sankshep men, donon achchhe!", "en": "In short, both are good!"}], "practice": [{"type": "translate_en", "q": "Say (boy): So I go by metro", "answer": "इसलिए मैं मेट्रो से जाता हूँ"}, {"type": "fill", "q": "___ में, दोनों अच्छे! (In short)", "answer": "संक्षेप"}, {"type": "choose", "q": "'Although' is…", "options": ["इसलिए", "हालाँकि", "इसके अलावा", "संक्षेप में"], "answer": "हालाँकि"}, {"type": "reorder", "q": "Order: जाता हूँ / मेट्रो से / मैं / इसलिए", "answer": "इसलिए मैं मेट्रो से जाता हूँ"}, {"type": "speak", "q": "Say aloud: इसलिए मैं मेट्रो से जाता हूँ।", "answer": "इसलिए मैं मेट्रो से जाता हूँ।"}], "quiz": [{"q": "हालाँकि means…", "options": ["because", "although", "that's why", "in short"], "answer": 1, "why": "हालाँकि = although."}, {"q": "इसलिए means…", "options": ["although", "besides", "that's why", "in short"], "answer": 2, "why": "इसलिए = so/therefore."}, {"q": "इसके अलावा means…", "options": ["however", "besides", "therefore", "although"], "answer": 1, "why": "इसके अलावा = besides."}, {"q": "संक्षेप में means…", "options": ["in short", "for example", "of course", "by the way"], "answer": 0, "why": "संक्षेप में = in short."}, {"q": "वास्तव में means…", "options": ["frankly", "actually", "finally", "nearly"], "answer": 1, "why": "वास्तव में = in reality."}], "flashcards": "auto:vocab", "worksheet": {"title": "Debate worksheet", "tasks": [{"instruction": "Translate to Hindi.", "items": ["although", "that's why", "besides"], "key": ["हालाँकि", "इसलिए", "इसके अलावा"]}, {"instruction": "Argue.", "items": ["The metro is good, although crowded", "Besides, it's cheap", "So I go by metro (boy)"], "key": ["मेट्रो अच्छी है, हालाँकि भीड़ है", "इसके अलावा, सस्ती है", "इसलिए मैं मेट्रो से जाता हूँ"]}, {"instruction": "Conclude.", "items": ["In short, both are good!", "So I go by metro (boy)"], "key": ["संक्षेप में, दोनों अच्छे", "इसलिए मैं मेट्रो से जाता हूँ"]}]}}]}, {"id": "B2-U3", "title": "Culture and mastery", "lessons": [{"id": "B2-U3-L1", "title": "मेहमाननवाज़ी and festivals", "learn": "अतिथि देवो भव — the guest is god! पधारिए (please come in!), खाना खाइए (please eat!), चाय लीजिए (have tea)! Festivals: दिवाली (lights), होली (colours)!", "vocab": [{"t": "दाल", "r": "dāl", "en": "lentils (f)", "pos": "noun"}, {"t": "चावल", "r": "chāval", "en": "rice (m-pl)", "pos": "noun"}, {"t": "दिवाली", "r": "Divālī", "en": "Diwali (f)", "pos": "noun"}, {"t": "होली", "r": "Holī", "en": "Holi (f)", "pos": "noun"}, {"t": "मेहमान", "r": "mehmān", "en": "guest (m)", "pos": "noun"}, {"t": "अतिथि", "r": "atithi", "en": "guest (honorific)", "pos": "noun"}, {"t": "पधारिए", "r": "padhārie", "en": "please come in", "pos": "verb"}, {"t": "चाय", "r": "chāy", "en": "tea (f)", "pos": "noun"}], "grammar": {"title": "पधारिए · खाइए · अतिथि देवो भव", "explain": "पधारिए! (please grace us — come in!), खाना खाइए! (please eat!), चाय लीजिए! (have tea!). अतिथि देवो भव = the guest is god!", "pattern": "पधारिए · खाइए · लीजिए", "examples": [{"t": "पधारिए! खाना खाइए!", "r": "padhārie! khānā khāie!", "en": "Come in! Please eat!"}, {"t": "चाय लीजिए!", "r": "chāy lījie!", "en": "Have tea!"}, {"t": "अतिथि देवो भव।", "r": "atithi devo bhava.", "en": "The guest is god."}], "mistakes": ["Saying आओ to guests — guests get पधारिए!", "Rushing guests — मेहमाननवाज़ी needs time!"]}, "dialogue": [{"sp": "राहुल", "t": "पधारिए! खाना खाइए!", "r": "padhārie! khānā khāie!", "en": "Come in! Please eat!"}, {"sp": "प्रिया", "t": "धन्यवाद! खाना बहुत अच्छा है!", "r": "dhanyavād! khānā bahut achchhā hai!", "en": "Thanks! The food is very good!"}, {"sp": "राहुल", "t": "चाय लीजिए!", "r": "chāy lījie!", "en": "Have tea!"}, {"sp": "प्रिया", "t": "हाँ, कृपया!", "r": "hāṅ, kripayā!", "en": "Yes, please!"}], "practice": [{"type": "translate_en", "q": "Say: Come in! Please eat!", "answer": "पधारिए! खाना खाइए"}, {"type": "fill", "q": "चाय ___! (have/take)", "answer": "लीजिए"}, {"type": "choose", "q": "'The guest is god' is…", "options": ["मेहमान अच्छा है", "अतिथि देवो भव", "पधारिए खाइए", "चाय लीजिए"], "answer": "अतिथि देवो भव"}, {"type": "reorder", "q": "Order: खाइए / खाना / पधारिए", "answer": "पधारिए खाना खाइए"}, {"type": "speak", "q": "Say aloud: पधारिए! खाना खाइए!", "answer": "पधारिए! खाना खाइए!"}], "quiz": [{"q": "पधारिए means…", "options": ["goodbye", "please come in", "thank you", "excuse me"], "answer": 1, "why": "पधारिए = grace-come (formal)."}, {"q": "खाना खाइए means…", "options": ["I eat", "please eat", "he eats", "don't eat"], "answer": 1, "why": "खाइए = formal eat!"}, {"q": "अतिथि देवो भव means…", "options": ["love food", "the guest is god", "welcome home", "eat well"], "answer": 1, "why": "Hospitality motto!."}, {"q": "दिवाली is…", "options": ["colours festival", "lights festival", "harvest", "new year only"], "answer": 1, "why": "दिवाली = festival of lights."}, {"q": "होली is…", "options": ["lights festival", "colours festival", "fast", "wedding"], "answer": 1, "why": "होली = festival of colours."}], "flashcards": "auto:vocab", "worksheet": {"title": "Hospitality worksheet", "tasks": [{"instruction": "Translate to Hindi.", "items": ["lentils", "guest", "tea"], "key": ["दाल", "मेहमान", "चाय"]}, {"instruction": "Host guests.", "items": ["Come in! Please eat!", "Have tea!", "The guest is god"], "key": ["पधारिए! खाना खाइए", "चाय लीजिए", "अतिथि देवो भव"]}, {"instruction": "Be a guest.", "items": ["Thanks! The food is very good!", "Yes, please!"], "key": ["धन्यवाद! खाना बहुत अच्छा है", "हाँ, कृपया"]}]}}, {"id": "B2-U3-L2", "title": "Storytelling: एक बार", "learn": "Graduation! एक बार (once), एक दिन (one day), अचानक (suddenly), आखिरकार (at last), अंत में (in the end). Mix tenses: गया, खा रहा था, खाऊँगा! Tell YOUR Delhi story!", "vocab": [{"t": "एक बार", "r": "ek bār", "en": "once", "pos": "phrase"}, {"t": "एक दिन", "r": "ek din", "en": "one day", "pos": "phrase"}, {"t": "अचानक", "r": "achānak", "en": "suddenly", "pos": "adverb"}, {"t": "आखिरकार", "r": "ākhirkār", "en": "at last", "pos": "adverb"}, {"t": "अंत में", "r": "ant men", "en": "in the end", "pos": "phrase"}, {"t": "दरअसल", "r": "darasal", "en": "actually", "pos": "adverb"}, {"t": "अफ़सोस", "r": "afsos", "en": "pity / regret", "pos": "noun"}, {"t": "सौभाग्य से", "r": "saubhāgya se", "en": "luckily", "pos": "phrase"}], "grammar": {"title": "Story spine: एक बार…अंत में", "explain": "एक बार…एक दिन…अचानक…आखिरकार…अंत में — the five-beat Hindi story spine. Mix गया + खा रहा था + खाऊँगा!", "pattern": "एक बार → एक दिन → अचानक → अंत में", "examples": [{"t": "एक बार मैं दिल्ली गया।", "r": "ek bār main Dillī gayā.", "en": "Once I went to Delhi. (boy)"}, {"t": "अचानक बारिश हुई!", "r": "achānak bārish huī!", "en": "Suddenly it rained!"}, {"t": "अंत में मैं घर आया।", "r": "ant men main ghar āyā.", "en": "In the end I came home. (boy)"}], "mistakes": ["Starting tales with कल — stories open एक बार!", "Using only गया — mix रहा था + गा + ने!"]}, "dialogue": [{"sp": "राहुल", "t": "अपनी कहानी सुनाओ!", "r": "apnī kahānī sunāo!", "en": "Tell your story! (casual)"}, {"sp": "प्रिया", "t": "एक बार मैं दिल्ली गई। मौसम अच्छा था।", "r": "ek bār main Dillī gaī. mausam achchhā thā.", "en": "Once I went to Delhi. (girl) The weather was good."}, {"sp": "राहुल", "t": "फिर क्या हुआ?", "r": "phir kyā huā?", "en": "Then what happened?"}, {"sp": "प्रिया", "t": "अचानक बारिश हुई! अंत में मैं घर आई!", "r": "achānak bārish huī! ant men main ghar āī!", "en": "Suddenly it rained! In the end I came home! (girl)"}], "practice": [{"type": "translate_en", "q": "Say (boy): Once I went to Delhi", "answer": "एक बार मैं दिल्ली गया"}, {"type": "fill", "q": "___ बारिश हुई! (Suddenly)", "answer": "अचानक"}, {"type": "choose", "q": "Stories open with…", "options": ["कल", "एक बार", "आने वाला कल", "आज"], "answer": "एक बार"}, {"type": "reorder", "q": "Order: हुई / बारिश / अचानक", "answer": "अचानक बारिश हुई"}, {"type": "speak", "q": "Say aloud: एक बार मैं दिल्ली गई।", "answer": "एक बार मैं दिल्ली गई।"}], "quiz": [{"q": "एक बार means…", "options": ["every time", "once", "twice", "never"], "answer": 1, "why": "Story opener."}, {"q": "अचानक means…", "options": ["slowly", "suddenly", "finally", "then"], "answer": 1, "why": "अचानक = suddenly."}, {"q": "अंत में means…", "options": ["at first", "in the end", "suddenly", "actually"], "answer": 1, "why": "अंत में = in the end."}, {"q": "अफ़सोस means…", "options": ["luck", "pity / regret", "joy", "anger"], "answer": 1, "why": "अफ़सोस = what a pity."}, {"q": "दरअसल means…", "options": ["finally", "actually", "suddenly", "luckily"], "answer": 1, "why": "दरअसल = actually."}], "flashcards": "auto:vocab", "worksheet": {"title": "Storytelling worksheet", "tasks": [{"instruction": "Translate to Hindi.", "items": ["once", "suddenly", "in the end"], "key": ["एक बार", "अचानक", "अंत में"]}, {"instruction": "Spine a story.", "items": ["Once I went to Delhi (boy)", "Suddenly it rained", "In the end I came home (boy)"], "key": ["एक बार मैं दिल्ली गया", "अचानक बारिश हुई", "अंत में मैं घर आया"]}, {"instruction": "Tell it.", "items": ["Tell your story! (casual)", "The weather was good"], "key": ["अपनी कहानी सुनाओ", "मौसम अच्छा था"]}]}}]}], "test": {"title": "B2 final test", "items": [{"type": "translate_en", "q": "Say (boy): I want you to come", "answer": "मैं चाहता हूँ कि तुम आओ"}, {"type": "translate_en", "q": "Say (boy): If it rained, I'd stay home", "answer": "अगर बारिश होती, तो मैं घर रहता"}, {"type": "choose", "q": "'Food is eaten'", "options": ["खाना खाता है", "खाना खाया जाता है", "खाना खा लिया", "खाना खाएगा"], "answer": "खाना खाया जाता है"}, {"type": "translate_t", "q": "इसके अलावा, मेट्रो सस्ती है!", "answer": "Besides, the metro is cheap!"}, {"type": "fill", "q": "शायद वह ___। (come-subj)", "answer": "आए"}, {"type": "choose", "q": "'The guest is god'", "options": ["मेहमान अच्छा है", "अतिथि देवो भव", "पधारिए खाइए", "चाय लीजिए"], "answer": "अतिथि देवो भव"}, {"type": "reorder", "q": "Order: हुई / बारिश / अचानक", "answer": "अचानक बारिश हुई"}, {"type": "speak", "q": "Say aloud: पधारिए! खाना खाइए!", "answer": "पधारिए! खाना खाइए!"}, {"type": "fill", "q": "___ में, दोनों अच्छे! (In short)", "answer": "संक्षेप"}, {"type": "translate_en", "q": "Say: Come in! Please eat!", "answer": "पधारिए! खाना खाइए"}]}}}