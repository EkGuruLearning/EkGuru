{"code": "ru", "name": "Russian", "native": "Русский", "phase": 1, "medium": "en", "file_level": "A1", "pronunciation": [{"t": "А а sounds like AH", "r": "ah", "tip": "Open your mouth wide: МАМА (mama) = mum."}, {"t": "Unstressed О sounds like AH", "r": "ah", "tip": "МОЛОКО sounds like muh-lah-KOH (milk). Stress matters!"}, {"t": "Р р is a rolled R", "r": "rolled r", "tip": "Trill the tongue tip: ПРИВЕТ (privet) = hi."}, {"t": "Ы is a deep throaty I", "r": "uh-ee", "tip": "Say EE while pulling your tongue back: МЫ (my) = we."}, {"t": "Ж ж sounds like ZH", "r": "zh", "tip": "Like the S in PLEASURE: ЖИЗНЬ (zheezn) = life."}], "alphabet": {"title": "The Cyrillic alphabet", "explain": "Russian uses Cyrillic letters. Many look like Latin letters but sound different — В sounds like V, Н like N, Р like R! Learn the sounds, not the look-alikes.", "letters": [{"t": "А а", "r": "ah"}, {"t": "Б б", "r": "b"}, {"t": "В в", "r": "v"}, {"t": "Г г", "r": "g (go)"}, {"t": "Д д", "r": "d"}, {"t": "Е е", "r": "yeh"}, {"t": "Ё ё", "r": "yoh"}, {"t": "Ж ж", "r": "zh"}, {"t": "З з", "r": "z"}, {"t": "И и", "r": "ee"}, {"t": "Й й", "r": "y (boy)"}, {"t": "К к", "r": "k"}, {"t": "Л л", "r": "l"}, {"t": "М м", "r": "m"}, {"t": "Н н", "r": "n"}, {"t": "О о", "r": "oh (stressed) / ah (unstressed)"}, {"t": "П п", "r": "p"}, {"t": "Р р", "r": "rolled r"}, {"t": "С с", "r": "s"}, {"t": "Т т", "r": "t"}, {"t": "У у", "r": "oo"}, {"t": "Ф ф", "r": "f"}, {"t": "Х х", "r": "kh (loch)"}, {"t": "Ц ц", "r": "ts"}, {"t": "Ч ч", "r": "ch"}, {"t": "Ш ш", "r": "sh"}, {"t": "Щ щ", "r": "shch (soft sh)"}, {"t": "Ъ ъ", "r": "hard sign (silent)"}, {"t": "Ы ы", "r": "uh-ee"}, {"t": "Ь ь", "r": "soft sign (softens)"}, {"t": "Э э", "r": "eh"}, {"t": "Ю ю", "r": "yoo"}, {"t": "Я я", "r": "yah"}]}, "counting": {"title": "Counting 0 to 100", "numbers": [{"t": "ноль", "r": "nol", "en": "0"}, {"t": "один", "r": "ah-DEEN", "en": "1"}, {"t": "два", "r": "dvah", "en": "2"}, {"t": "три", "r": "tree", "en": "3"}, {"t": "четыре", "r": "chih-TIH-rih", "en": "4"}, {"t": "пять", "r": "pyaht", "en": "5"}, {"t": "шесть", "r": "shehst", "en": "6"}, {"t": "семь", "r": "sehmy", "en": "7"}, {"t": "восемь", "r": "VOH-sihmy", "en": "8"}, {"t": "девять", "r": "DYEH-vihty", "en": "9"}, {"t": "десять", "r": "DYEH-sihty", "en": "10"}, {"t": "одиннадцать", "r": "ah-dee-NAHT-tsahty", "en": "11"}, {"t": "двенадцать", "r": "dvih-NAHT-tsahty", "en": "12"}, {"t": "тринадцать", "r": "tree-NAHT-tsahty", "en": "13"}, {"t": "четырнадцать", "r": "chih-TIHR-naht-tsahty", "en": "14"}, {"t": "пятнадцать", "r": "piht-NAHT-tsahty", "en": "15"}, {"t": "шестнадцать", "r": "shihst-NAHT-tsahty", "en": "16"}, {"t": "семнадцать", "r": "sihm-NAHT-tsahty", "en": "17"}, {"t": "восемнадцать", "r": "vah-sihm-NAHT-tsahty", "en": "18"}, {"t": "девятнадцать", "r": "dih-viht-NAHT-tsahty", "en": "19"}, {"t": "двадцать", "r": "DVAHT-tsahty", "en": "20"}, {"t": "тридцать", "r": "TREET-tsahty", "en": "30"}, {"t": "сорок", "r": "SOH-rahk", "en": "40"}, {"t": "пятьдесят", "r": "piht-dih-SYAHT", "en": "50"}, {"t": "шестьдесят", "r": "shihst-dih-SYAHT", "en": "60"}, {"t": "семьдесят", "r": "SEHM-dih-siht", "en": "70"}, {"t": "восемьдесят", "r": "VOH-sihm-dih-siht", "en": "80"}, {"t": "девяносто", "r": "dih-vih-NOH-stah", "en": "90"}, {"t": "сто", "r": "stoh", "en": "100"}], "rules": ["11–19 end in -НАДЦАТЬ (like '-teen'): ДВЕ-НАДЦАТЬ = 12.", "40 (СОРОК) and 90 (ДЕВЯНОСТО) are rebels — memorise them! 21 = ДВАДЦАТЬ ОДИН (20 + 1)."], "explain": "Numbers 0–20 first, then tens to 100. Combine tens + ones: ДВАДЦАТЬ ОДИН = 21."}, "level": {"title": "Starter: greetings, gender, first verbs", "goals": ["Greet people and introduce yourself", "Know gender, plurals and numbers", "Use first verbs and say 'I have'"], "units": [{"id": "A1-U1", "title": "First words", "lessons": [{"id": "A1-U1-L1", "title": "Greetings and names", "learn": "Start Russian! ЗДРАВСТВУЙТЕ (formal hello), ПРИВЕТ (hi), МЕНЯ ЗОВУТ + name = My name is... ВЫ = formal you, ТЫ = friend you. Start formal with adults!", "vocab": [{"t": "здравствуйте", "r": "ZDRAH-stvooy-tyeh", "en": "hello (formal)", "pos": "phrase"}, {"t": "привет", "r": "pree-VYEHT", "en": "hi", "pos": "phrase"}, {"t": "меня зовут", "r": "mih-NYAH zah-VOOT", "en": "my name is", "pos": "phrase"}, {"t": "спасибо", "r": "spah-SEE-bah", "en": "thanks", "pos": "phrase"}, {"t": "пожалуйста", "r": "pah-ZHAH-loo-stah", "en": "please / you're welcome", "pos": "phrase"}, {"t": "да", "r": "dah", "en": "yes", "pos": "phrase"}, {"t": "нет", "r": "nyeht", "en": "no", "pos": "phrase"}, {"t": "до свидания", "r": "dah svee-DAH-nyah", "en": "goodbye", "pos": "phrase"}], "grammar": {"title": "Меня зовут + name", "explain": "МЕНЯ ЗОВУТ АННА = My name is Anna (literally: ME they-call Anna). Just add your name — no verb to change!", "pattern": "меня зовут + name", "examples": [{"t": "Меня зовут Анна.", "r": "mih-NYAH zah-VOOT AH-nah.", "en": "My name is Anna."}, {"t": "Меня зовут Иван.", "r": "mih-NYAH zah-VOOT ee-VAHN.", "en": "My name is Ivan."}, {"t": "А вас?", "r": "ah vahs?", "en": "And you? (formal)"}], "mistakes": ["Using ПРИВЕТ with a teacher — use ЗДРАВСТВУЙТЕ!", "Saying МОЁ ИМЯ first — natives say МЕНЯ ЗОВУТ."]}, "dialogue": [{"sp": "Анна", "t": "Здравствуйте! Меня зовут Анна.", "r": "ZDRAH-stvooy-tyeh! mih-NYAH zah-VOOT AH-nah.", "en": "Hello! My name is Anna."}, {"sp": "Иван", "t": "Привет! Меня зовут Иван.", "r": "pree-VYEHT! mih-NYAH zah-VOOT ee-VAHN.", "en": "Hi! My name is Ivan."}, {"sp": "Анна", "t": "Спасибо! До свидания!", "r": "spah-SEE-bah! dah svee-DAH-nyah!", "en": "Thanks! Goodbye!"}, {"sp": "Иван", "t": "Пожалуйста! До свидания!", "r": "pah-ZHAH-loo-stah! dah svee-DAH-nyah!", "en": "You're welcome! Goodbye!"}], "practice": [{"type": "translate_en", "q": "Say: My name is Anna", "answer": "Меня зовут Анна"}, {"type": "fill", "q": "___! (hi, informal)", "answer": "Привет"}, {"type": "choose", "q": "To a teacher you say…", "options": ["Привет", "Здравствуйте", "Пока", "Да"], "answer": "Здравствуйте"}, {"type": "reorder", "q": "Order: зовут / меня / Иван", "answer": "меня зовут Иван"}, {"type": "speak", "q": "Say aloud: Меня зовут Анна.", "answer": "Меня зовут Анна."}], "quiz": [{"q": "МЕНЯ ЗОВУТ means…", "options": ["I am from", "my name is", "I live in", "I like"], "answer": 1, "why": "Меня зовут + name = introduction."}, {"q": "ЗДРАВСТВУЙТЕ is…", "options": ["hi (friends)", "hello (formal)", "goodbye", "thanks"], "answer": 1, "why": "Formal hello for adults/strangers."}, {"q": "ПОЖАЛУЙСТА means…", "options": ["sorry", "please / you're welcome", "yes", "hello"], "answer": 1, "why": "Two jobs: please + you're welcome."}, {"q": "ДО СВИДАНИЯ is…", "options": ["hello", "goodbye", "thanks", "please"], "answer": 1, "why": "До свидания = goodbye."}, {"q": "ПРИВЕТ is for…", "options": ["teachers", "friends", "bosses", "strangers"], "answer": 1, "why": "Привет = informal hi."}], "flashcards": "auto:vocab", "worksheet": {"title": "Greetings worksheet", "tasks": [{"instruction": "Translate to Russian.", "items": ["hello (formal)", "thanks", "goodbye"], "key": ["здравствуйте", "спасибо", "до свидания"]}, {"instruction": "Introduce yourself.", "items": ["My name is Anna", "And you? (formal)"], "key": ["Меня зовут Анна", "А вас?"]}, {"instruction": "Formal or informal?", "items": ["To a teacher", "To a friend"], "key": ["здравствуйте", "привет"]}]}}, {"id": "A1-U1-L2", "title": "How are you and small talk", "learn": "КАК ДЕЛА? = How are things? Answer: ХОРОШО (good), НОРМАЛЬНО (okay), ПЛОХО (badly). Ask back: А У ВАС? (And you?). Small talk unlocks every conversation!", "vocab": [{"t": "как дела", "r": "kahk dih-LAH", "en": "how are you", "pos": "phrase"}, {"t": "хорошо", "r": "khah-rah-SHOH", "en": "well / good", "pos": "adverb"}, {"t": "плохо", "r": "PLOH-khah", "en": "badly", "pos": "adverb"}, {"t": "нормально", "r": "nahr-MAHL-nah", "en": "okay / normal", "pos": "adverb"}, {"t": "а вы", "r": "ah vih", "en": "and you", "pos": "phrase"}, {"t": "извините", "r": "eez-vee-NEE-tyeh", "en": "excuse me / sorry", "pos": "phrase"}, {"t": "очень", "r": "OH-chihny", "en": "very", "pos": "adverb"}, {"t": "тоже", "r": "TOH-zhih", "en": "also / too", "pos": "adverb"}], "grammar": {"title": "Short answers: хорошо!", "explain": "No verb needed! КАК ДЕЛА? → ХОРОШО, СПАСИБО! Boost with ОЧЕНЬ: ОЧЕНЬ ХОРОШО = very good.", "pattern": "как дела? → хорошо/нормально/плохо", "examples": [{"t": "Как дела?", "r": "kahk dih-LAH?", "en": "How are things?"}, {"t": "Хорошо, спасибо!", "r": "khah-rah-SHOH, spah-SEE-bah!", "en": "Good, thanks!"}, {"t": "А у вас? Тоже хорошо.", "r": "ah oo vahs? TOH-zhih khah-rah-SHOH.", "en": "And you? Also good."}], "mistakes": ["Saying Я ХОРОШО — just ХОРОШО alone!", "Forgetting to ask back: always А У ВАС?"]}, "dialogue": [{"sp": "Анна", "t": "Привет! Как дела?", "r": "pree-VYEHT! kahk dih-LAH?", "en": "Hi! How are you?"}, {"sp": "Иван", "t": "Хорошо, спасибо! А у вас?", "r": "khah-rah-SHOH, spah-SEE-bah! ah oo vahs?", "en": "Good, thanks! And you?"}, {"sp": "Анна", "t": "Очень хорошо!", "r": "OH-chihny khah-rah-SHOH!", "en": "Very good!"}, {"sp": "Иван", "t": "Извините, мне пора!", "r": "eez-vee-NEE-tyeh, mnyeh pah-RAH!", "en": "Sorry, I must go!"}], "practice": [{"type": "translate_en", "q": "Say: How are you?", "answer": "Как дела?"}, {"type": "fill", "q": "___ хорошо! (Very)", "answer": "Очень"}, {"type": "choose", "q": "'And you?' (formal) is…", "options": ["А ты?", "А у вас?", "И вы?", "Вы тоже?"], "answer": "А у вас?"}, {"type": "reorder", "q": "Order: дела / как", "answer": "как дела"}, {"type": "speak", "q": "Say aloud: Хорошо, спасибо! А у вас?", "answer": "Хорошо, спасибо! А у вас?"}], "quiz": [{"q": "КАК ДЕЛА? means…", "options": ["What time?", "How are you?", "Where are you?", "Who are you?"], "answer": 1, "why": "Как дела = how are things."}, {"q": "НОРМАЛЬНО means…", "options": ["great", "okay", "bad", "never"], "answer": 1, "why": "Нормально = normal/okay."}, {"q": "ИЗВИНИТЕ means…", "options": ["thanks", "sorry / excuse me", "hello", "goodbye"], "answer": 1, "why": "Извините = formal sorry."}, {"q": "ТОЖЕ means…", "options": ["very", "also / too", "well", "badly"], "answer": 1, "why": "Тоже = too/also."}, {"q": "ОЧЕНЬ ХОРОШО means…", "options": ["good thanks", "very good", "not good", "so-so"], "answer": 1, "why": "Очень = very."}], "flashcards": "auto:vocab", "worksheet": {"title": "Small talk worksheet", "tasks": [{"instruction": "Translate to Russian.", "items": ["how are you", "very", "also"], "key": ["как дела", "очень", "тоже"]}, {"instruction": "Answer.", "items": ["Как дела? → …", "А у вас? → …"], "key": ["Хорошо, спасибо", "Тоже хорошо"]}, {"instruction": "Finish the chat.", "items": ["Sorry, I must go!", "Goodbye!"], "key": ["Извините, мне пора", "До свидания"]}]}}]}, {"id": "A1-U2", "title": "Gender and numbers", "lessons": [{"id": "A1-U2-L1", "title": "Gender: он, она, оно", "learn": "Every Russian noun has a gender! -А/-Я = SHE (МАМА), consonant = HE (ДОМ), -О/-Е = IT (ОКНО). ОН/ОНА/ОНО = he/she/it. Spot the ending, know the gender!", "vocab": [{"t": "он", "r": "ohn", "en": "he", "pos": "pronoun"}, {"t": "она", "r": "ah-NAH", "en": "she", "pos": "pronoun"}, {"t": "оно", "r": "ah-NOH", "en": "it", "pos": "pronoun"}, {"t": "они", "r": "ah-NEE", "en": "they", "pos": "pronoun"}, {"t": "это", "r": "EH-tah", "en": "this is", "pos": "phrase"}, {"t": "не", "r": "nyeh", "en": "not", "pos": "phrase"}, {"t": "и", "r": "ee", "en": "and", "pos": "conjunction"}, {"t": "или", "r": "EE-lee", "en": "or", "pos": "conjunction"}], "grammar": {"title": "Gender by ending: -а, consonant, -о", "explain": "МАМА ends in -А → SHE (ОНА). ДОМ ends in a consonant → HE (ОН). ОКНО ends in -О → IT (ОНО). ЭТО works for everything: ЭТО ДОМ = This is a house.", "pattern": "-а/-я → она · consonant → он · -о/-е → оно", "examples": [{"t": "Это мама. Она добрая.", "r": "EH-tah MAH-mah. ah-NAH DOH-brah-yah.", "en": "This is mum. She is kind."}, {"t": "Это дом. Он большой.", "r": "EH-tah dohm. ohn bahl-SHOY.", "en": "This is a house. It (he) is big."}, {"t": "Это окно. Оно открыто.", "r": "EH-tah ahk-NOH. ah-NOH aht-KRIH-tah.", "en": "This is a window. It is open."}], "mistakes": ["Saying ОН for МАМА — -A endings are always ONA!", "Using ОНО for people — people are ОН or ОНА only."]}, "dialogue": [{"sp": "Анна", "t": "Это дом?", "r": "EH-tah dohm?", "en": "Is this a house?"}, {"sp": "Иван", "t": "Да, это дом. Он большой.", "r": "dah, EH-tah dohm. ohn bahl-SHOY.", "en": "Yes, this is a house. It is big."}, {"sp": "Анна", "t": "А это мама?", "r": "ah EH-tah MAH-mah?", "en": "And is this mum?"}, {"sp": "Иван", "t": "Да! Она добрая.", "r": "dah! ah-NAH DOH-brah-yah.", "en": "Yes! She is kind."}], "practice": [{"type": "translate_en", "q": "Say: This is a house", "answer": "Это дом"}, {"type": "fill", "q": "Это мама. ___ добрая. (She)", "answer": "Она"}, {"type": "choose", "q": "ОКНО (window, -O) is…", "options": ["он", "она", "оно", "они"], "answer": "оно"}, {"type": "reorder", "q": "Order: дом / это", "answer": "это дом"}, {"type": "speak", "q": "Say aloud: Это дом. Он большой.", "answer": "Это дом. Он большой."}], "quiz": [{"q": "-А endings are…", "options": ["он", "она", "оно", "они"], "answer": 1, "why": "МАМА → она."}, {"q": "ДОМ (consonant ending) is…", "options": ["он", "она", "оно", "они"], "answer": 0, "why": "Consonant → он."}, {"q": "ЭТО means…", "options": ["that", "this is", "it is not", "they are"], "answer": 1, "why": "Это = this is."}, {"q": "ОНИ means…", "options": ["we", "they", "you", "it"], "answer": 1, "why": "Они = they."}, {"q": "ОКНО takes…", "options": ["он", "она", "оно", "они"], "answer": 2, "why": "-O → оно."}], "flashcards": "auto:vocab", "worksheet": {"title": "Gender worksheet", "tasks": [{"instruction": "Translate to Russian.", "items": ["he", "she", "they"], "key": ["он", "она", "они"]}, {"instruction": "Pick он/она/оно.", "items": ["мама", "дом", "окно"], "key": ["она", "он", "оно"]}, {"instruction": "Describe.", "items": ["This is a house. It is big.", "This is mum. She is kind."], "key": ["Это дом. Он большой", "Это мама. Она добрая"]}]}}, {"id": "A1-U2-L2", "title": "Plurals and numbers in use", "learn": "Plurals are easy: add -Ы/-И! ДОМ → ДОМА (houses), МАМА → МАМЫ. Numbers agree: ОДИН ДОМ (m), ОДНА МАМА (f), ОДНО ОКНО (n). СКОЛЬКО? = How many?", "vocab": [{"t": "один", "r": "ah-DEEN", "en": "one (m)", "pos": "number"}, {"t": "два", "r": "dvah", "en": "two", "pos": "number"}, {"t": "три", "r": "tree", "en": "3", "pos": "number"}, {"t": "четыре", "r": "chih-TIH-rih", "en": "4", "pos": "number"}, {"t": "пять", "r": "pyaht", "en": "5", "pos": "number"}, {"t": "много", "r": "MNOH-gah", "en": "many / a lot", "pos": "adverb"}, {"t": "мало", "r": "MAH-lah", "en": "few / little", "pos": "adverb"}, {"t": "сколько", "r": "SKOHL-kah", "en": "how many", "pos": "phrase"}], "grammar": {"title": "Plurals with -ы/-и", "explain": "ДОМ → ДОМА, МАМА → МАМЫ, ОКНО → ОКНА. After К/Г/Х/Ж/Ш/Ч/Щ use -И: КНИГА → КНИГИ. ОДНА for feminine: ОДНА МАМА!", "pattern": "noun + ы/и · одна (f) / одно (n)", "examples": [{"t": "Два дома.", "r": "dvah DOH-mah.", "en": "Two houses."}, {"t": "Одна мама.", "r": "ahd-NAH MAH-mah.", "en": "One mum."}, {"t": "Сколько книг? Много!", "r": "SKOHL-kah kneek? MNOH-gah!", "en": "How many books? Many!"}], "mistakes": ["Saying ОДИН МАМА — feminine needs ОДНА!", "Adding -Ы after К: КНИГИ with -И, not -Ы!"]}, "dialogue": [{"sp": "Иван", "t": "Сколько книг?", "r": "SKOHL-kah kneek?", "en": "How many books?"}, {"sp": "Анна", "t": "Три книги. А у вас?", "r": "tree KNEE-gee. ah oo vahs?", "en": "Three books. And you?"}, {"sp": "Иван", "t": "Пять книг. Много!", "r": "pyaht kneek. MNOH-gah!", "en": "Five books. Many!"}, {"sp": "Анна", "t": "Мало? Нет, много!", "r": "MAH-lah? nyeht, MNOH-gah!", "en": "Few? No, many!"}], "practice": [{"type": "translate_en", "q": "Say: Two houses", "answer": "Два дома"}, {"type": "fill", "q": "___ мама. (One, feminine)", "answer": "Одна"}, {"type": "choose", "q": "'How many books?' is…", "options": ["Сколько книг?", "Много книг?", "Какие книги?", "Где книги?"], "answer": "Сколько книг?"}, {"type": "reorder", "q": "Order: книг / сколько", "answer": "сколько книг"}, {"type": "speak", "q": "Say aloud: Сколько книг?", "answer": "Сколько книг?"}], "quiz": [{"q": "ОДНА is used with…", "options": ["masculine", "feminine", "neuter", "plural"], "answer": 1, "why": "ОДНА МАМА — feminine one."}, {"q": "ДОМ → plural is…", "options": ["домы", "дома", "доми", "домыи"], "answer": 1, "why": "Дом → дома (houses)."}, {"q": "СКОЛЬКО? means…", "options": ["How much/many?", "Where?", "When?", "Why?"], "answer": 0, "why": "Сколько = how many."}, {"q": "КНИГА → plural is…", "options": ["книгы", "книги", "книга", "книг"], "answer": 1, "why": "After Г use -И: книги."}, {"q": "МНОГО means…", "options": ["few", "many", "one", "none"], "answer": 1, "why": "Много = many/a lot."}], "flashcards": "auto:vocab", "worksheet": {"title": "Plurals worksheet", "tasks": [{"instruction": "Translate to Russian.", "items": ["two", "five", "how many"], "key": ["два", "пять", "сколько"]}, {"instruction": "Make plurals.", "items": ["дом → …", "мама → …", "книга → …"], "key": ["дома", "мамы", "книги"]}, {"instruction": "Agree ОДИН.", "items": ["one mum (f)", "one window (n)"], "key": ["одна мама", "одно окно"]}]}}]}, {"id": "A1-U3", "title": "First verbs", "lessons": [{"id": "A1-U3-L1", "title": "Present tense: я говорю", "learn": "Your first verb! ГОВОРИТЬ (to speak): Я ГОВОРЮ, ТЫ ГОВОРИШЬ, ОН ГОВОРИТ, МЫ ГОВОРИМ, ВЫ ГОВОРИТЕ, ОНИ ГОВОРЯТ. Six endings — learn the music of -Ю/-ИШЬ/-ИТ!", "vocab": [{"t": "говорить", "r": "gah-vah-REETY", "en": "to speak", "pos": "verb"}, {"t": "жить", "r": "zhihty", "en": "to live", "pos": "verb"}, {"t": "работать", "r": "rah-BOH-tahty", "en": "to work", "pos": "verb"}, {"t": "учить", "r": "oo-CHEETY", "en": "to learn", "pos": "verb"}, {"t": "любить", "r": "lyoo-BEETY", "en": "to love", "pos": "verb"}, {"t": "хотеть", "r": "khah-TYEHTY", "en": "to want", "pos": "verb"}, {"t": "мочь", "r": "mohch", "en": "to be able", "pos": "verb"}, {"t": "знать", "r": "znahty", "en": "to know", "pos": "verb"}], "grammar": {"title": "Present tense: говорю, говоришь, говорит", "explain": "ГОВОРИТЬ: Я ГОВОРЮ (I speak), ТЫ ГОВОРИШЬ, ОН/ОНА ГОВОРИТ, МЫ ГОВОРИМ, ВЫ ГОВОРИТЕ, ОНИ ГОВОРЯТ. Drop -ИТЬ, add the ending!", "pattern": "говор-ю/ишь/ит/им/ите/ят", "examples": [{"t": "Я говорю по-русски.", "r": "yah gah-vah-RYOO pah-ROO-skee.", "en": "I speak Russian."}, {"t": "Вы говорите по-английски?", "r": "vih gah-vah-REE-tyeh pah-ahn-GLEE-skee?", "en": "Do you speak English?"}, {"t": "Они говорят громко.", "r": "ah-NEE gah-vah-RYAHT GROHM-kah.", "en": "They speak loudly."}], "mistakes": ["Saying Я ГОВОРИТ — Я takes ГОВОРЮ!", "Using ТЫ with strangers — default to ВЫ!"]}, "dialogue": [{"sp": "Анна", "t": "Вы говорите по-английски?", "r": "vih gah-vah-REE-tyeh pah-ahn-GLEE-skee?", "en": "Do you speak English?"}, {"sp": "Иван", "t": "Да, я говорю по-английски. А вы?", "r": "dah, yah gah-vah-RYOO pah-ahn-GLEE-skee. ah vih?", "en": "Yes, I speak English. And you?"}, {"sp": "Анна", "t": "Я говорю по-русски!", "r": "yah gah-vah-RYOO pah-ROO-skee!", "en": "I speak Russian!"}, {"sp": "Иван", "t": "Отлично!", "r": "aht-LEECH-nah!", "en": "Excellent!"}], "practice": [{"type": "translate_en", "q": "Say: I speak Russian", "answer": "Я говорю по-русски"}, {"type": "fill", "q": "Вы ___ по-английски? (speak)", "answer": "говорите"}, {"type": "choose", "q": "'They speak loudly' is…", "options": ["Они говорю громко", "Они говорят громко", "Они говорит громко", "Они говорим громко"], "answer": "Они говорят громко"}, {"type": "reorder", "q": "Order: говорю / по-русски / я", "answer": "я говорю по-русски"}, {"type": "speak", "q": "Say aloud: Вы говорите по-английски?", "answer": "Вы говорите по-английски?"}], "quiz": [{"q": "Я ГОВОРЮ means…", "options": ["you speak", "I speak", "he speaks", "they speak"], "answer": 1, "why": "Я + говорЮ."}, {"q": "ОНИ ГОВОРЯТ means…", "options": ["we speak", "you speak", "they speak", "I speak"], "answer": 2, "why": "Они + говорЯТ."}, {"q": "ПО-РУССКИ means…", "options": ["in Russia", "in Russian", "from Russia", "to Russia"], "answer": 1, "why": "По-русски = in Russian."}, {"q": "ВЫ ГОВОРИТЕ is…", "options": ["I speak", "you (formal) speak", "he speaks", "we speak"], "answer": 1, "why": "Вы + говорИТЕ."}, {"q": "ТЫ ending is…", "options": ["-ю", "-ишь", "-ит", "-ят"], "answer": 1, "why": "Ты говорИШЬ."}], "flashcards": "auto:vocab", "worksheet": {"title": "Present tense worksheet", "tasks": [{"instruction": "Translate to Russian.", "items": ["to speak", "to live", "to know"], "key": ["говорить", "жить", "знать"]}, {"instruction": "Conjugate ГОВОРИТЬ.", "items": ["I speak", "you (formal) speak", "they speak"], "key": ["я говорю", "вы говорите", "они говорят"]}, {"instruction": "Ask it.", "items": ["Do you speak English?", "I speak Russian!"], "key": ["Вы говорите по-английски?", "Я говорю по-русски!"]}]}}, {"id": "A1-U3-L2", "title": "I have: у меня есть", "learn": "Russians don't HAVE things — things are AT them! У МЕНЯ ЕСТЬ = At me there is = I have. У МЕНЯ ЕСТЬ КНИГА = I have a book. Flip your brain — it is fun!", "vocab": [{"t": "у меня", "r": "oo mih-NYAH", "en": "I have (at me)", "pos": "phrase"}, {"t": "есть", "r": "yehsty", "en": "there is", "pos": "verb"}, {"t": "хлеб", "r": "khlyehp", "en": "bread", "pos": "noun"}, {"t": "вода", "r": "vah-DAH", "en": "water", "pos": "noun"}, {"t": "дом", "r": "dohm", "en": "house", "pos": "noun"}, {"t": "книга", "r": "KNEE-gah", "en": "book", "pos": "noun"}, {"t": "друг", "r": "drook", "en": "friend", "pos": "noun"}, {"t": "деньги", "r": "DYEHNY-gee", "en": "money", "pos": "noun"}], "grammar": {"title": "У МЕНЯ ЕСТЬ = I have", "explain": "У МЕНЯ ЕСТЬ КНИГА = I have a book (at-me there-is a-book). Swap the person: У ВАС ЕСТЬ? = Do you have? У НЕГО НЕТ = He doesn't have (нет replaces есть!).", "pattern": "у меня/вас/него + есть/нет", "examples": [{"t": "У меня есть книга.", "r": "oo mih-NYAH yehsty KNEE-gah.", "en": "I have a book."}, {"t": "У вас есть вода?", "r": "oo vahs yehsty vah-DAH?", "en": "Do you have water?"}, {"t": "У него нет денег.", "r": "oo nih-VOH nyeht DYEH-nihk.", "en": "He has no money."}], "mistakes": ["Saying Я ИМЕЮ — Russians say У МЕНЯ ЕСТЬ!", "Using ЕСТЬ in negatives — НЕТ replaces it: У МЕНЯ НЕТ."]}, "dialogue": [{"sp": "Иван", "t": "У вас есть вода?", "r": "oo vahs yehsty vah-DAH?", "en": "Do you have water?"}, {"sp": "Анна", "t": "Да, у меня есть вода и хлеб.", "r": "dah, oo mih-NYAH yehsty vah-DAH ee khlyehp.", "en": "Yes, I have water and bread."}, {"sp": "Иван", "t": "Спасибо! У меня нет денег.", "r": "spah-SEE-bah! oo mih-NYAH nyeht DYEH-nihk.", "en": "Thanks! I have no money."}, {"sp": "Анна", "t": "Пожалуйста!", "r": "pah-ZHAH-loo-stah!", "en": "You're welcome!"}], "practice": [{"type": "translate_en", "q": "Say: I have a book", "answer": "У меня есть книга"}, {"type": "fill", "q": "У меня ___ денег. (no)", "answer": "нет"}, {"type": "choose", "q": "'Do you have water?' is…", "options": ["Вы хотите воду?", "У вас есть вода?", "Вы пьёте воду?", "Где вода?"], "answer": "У вас есть вода?"}, {"type": "reorder", "q": "Order: меня / есть / книга / у", "answer": "у меня есть книга"}, {"type": "speak", "q": "Say aloud: У меня есть вода и хлеб.", "answer": "У меня есть вода и хлеб."}], "quiz": [{"q": "У МЕНЯ ЕСТЬ КНИГА means…", "options": ["I want a book", "I have a book", "I read a book", "I see a book"], "answer": 1, "why": "У меня есть = I have."}, {"q": "Negatives use…", "options": ["есть", "нет", "не есть", "ни есть"], "answer": 1, "why": "У меня НЕТ = I don't have."}, {"q": "ДЕНЬГИ means…", "options": ["books", "money", "bread", "water"], "answer": 1, "why": "Деньги = money."}, {"q": "У ВАС ЕСТЬ? means…", "options": ["Are you here?", "Do you have?", "Do you want?", "Are you going?"], "answer": 1, "why": "У вас есть = you have."}, {"q": "ХЛЕБ means…", "options": ["water", "bread", "house", "friend"], "answer": 1, "why": "Хлеб = bread."}], "flashcards": "auto:vocab", "worksheet": {"title": "I have worksheet", "tasks": [{"instruction": "Translate to Russian.", "items": ["I have (at me)", "there is", "money"], "key": ["у меня", "есть", "деньги"]}, {"instruction": "Have things.", "items": ["I have a book", "Do you have water?", "He has no money"], "key": ["У меня есть книга", "У вас есть вода?", "У него нет денег"]}, {"instruction": "At the table.", "items": ["I have water and bread", "I have no money"], "key": ["У меня есть вода и хлеб", "У меня нет денег"]}]}}]}], "test": {"title": "A1 final test", "items": [{"type": "translate_en", "q": "Say: My name is Anna", "answer": "Меня зовут Анна"}, {"type": "fill", "q": "___! (hi, informal)", "answer": "Привет"}, {"type": "choose", "q": "To a teacher you say…", "options": ["Привет", "Здравствуйте", "Пока", "Да"], "answer": "Здравствуйте"}, {"type": "translate_en", "q": "Say: I speak Russian", "answer": "Я говорю по-русски"}, {"type": "translate_t", "q": "У меня есть вода.", "answer": "I have water."}, {"type": "fill", "q": "Это мама. ___ добрая. (She)", "answer": "Она"}, {"type": "reorder", "q": "Order: дела / как", "answer": "как дела"}, {"type": "speak", "q": "Say aloud: Вы говорите по-английски?", "answer": "Вы говорите по-английски?"}, {"type": "fill", "q": "У меня ___ денег. (no)", "answer": "нет"}, {"type": "choose", "q": "Они говорят громко.", "options": ["We speak loudly", "They speak loudly", "You speak loudly", "I speak loudly"], "answer": "They speak loudly"}]}}}