{"code": "es", "name": "Spanish", "native": "Español", "phase": 1, "medium": "en", "file_level": "B1", "level": {"title": "Intermediate: stories, opinions, work, plans", "goals": ["Tell stories in past tenses", "Compare things and give opinions", "Handle work talk and polite requests"], "units": [{"id": "B1-U1", "title": "Stories and opinions", "lessons": [{"id": "B1-U1-L1", "title": "Stories: pretérito vs imperfecto", "learn": "Two pasts! PRETÉRITO = finished actions (LLEGUÉ = I arrived). IMPERFECTO = ongoing scenes (HACÍA SOL = the sun was shining). Tell stories: set the scene with imperfecto, fire events with pretérito.", "vocab": [{"t": "ayer", "r": "ah-YEHR", "en": "yesterday", "pos": "adverb"}, {"t": "la semana", "r": "lah seh-MAH-nah", "en": "week", "pos": "noun"}, {"t": "el año", "r": "ehl AHN-yoh", "en": "year", "pos": "noun"}, {"t": "la vez", "r": "lah vehs", "en": "time (occasion)", "pos": "noun"}, {"t": "el cuento", "r": "ehl KWEHN-toh", "en": "story", "pos": "noun"}, {"t": "la fiesta", "r": "lah FYEHS-tah", "en": "party", "pos": "noun"}, {"t": "el regalo", "r": "ehl reh-GAH-loh", "en": "gift", "pos": "noun"}, {"t": "la sorpresa", "r": "lah sohr-PREH-sah", "en": "surprise", "pos": "noun"}], "grammar": {"title": "Pretérito vs imperfecto: hablé vs hablaba", "explain": "HABLÉ = I spoke (done). HABLABA = I was speaking / used to speak (ongoing). -AR imperfecto: HABLABA, HABLABAS, HABLABA. Weather, feelings, habits → imperfecto. Single events → pretérito.", "pattern": "pretérito (done) · imperfecto (was doing)", "examples": [{"t": "Llegué a las ocho.", "r": "yeh-GEH ah lahs OH-choh.", "en": "I arrived at eight. (done)"}, {"t": "Hacía sol.", "r": "ah-SYAH sohl.", "en": "It was sunny. (scene)"}, {"t": "Hablaba cuando llegaste.", "r": "ah-BLAH-bah KWAHN-doh yeh-GAHS-teh.", "en": "I was speaking when you arrived."}], "mistakes": ["Using pretérito for weather: HACÍA sol, not HIZO sol.", "Using imperfecto for single arrivals: LLEGUÉ, not LLEGABA."]}, "dialogue": [{"sp": "Ana", "t": "Ayer fui a una fiesta.", "r": "ah-YEHR fwee ah OO-nah FYEHS-tah.", "en": "Yesterday I went to a party."}, {"sp": "Ben", "t": "¿Cómo era?", "r": "KOH-moh EH-rah?", "en": "What was it like?"}, {"sp": "Ana", "t": "Era grande. Había música y bailamos.", "r": "EH-rah GRAHN-deh. ah-BEE-ah MOO-see-kah ee bah-ee-LAH-mohs.", "en": "It was big. There was music and we danced."}, {"sp": "Ben", "t": "¡Qué divertido!", "r": "keh dee-vehr-TEE-doh!", "en": "How fun!"}], "practice": [{"type": "translate_en", "q": "Say: It was sunny", "answer": "Hacía sol"}, {"type": "fill", "q": "Llegué a las ___ (eight)", "answer": "ocho"}, {"type": "choose", "q": "'I was speaking' is…", "options": ["hablé", "hablaba", "hablo", "hablaré"], "answer": "hablaba"}, {"type": "reorder", "q": "Order: fiesta / fui / una / a", "answer": "fui a una fiesta"}, {"type": "speak", "q": "Say aloud: Ayer fui a una fiesta.", "answer": "Ayer fui a una fiesta."}], "quiz": [{"q": "HABLÉ vs HABLABA: the difference is…", "options": ["I/you", "done vs ongoing", "loud/quiet", "past/future"], "answer": 1, "why": "Pretérito = done; imperfecto = ongoing."}, {"q": "HACÍA SOL means…", "options": ["it is sunny", "it was sunny", "it will rain", "it snowed"], "answer": 1, "why": "Imperfecto scene-setting."}, {"q": "EL REGALO is…", "options": ["party", "gift", "story", "surprise"], "answer": 1, "why": "Regalo = gift."}, {"q": "¿CÓMO ERA? means…", "options": ["How was it?", "Where was it?", "When was it?", "Who was it?"], "answer": 0, "why": "Cómo + era = what was it like."}, {"q": "Which sets a story scene?", "options": ["llegué", "hablaba", "compré", "viajé"], "answer": 1, "why": "Imperfecto paints the background."}], "flashcards": "auto:vocab", "worksheet": {"title": "Past stories worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["yesterday", "party", "gift"], "key": ["ayer", "la fiesta", "el regalo"]}, {"instruction": "Choose pretérito or imperfecto.", "items": ["I arrived (done)", "It was sunny (scene)", "I was speaking (ongoing)"], "key": ["llegué", "hacía sol", "hablaba"]}, {"instruction": "Start a story (two lines).", "items": ["Yesterday I went to …", "It was …"], "key": ["Ayer fui a …", "Era …"]}]}}, {"id": "B1-U1-L2", "title": "Opinions and comparisons", "learn": "Compare with MÁS…QUE (more…than) and MENOS…QUE (less…than). Specials: MEJOR (better), PEOR (worse). Give opinions: CREO QUE (I think that), EN MI OPINIÓN (in my opinion).", "vocab": [{"t": "mejor", "r": "meh-HOHR", "en": "better / best", "pos": "adjective"}, {"t": "peor", "r": "peh-OHR", "en": "worse / worst", "pos": "adjective"}, {"t": "mayor", "r": "mah-YOHR", "en": "older / bigger", "pos": "adjective"}, {"t": "menor", "r": "meh-NOHR", "en": "younger / smaller", "pos": "adjective"}, {"t": "mismo", "r": "MEES-moh", "en": "same", "pos": "adjective"}, {"t": "diferente", "r": "dee-feh-REHN-teh", "en": "different", "pos": "adjective"}, {"t": "la opinión", "r": "lah oh-pee-NYOHN", "en": "opinion", "pos": "noun"}, {"t": "la razón", "r": "lah rah-SOHN", "en": "reason", "pos": "noun"}], "grammar": {"title": "Comparisons: más… que, mejor, peor", "explain": "MÁS + adjective + QUE = more…than: MÁS GRANDE QUE = bigger than. EL MÁS… = the most: EL MÁS GRANDE = the biggest. MEJOR and PEOR never take MÁS — MEJOR already means better!", "pattern": "más/menos + adj + que · mejor/peor", "examples": [{"t": "Es más grande que mi casa.", "r": "ehs mahs GRAHN-deh keh mee KAH-sah.", "en": "It is bigger than my house."}, {"t": "Este libro es mejor.", "r": "EHS-teh LEE-broh ehs meh-HOHR.", "en": "This book is better."}, {"t": "Creo que es peor.", "r": "KREH-oh keh ehs peh-OHR.", "en": "I think it is worse."}], "mistakes": ["Saying MÁS MEJOR — just MEJOR (better already!).", "Forgetting QUE: MÁS GRANDE QUE, with QUE!"]}, "dialogue": [{"sp": "Ben", "t": "Creo que este café es mejor.", "r": "KREH-oh keh EHS-teh kah-FEH ehs meh-HOHR.", "en": "I think this café is better."}, {"sp": "Ana", "t": "En mi opinión, el otro es más barato.", "r": "ehn mee oh-pee-NYOHN, ehl OH-troh ehs mahs bah-RAH-toh.", "en": "In my opinion, the other one is cheaper."}, {"sp": "Ben", "t": "Tienes razón, pero este es más bonito.", "r": "TYEH-nehs rah-SOHN, PEH-roh EHS-teh ehs mahs boh-NEE-toh.", "en": "You are right, but this one is prettier."}, {"sp": "Ana", "t": "¡Vale!", "r": "BAH-leh!", "en": "Okay!"}], "practice": [{"type": "translate_en", "q": "Say: This book is better", "answer": "Este libro es mejor"}, {"type": "fill", "q": "Es más grande ___ mi casa. (than)", "answer": "que"}, {"type": "choose", "q": "'In my opinion' is…", "options": ["Creo que", "En mi opinión", "Tienes razón", "Qué divertido"], "answer": "En mi opinión"}, {"type": "reorder", "q": "Order: razón / tienes", "answer": "tienes razón"}, {"type": "speak", "q": "Say aloud: Creo que es mejor.", "answer": "Creo que es mejor."}], "quiz": [{"q": "MÁS GRANDE QUE means…", "options": ["big and good", "bigger than", "very big", "big house"], "answer": 1, "why": "Más…que = more…than."}, {"q": "Why no MÁS with MEJOR?", "options": ["it is ugly", "mejor already means better", "it is slang", "it is formal"], "answer": 1, "why": "Mejor = better, complete."}, {"q": "TIENES RAZÓN means…", "options": ["you are wrong", "you are right", "you are late", "you are lost"], "answer": 1, "why": "Tener razón = to be right."}, {"q": "EL OTRO is…", "options": ["the same", "the other one", "the best", "the shop"], "answer": 1, "why": "Otro = other."}, {"q": "CREO QUE means…", "options": ["I know that", "I think that", "I see that", "I want that"], "answer": 1, "why": "Creo que = I think that."}], "flashcards": "auto:vocab", "worksheet": {"title": "Opinions worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["better", "different", "opinion"], "key": ["mejor", "diferente", "la opinión"]}, {"instruction": "Compare (use más…que).", "items": ["My house / big / yours", "This café / cheap / that one"], "key": ["Mi casa es más grande que la tuya", "Este café es más barato que ese"]}, {"instruction": "Give your opinion.", "items": ["I think this book is better", "You are right"], "key": ["Creo que este libro es mejor", "Tienes razón"]}]}}]}, {"id": "B1-U2", "title": "Real world", "lessons": [{"id": "B1-U2-L1", "title": "Work and polite YOU (usted)", "learn": "At work, use USTED (polite you) with strangers and bosses. Usted uses HE/SHE verb forms: ¿HABLA inglés? = Do you (formal) speak English? TÚ is for friends; USTED is for respect.", "vocab": [{"t": "el trabajo", "r": "ehl trah-BAH-hoh", "en": "work / job", "pos": "noun"}, {"t": "la oficina", "r": "lah oh-fee-SEE-nah", "en": "office", "pos": "noun"}, {"t": "el jefe", "r": "ehl HEH-feh", "en": "boss", "pos": "noun"}, {"t": "la reunión", "r": "lah reh-oo-NYOHN", "en": "meeting", "pos": "noun"}, {"t": "el correo", "r": "ehl koh-RREH-oh", "en": "mail / email", "pos": "noun"}, {"t": "el proyecto", "r": "ehl proh-YEHK-toh", "en": "project", "pos": "noun"}, {"t": "el cliente", "r": "ehl klee-EHN-teh", "en": "client", "pos": "noun"}, {"t": "el horario", "r": "ehl oh-RAH-ryoh", "en": "schedule", "pos": "noun"}], "grammar": {"title": "USTED: polite you uses he/she forms", "explain": "¿HABLAS? (tú, friend) vs ¿HABLA? (usted, formal). Same -A ending as HE/SHE. Use usted with bosses, elders, officials. Dropping it too fast can sound rude!", "pattern": "usted + he/she verb form", "examples": [{"t": "¿Habla inglés?", "r": "AH-blah een-GLEHS?", "en": "Do you (formal) speak English?"}, {"t": "¿Cómo está usted?", "r": "KOH-moh ehs-TAH oos-TEHD?", "en": "How are you? (formal)"}, {"t": "Usted tiene razón.", "r": "oos-TEHD TYEH-neh rah-SOHN.", "en": "You (formal) are right."}], "mistakes": ["Using TÚ with a new boss — start with USTED.", "Using HABLAS with usted — usted takes HABLA."]}, "dialogue": [{"sp": "Ben", "t": "Buenos días. ¿Cómo está usted?", "r": "BWEH-nohs DEE-ahs. KOH-moh ehs-TAH oos-TEHD?", "en": "Good morning. How are you? (formal)"}, {"sp": "Ana", "t": "Muy bien, gracias. ¿Y usted?", "r": "mwee byehn, GRAH-syahs. ee oos-TEHD?", "en": "Very well, thanks. And you?"}, {"sp": "Ben", "t": "Bien. ¿A qué hora es la reunión?", "r": "byehn. ah keh OH-rah ehs lah reh-oo-NYOHN?", "en": "Fine. What time is the meeting?"}, {"sp": "Ana", "t": "A las diez, en la oficina.", "r": "ah lahs dyehs, ehn lah oh-fee-SEE-nah.", "en": "At ten, in the office."}], "practice": [{"type": "translate_en", "q": "Say (formal): Do you speak English?", "answer": "¿Habla inglés?"}, {"type": "fill", "q": "¿Cómo está ___? (formal you)", "answer": "usted"}, {"type": "choose", "q": "To a new boss you use…", "options": ["tú", "usted", "vosotros", "él"], "answer": "usted"}, {"type": "reorder", "q": "Order: está / cómo / usted", "answer": "cómo está usted"}, {"type": "speak", "q": "Say aloud: ¿Cómo está usted?", "answer": "¿Cómo está usted?"}], "quiz": [{"q": "USTED takes which verb form?", "options": ["I-form", "you-friendly-form", "he/she-form", "they-form"], "answer": 2, "why": "Usted + habla/está/tiene."}, {"q": "EL JEFE is…", "options": ["office", "boss", "client", "mail"], "answer": 1, "why": "Jefe = boss."}, {"q": "¿HABLA INGLÉS? (formal) means…", "options": ["He speaks English", "Do you speak English?", "She likes English", "Speak English!"], "answer": 1, "why": "With usted understood: formal you."}, {"q": "LA REUNIÓN is…", "options": ["office", "project", "meeting", "schedule"], "answer": 2, "why": "Reunión = meeting."}, {"q": "Start with USTED when talking to…", "options": ["your best friend", "your little brother", "a new client", "your dog"], "answer": 2, "why": "Respect first, tú later."}], "flashcards": "auto:vocab", "worksheet": {"title": "Work worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["office", "boss", "meeting"], "key": ["la oficina", "el jefe", "la reunión"]}, {"instruction": "Make it formal (usted).", "items": ["Do you speak English?", "How are you?", "You are right."], "key": ["¿Habla inglés?", "¿Cómo está usted?", "Usted tiene razón"]}, {"instruction": "Ask about the meeting.", "items": ["What time is the meeting?", "At ten, in the office"], "key": ["¿A qué hora es la reunión?", "A las diez, en la oficina"]}]}}, {"id": "B1-U2-L2", "title": "Plans and wishes", "learn": "Dream big! QUISIERA (I would like) + verb makes soft wishes: QUISIERA VIAJAR = I would like to travel. QUIZÁ (maybe) + future guesses: QUIZÁ VIAJARÉ = maybe I will travel. OJALÁ (hopefully!) opens every dream.", "vocab": [{"t": "el futuro", "r": "ehl foo-TOO-roh", "en": "future", "pos": "noun"}, {"t": "el sueño", "r": "ehl SWEH-nyoh", "en": "dream", "pos": "noun"}, {"t": "el deseo", "r": "ehl deh-SEH-oh", "en": "wish", "pos": "noun"}, {"t": "el plan", "r": "ehl plahn", "en": "plan", "pos": "noun"}, {"t": "el viaje", "r": "ehl VYAH-heh", "en": "trip", "pos": "noun"}, {"t": "la suerte", "r": "lah SWEHR-teh", "en": "luck", "pos": "noun"}, {"t": "ojalá", "r": "oh-hah-LAH", "en": "hopefully!", "pos": "particle"}, {"t": "quizá", "r": "kee-SAH", "en": "maybe", "pos": "adverb"}], "grammar": {"title": "Soft wishes: quisiera + verb", "explain": "QUISIERA = I would like. Add any verb whole: QUISIERA APRENDER = I would like to learn. QUIZÁ (maybe) softens guesses. These two words make you sound kind and natural.", "pattern": "quisiera + verb · quizá + …", "examples": [{"t": "Quisiera viajar.", "r": "kee-SYEH-rah vyah-HAHR.", "en": "I would like to travel."}, {"t": "Quizá viajo en verano.", "r": "kee-SAH VYAH-hoh ehn veh-RAH-noh.", "en": "Maybe I travel in summer."}, {"t": "¡Ojalá!", "r": "oh-hah-LAH!", "en": "Hopefully! / Let's hope so!"}], "mistakes": ["Changing the verb after QUISIERA: QUISIERA VIAJAR, verb stays whole.", "Saying QUIERO for soft wishes — QUISIERA is kinder."]}, "dialogue": [{"sp": "Ana", "t": "¿Cuáles son tus planes?", "r": "KWAH-lehs sohn toos PLAH-nehs?", "en": "What are your plans?"}, {"sp": "Ben", "t": "Quisiera viajar a España.", "r": "kee-SYEH-rah vyah-HAHR ah ehs-PAHN-yah.", "en": "I would like to travel to Spain."}, {"sp": "Ana", "t": "¡Ojalá! Quizá vamos juntos.", "r": "oh-hah-LAH! kee-SAH VAH-mohs HOON-tohs.", "en": "Hopefully! Maybe we go together."}, {"sp": "Ben", "t": "¡Buena suerte!", "r": "BWEH-nah SWEHR-teh!", "en": "Good luck!"}], "practice": [{"type": "translate_en", "q": "Say: I would like to travel", "answer": "Quisiera viajar"}, {"type": "fill", "q": "___! (Hopefully!)", "answer": "¡Ojalá!"}, {"type": "choose", "q": "'Maybe we go together' uses…", "options": ["ojalá", "quizá", "quisiera", "quiero"], "answer": "quizá"}, {"type": "reorder", "q": "Order: viajar / quisiera / a / España", "answer": "quisiera viajar a España"}, {"type": "speak", "q": "Say aloud: Quisiera viajar a España.", "answer": "Quisiera viajar a España."}], "quiz": [{"q": "QUISIERA VIAJAR means…", "options": ["I travel now", "I would like to travel", "I travelled", "I must travel"], "answer": 1, "why": "Quisiera + verb = soft wish."}, {"q": "OJALÁ means…", "options": ["maybe", "hopefully!", "goodbye", "never"], "answer": 1, "why": "Ojalá opens dreams."}, {"q": "EL SUEÑO is…", "options": ["plan", "dream", "luck", "trip"], "answer": 1, "why": "Sueño = dream."}, {"q": "After QUISIERA the verb…", "options": ["changes endings", "stays whole", "disappears", "repeats"], "answer": 1, "why": "Quisiera VIAJAR — whole infinitive."}, {"q": "¡BUENA SUERTE! means…", "options": ["Have fun!", "Good luck!", "Well done!", "See you!"], "answer": 1, "why": "Buena suerte = good luck."}], "flashcards": "auto:vocab", "worksheet": {"title": "Plans worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["dream", "luck", "hopefully"], "key": ["el sueño", "la suerte", "ojalá"]}, {"instruction": "Make soft wishes.", "items": ["I would like to learn", "I would like to travel"], "key": ["Quisiera aprender", "Quisiera viajar"]}, {"instruction": "Talk about plans.", "items": ["What are your plans?", "Good luck!"], "key": ["¿Cuáles son tus planes?", "¡Buena suerte!"]}]}}]}, {"id": "B1-U3", "title": "Plans and media", "lessons": [{"id": "B1-U3-L1", "title": "Future tense: viajaré", "learn": "The real future adds endings to the WHOLE verb: VIAJAR → VIAJARÉ (I will travel), VIAJARÁS (you will), VIAJARÁ (he/she will). Never changes the stem — just add -É/-ÁS/-Á!", "vocab": [{"t": "viajar", "r": "vyah-HAHR", "en": "to travel", "pos": "verb"}, {"t": "estudiar", "r": "ehs-too-DYAHR", "en": "to study", "pos": "verb"}, {"t": "trabajar", "r": "trah-bah-HAHR", "en": "to work", "pos": "verb"}, {"t": "aprender", "r": "ah-prehn-DEHR", "en": "to learn", "pos": "verb"}, {"t": "ahorrar", "r": "ah-oh-RRAHR", "en": "to save (money)", "pos": "verb"}, {"t": "mudarse", "r": "moo-DAHR-seh", "en": "to move house", "pos": "verb"}, {"t": "pronto", "r": "PROHN-toh", "en": "soon", "pos": "adverb"}, {"t": "el año próximo", "r": "ehl AHN-yoh PROHK-see-moh", "en": "next year", "pos": "noun"}], "grammar": {"title": "Future: whole verb + é/ás/á", "explain": "Keep the infinitive, add -É, -ÁS, -Á: HABLARÉ, COMERÉ, VIVIRÉ. Works for -AR, -ER, -IR — all the same! A few rebels (TENDRÉ, HARÉ) come later.", "pattern": "infinitive + é/ás/á", "examples": [{"t": "Viajaré pronto.", "r": "vyah-hah-REH PROHN-toh.", "en": "I will travel soon."}, {"t": "¿Estudiarás español?", "r": "ehs-too-dyah-RAHS ehs-pahn-YOHL?", "en": "Will you study Spanish?"}, {"t": "Aprenderá rápido.", "r": "ah-prehn-deh-RAH RRAH-pee-doh.", "en": "He/She will learn fast."}], "mistakes": ["Cutting the verb: VIAJARÉ keeps -AR + É — never VIAJÉ for future!", "Confusing VIAJÉ (past I) with VIAJARÉ (future I)."]}, "dialogue": [{"sp": "Ben", "t": "¿Qué harás el año próximo?", "r": "keh ah-RAHS ehl AHN-yoh PROHK-see-moh?", "en": "What will you do next year?"}, {"sp": "Ana", "t": "Viajaré a España y estudiaré español.", "r": "vyah-hah-REH ah ehs-PAHN-yah ee ehs-too-dyah-REH ehs-pahn-YOHL.", "en": "I will travel to Spain and study Spanish."}, {"sp": "Ben", "t": "¡Aprenderás rápido!", "r": "ah-prehn-deh-RAHS RRAH-pee-doh!", "en": "You will learn fast!"}, {"sp": "Ana", "t": "¡Ojalá!", "r": "oh-hah-LAH!", "en": "Hopefully!"}], "practice": [{"type": "translate_en", "q": "Say: I will travel soon", "answer": "Viajaré pronto"}, {"type": "fill", "q": "¿Estudiarás ___? (Spanish)", "answer": "español"}, {"type": "choose", "q": "'He will learn fast' is…", "options": ["Aprende rápido", "Aprenderá rápido", "Aprendió rápido", "Aprendía rápido"], "answer": "Aprenderá rápido"}, {"type": "reorder", "q": "Order: viajaré / España / a", "answer": "viajaré a España"}, {"type": "speak", "q": "Say aloud: Viajaré a España.", "answer": "Viajaré a España."}], "quiz": [{"q": "VIAJARÉ means…", "options": ["I travel", "I travelled", "I will travel", "I want travel"], "answer": 2, "why": "-AR + É = future I."}, {"q": "Future endings attach to…", "options": ["the stem", "the whole infinitive", "nothing", "the subject"], "answer": 1, "why": "VIAJAR + É — whole verb."}, {"q": "EL AÑO PRÓXIMO is…", "options": ["last year", "next year", "this year", "every year"], "answer": 1, "why": "Próximo = next."}, {"q": "VIAJÉ vs VIAJARÉ: the difference is…", "options": ["I vs you", "past vs future", "loud vs quiet", "Spain vs Mexico"], "answer": 1, "why": "ViajÉ = travelled; viajarÉ = will travel."}, {"q": "APRENDER means…", "options": ["to teach", "to learn", "to study", "to forget"], "answer": 1, "why": "Aprender = to learn."}], "flashcards": "auto:vocab", "worksheet": {"title": "Future worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["to travel", "to learn", "soon"], "key": ["viajar", "aprender", "pronto"]}, {"instruction": "Put VIAJAR in the future.", "items": ["I will travel", "you will travel", "she will travel"], "key": ["viajaré", "viajarás", "viajará"]}, {"instruction": "Talk next year.", "items": ["What will you do next year?", "I will travel to Spain"], "key": ["¿Qué harás el año próximo?", "Viajaré a España"]}]}}, {"id": "B1-U3-L2", "title": "TV, news, and LO/LA (it)", "learn": "Replace things with LO (him/it-masculine) and LA (her/it-feminine): VEO LA PELÍCULA → LA VEO (I see it). LO/LA jump BEFORE the verb. News words: NOTICIAS, PROGRAMA, PELÍCULA.", "vocab": [{"t": "las noticias", "r": "lahs noh-TEE-syahs", "en": "news", "pos": "noun"}, {"t": "el programa", "r": "ehl proh-GRAH-mah", "en": "TV show", "pos": "noun"}, {"t": "la película", "r": "lah peh-LEE-koo-lah", "en": "film", "pos": "noun"}, {"t": "la serie", "r": "lah SEH-ryeh", "en": "series", "pos": "noun"}, {"t": "el canal", "r": "ehl kah-NAHL", "en": "channel", "pos": "noun"}, {"t": "el anuncio", "r": "ehl ah-NOON-syoh", "en": "advert", "pos": "noun"}, {"t": "el actor", "r": "ehl ahk-TOHR", "en": "actor", "pos": "noun"}, {"t": "la pantalla", "r": "lah pahn-TAH-yah", "en": "screen", "pos": "noun"}], "grammar": {"title": "LO/LA: it jumps before the verb", "explain": "Veo el programa → LO veo (I see it). Veo la película → LA veo. LO = masculine IT, LA = feminine IT. Always before the verb: LO sé = I know it.", "pattern": "lo/la + verb", "examples": [{"t": "La veo cada día.", "r": "lah BEH-oh KAH-dah DEE-ah.", "en": "I see it (the series) every day."}, {"t": "¿Lo sabes?", "r": "loh SAH-behs?", "en": "Do you know it?"}, {"t": "No lo entiendo.", "r": "noh loh ehn-TYEHN-doh.", "en": "I don't understand it."}], "mistakes": ["Saying VEO LO — LO must jump before: LO veo.", "Using LO for feminine things: LA película → LA veo."]}, "dialogue": [{"sp": "Ana", "t": "¿Ves las noticias?", "r": "vehs lahs noh-TEE-syahs?", "en": "Do you watch the news?"}, {"sp": "Ben", "t": "Sí, las veo cada noche.", "r": "see, lahs BEH-oh KAH-dah NOH-cheh.", "en": "Yes, I watch them every night."}, {"sp": "Ana", "t": "¿Te gusta la serie nueva?", "r": "teh GOOS-tah lah SEH-ryeh NWEH-vah?", "en": "Do you like the new series?"}, {"sp": "Ben", "t": "Sí, la veo los viernes.", "r": "see, lah BEH-oh lohs VYEHR-nehs.", "en": "Yes, I watch it on Fridays."}], "practice": [{"type": "translate_en", "q": "Say: I see it (the film)", "answer": "La veo"}, {"type": "fill", "q": "¿___ sabes? (it)", "answer": "Lo"}, {"type": "choose", "q": "'I watch them (news) every night' is…", "options": ["Veo las cada noche", "Las veo cada noche", "Lo veo cada noche", "Veo lo cada noche"], "answer": "Las veo cada noche"}, {"type": "reorder", "q": "Order: veo / la / viernes / los", "answer": "la veo los viernes"}, {"type": "speak", "q": "Say aloud: Las veo cada noche.", "answer": "Las veo cada noche."}], "quiz": [{"q": "LA VEO means…", "options": ["I see her/it", "she sees me", "we see it", "they see us"], "answer": 0, "why": "La + veo = I see it (f)."}, {"q": "LA PELÍCULA is…", "options": ["show", "film", "news", "advert"], "answer": 1, "why": "Película = film."}, {"q": "LO/LA go…", "options": ["after the verb", "before the verb", "at sentence end", "nowhere"], "answer": 1, "why": "Lo sé, la veo — before!"}, {"q": "LAS NOTICIAS are…", "options": ["films", "news", "series", "adverts"], "answer": 1, "why": "Noticias = news."}, {"q": "NO LO ENTIENDO means…", "options": ["I know it", "I don't understand it", "I see it", "I want it"], "answer": 1, "why": "No + lo + entiendo."}], "flashcards": "auto:vocab", "worksheet": {"title": "Media worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["news", "film", "screen"], "key": ["las noticias", "la película", "la pantalla"]}, {"instruction": "Replace with lo/la.", "items": ["Veo el programa → …", "Veo la serie → …", "¿Sabes la respuesta? → ¿…?"], "key": ["Lo veo", "La veo", "¿La sabes?"]}, {"instruction": "TV habits.", "items": ["Do you watch the news?", "Yes, I watch them every night"], "key": ["¿Ves las noticias?", "Sí, las veo cada noche"]}]}}]}], "test": {"title": "B1 final test", "items": [{"type": "translate_en", "q": "Say: It was sunny", "answer": "Hacía sol"}, {"type": "fill", "q": "Este libro es ___ (better)", "answer": "mejor"}, {"type": "choose", "q": "Formal 'Do you speak English?'", "options": ["¿Hablas inglés?", "¿Habla inglés?", "¿Hablo inglés?", "¿Hablan inglés?"], "answer": "¿Habla inglés?"}, {"type": "translate_en", "q": "Say: I would like to travel", "answer": "Quisiera viajar"}, {"type": "translate_t", "q": "Tienes razón.", "answer": "You are right."}, {"type": "fill", "q": "Es más grande ___ mi casa (than)", "answer": "que"}, {"type": "reorder", "q": "Order: sol / hacía", "answer": "hacía sol"}, {"type": "speak", "q": "Say aloud: Quisiera viajar a España.", "answer": "Quisiera viajar a España."}, {"type": "translate_en", "q": "Say: I will travel soon", "answer": "Viajaré pronto"}, {"type": "fill", "q": "___ veo cada noche. (them - news)", "answer": "Las"}]}}}