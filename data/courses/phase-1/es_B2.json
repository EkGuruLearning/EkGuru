{"code": "es", "name": "Spanish", "native": "Español", "phase": 1, "medium": "en", "file_level": "B2", "level": {"title": "Upper intermediate: debate, work, culture", "goals": ["Argue opinions with the subjunctive", "Write formal emails and handle meetings", "Understand idioms and tell rich stories"], "units": [{"id": "B2-U1", "title": "Opinion and debate", "lessons": [{"id": "B2-U1-L1", "title": "Wishes need subjunctive (quiero que…)", "learn": "After wishes and wants, Spanish switches mood: QUIERO QUE HABLES (I want you to speak). HABLES is SUBJUNCTIVE — for wishes, not facts. Pattern: QUIERO QUE + …ES.", "vocab": [{"t": "el deseo", "r": "ehl deh-SEH-oh", "en": "wish", "pos": "noun"}, {"t": "la esperanza", "r": "lah ehs-peh-RAHN-sah", "en": "hope", "pos": "noun"}, {"t": "la duda", "r": "lah DOO-dah", "en": "doubt", "pos": "noun"}, {"t": "el consejo", "r": "ehl kohn-SEH-hoh", "en": "advice", "pos": "noun"}, {"t": "el permiso", "r": "ehl pehr-MEE-soh", "en": "permission", "pos": "noun"}, {"t": "la propuesta", "r": "lah proh-PWEHS-tah", "en": "proposal", "pos": "noun"}, {"t": "la solución", "r": "lah soh-loo-SYOHN", "en": "solution", "pos": "noun"}, {"t": "el acuerdo", "r": "ehl ah-KWEHR-doh", "en": "agreement", "pos": "noun"}], "grammar": {"title": "Subjunctive after QUIERO QUE: hables", "explain": "QUIERO QUE + subjunctive: HABLAS (you speak, fact) → HABLES (wish). For -AR verbs: swap A→E: habla→hable, hablas→hables. Wishes live in the E-world!", "pattern": "quiero que + subjunctive (…e/…es)", "examples": [{"t": "Quiero que hables.", "r": "KYEH-roh keh AH-blehs.", "en": "I want you to speak."}, {"t": "Quiero que venga.", "r": "KYEH-roh keh BEHN-gah.", "en": "I want him/her to come."}, {"t": "Espero que llueva.", "r": "ehs-PEH-roh keh YWEH-vah.", "en": "I hope it rains."}], "mistakes": ["Saying QUIERO QUE HABLAS — wishes need HABLES (E, not A).", "Using subjunctive for facts: VEO que hablas (fact, no switch)."]}, "dialogue": [{"sp": "Ben", "t": "Quiero que me ayudes.", "r": "KYEH-roh keh meh ah-YOO-dehs.", "en": "I want you to help me."}, {"sp": "Ana", "t": "¿Qué quieres que haga?", "r": "keh KYEH-rehs keh AH-gah?", "en": "What do you want me to do?"}, {"sp": "Ben", "t": "Quiero que hables con el jefe.", "r": "KYEH-roh keh AH-blehs kohn ehl HEH-feh.", "en": "I want you to talk to the boss."}, {"sp": "Ana", "t": "De acuerdo.", "r": "deh ah-KWEHR-doh.", "en": "Agreed."}], "practice": [{"type": "translate_en", "q": "Say: I want you to speak", "answer": "Quiero que hables"}, {"type": "fill", "q": "Quiero que ___ (he comes)", "answer": "venga"}, {"type": "choose", "q": "'What do you want me to do?' is…", "options": ["¿Qué quieres que hago?", "¿Qué quieres que haga?", "¿Qué quiero que hagas?", "¿Qué haces?"], "answer": "¿Qué quieres que haga?"}, {"type": "reorder", "q": "Order: hables / quiero / que", "answer": "quiero que hables"}, {"type": "speak", "q": "Say aloud: Quiero que me ayudes.", "answer": "Quiero que me ayudes."}], "quiz": [{"q": "QUIERO QUE HABLES means…", "options": ["I speak gladly", "I want you to speak", "you want me to speak", "we speak"], "answer": 1, "why": "Quiero que + subjunctive wish."}, {"q": "HABLAS → HABLES: the switch is…", "options": ["past tense", "subjunctive mood", "plural", "formal"], "answer": 1, "why": "Wishes use E-endings."}, {"q": "EL CONSEJO is…", "options": ["wish", "advice", "doubt", "hope"], "answer": 1, "why": "Consejo = advice."}, {"q": "ESPERO QUE LLUEVA means…", "options": ["I see rain", "I hope it rains", "it rained", "no rain"], "answer": 1, "why": "Espero que + subjunctive."}, {"q": "Subjunctive is used for…", "options": ["facts", "wishes and hopes", "past trips", "numbers"], "answer": 1, "why": "Wishes, not facts!"}], "flashcards": "auto:vocab", "worksheet": {"title": "Wishes worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["wish", "hope", "agreement"], "key": ["el deseo", "la esperanza", "el acuerdo"]}, {"instruction": "Switch to subjunctive wishes.", "items": ["I want you to speak", "I want him to come", "I hope it rains"], "key": ["Quiero que hables", "Quiero que venga", "Espero que llueva"]}, {"instruction": "Ask for help.", "items": ["I want you to help me", "Agreed"], "key": ["Quiero que me ayudes", "De acuerdo"]}]}}, {"id": "B2-U1-L2", "title": "News and reported speech", "learn": "Report what others say: DICE QUE VIENE (he says he is coming). DICE QUE + normal sentence. For past reports: DIJO QUE VINO (he said he came). News verbs: INFORMAR, ANUNCIAR, CONFIRMAR.", "vocab": [{"t": "el periódico", "r": "ehl peh-RYOH-dee-koh", "en": "newspaper", "pos": "noun"}, {"t": "el titular", "r": "ehl tee-too-LAHR", "en": "headline", "pos": "noun"}, {"t": "la entrevista", "r": "lah ehn-treh-VEES-tah", "en": "interview", "pos": "noun"}, {"t": "el reportero", "r": "ehl reh-pohr-TEH-roh", "en": "reporter", "pos": "noun"}, {"t": "el hecho", "r": "ehl EH-choh", "en": "fact", "pos": "noun"}, {"t": "la fuente", "r": "lah FWEHN-teh", "en": "source", "pos": "noun"}, {"t": "la verdad", "r": "lah vehr-DAHD", "en": "truth", "pos": "noun"}, {"t": "la mentira", "r": "lah mehn-TEE-rah", "en": "lie", "pos": "noun"}], "grammar": {"title": "Reported speech: dice/dijo que…", "explain": "DICE QUE + sentence (he says that…). Past: DIJO QUE + past (he said that…). The rest of the sentence stays normal — only the intro verb moves in time.", "pattern": "dice que + present · dijo que + past", "examples": [{"t": "Dice que viene.", "r": "DEE-seh keh VYEH-neh.", "en": "He says he is coming."}, {"t": "Dijo que vino.", "r": "DEE-hoh keh VEE-noh.", "en": "He said he came."}, {"t": "El periódico dice que llueve.", "r": "ehl peh-RYOH-dee-koh DEE-seh keh YWEH-veh.", "en": "The paper says it is raining."}], "mistakes": ["Moving the whole sentence to past: DIJO QUE VINO (only dijo moves back).", "Forgetting QUE: DICE QUE viene, with QUE!"]}, "dialogue": [{"sp": "Ana", "t": "¿Qué dice el periódico?", "r": "keh DEE-seh ehl peh-RYOH-dee-koh?", "en": "What does the paper say?"}, {"sp": "Ben", "t": "Dice que viene una tormenta.", "r": "DEE-seh keh VYEH-neh OO-nah tohr-MEHN-tah.", "en": "It says a storm is coming."}, {"sp": "Ana", "t": "¿Dijo que es grave?", "r": "DEE-hoh keh ehs GRAH-veh?", "en": "Did it say it is serious?"}, {"sp": "Ben", "t": "No, dijo que es leve.", "r": "noh, DEE-hoh keh ehs LEH-veh.", "en": "No, it said it is mild."}], "practice": [{"type": "translate_en", "q": "Say: He says he is coming", "answer": "Dice que viene"}, {"type": "fill", "q": "Dijo que ___ (he came)", "answer": "vino"}, {"type": "choose", "q": "'The paper says it is raining' is…", "options": ["El periódico dice que llueve", "El periódico dijo que llueve", "El periódico dice llover", "Dice el periódico lluvia"], "answer": "El periódico dice que llueve"}, {"type": "reorder", "q": "Order: que / dice / viene", "answer": "dice que viene"}, {"type": "speak", "q": "Say aloud: Dice que viene una tormenta.", "answer": "Dice que viene una tormenta."}], "quiz": [{"q": "DIJO QUE VINO means…", "options": ["he says he comes", "he said he came", "he will come", "he comes daily"], "answer": 1, "why": "Dijo (past) + vino (past)."}, {"q": "EL TITULAR is…", "options": ["article", "headline", "reporter", "source"], "answer": 1, "why": "Titular = headline."}, {"q": "In DIJO QUE VINO, what moved to past?", "options": ["the whole sentence", "only dijo", "only vino", "nothing"], "answer": 1, "why": "Intro verb sets the time."}, {"q": "LA FUENTE is…", "options": ["fact", "source", "truth", "lie"], "answer": 1, "why": "Fuente = source."}, {"q": "DICE QUE needs…", "options": ["no QUE", "QUE + sentence", "past tense", "plural"], "answer": 1, "why": "Dice QUE viene."}], "flashcards": "auto:vocab", "worksheet": {"title": "News worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["newspaper", "headline", "truth"], "key": ["el periódico", "el titular", "la verdad"]}, {"instruction": "Report it.", "items": ["He says he is coming", "He said he came", "The paper says it rains"], "key": ["Dice que viene", "Dijo que vino", "El periódico dice que llueve"]}, {"instruction": "Ask about news.", "items": ["What does the paper say?", "It says a storm is coming"], "key": ["¿Qué dice el periódico?", "Dice que viene una tormenta"]}]}}]}, {"id": "B2-U2", "title": "Work and formal writing", "lessons": [{"id": "B2-U2-L1", "title": "Polite requests (conditional)", "learn": "Sound professional: ME GUSTARÍA (I would like), PODRÍA (could you…?). Conditional adds -ÍA to the whole verb: HABLARÍA, COMERÍA. ¿PODRÍA AYUDARME? = Could you help me?", "vocab": [{"t": "el correo", "r": "ehl koh-RREH-oh", "en": "email", "pos": "noun"}, {"t": "el adjunto", "r": "ehl ahd-HOON-toh", "en": "attachment", "pos": "noun"}, {"t": "la firma", "r": "lah FEER-mah", "en": "signature", "pos": "noun"}, {"t": "el asunto", "r": "ehl ah-SOON-toh", "en": "subject (line)", "pos": "noun"}, {"t": "el plazo", "r": "ehl PLAH-soh", "en": "deadline", "pos": "noun"}, {"t": "el presupuesto", "r": "ehl preh-soo-PWEHS-toh", "en": "budget", "pos": "noun"}, {"t": "la factura", "r": "lah fahk-TOO-rah", "en": "invoice", "pos": "noun"}, {"t": "atentamente", "r": "ah-tehn-tah-MEHN-teh", "en": "sincerely", "pos": "adverb"}], "grammar": {"title": "Conditional: whole verb + ía", "explain": "HABLARÍA (I would speak), PODRÍA (I/he could), GUSTARÍA (would like). Same for all verbs — add -ÍA/-ÍAS/-ÍA to the infinitive. ME GUSTARÍA + verb = I would like to…", "pattern": "infinitive + ía/ías/ía", "examples": [{"t": "Me gustaría hablar.", "r": "meh goos-tah-REE-ah ah-BLAHR.", "en": "I would like to speak."}, {"t": "¿Podría ayudarme?", "r": "poh-DREE-ah ah-yoo-DAHR-meh?", "en": "Could you help me?"}, {"t": "Sería perfecto.", "r": "seh-REE-ah pehr-FEHK-toh.", "en": "It would be perfect."}], "mistakes": ["Cutting the verb: HABLARÍA keeps -AR + ÍA.", "Using QUIERO with strangers — GUSTARÍA is softer."]}, "dialogue": [{"sp": "Ben", "t": "Buenos días, me gustaría hablar con Ana.", "r": "BWEH-nohs DEE-ahs, meh goos-tah-REE-ah ah-BLAHR kohn AH-nah.", "en": "Good morning, I would like to speak with Ana."}, {"sp": "Ana", "t": "¿Podría decirme su nombre?", "r": "poh-DREE-ah deh-SEER-meh soo NOHM-breh?", "en": "Could you tell me your name?"}, {"sp": "Ben", "t": "Soy Ben. ¿Sería posible mañana?", "r": "soy behn. seh-REE-ah poh-SEE-bleh mahn-YAH-nah?", "en": "I am Ben. Would tomorrow be possible?"}, {"sp": "Ana", "t": "Sí, atentamente.", "r": "see, ah-tehn-tah-MEHN-teh.", "en": "Yes, sincerely. (closing)"}], "practice": [{"type": "translate_en", "q": "Say: I would like to speak", "answer": "Me gustaría hablar"}, {"type": "fill", "q": "¿___ ayudarme? (could you)", "answer": "Podría"}, {"type": "choose", "q": "'Would tomorrow be possible?' is…", "options": ["¿Es mañana posible?", "¿Sería posible mañana?", "¿Será mañana?", "¿Era posible?"], "answer": "¿Sería posible mañana?"}, {"type": "reorder", "q": "Order: gustaría / me / hablar", "answer": "me gustaría hablar"}, {"type": "speak", "q": "Say aloud: ¿Podría ayudarme?", "answer": "¿Podría ayudarme?"}], "quiz": [{"q": "ME GUSTARÍA HABLAR means…", "options": ["I like talking", "I would like to speak", "I talked", "I must talk"], "answer": 1, "why": "Gustaría = would like."}, {"q": "EL PLAZO is…", "options": ["budget", "deadline", "invoice", "mail"], "answer": 1, "why": "Plazo = deadline."}, {"q": "Conditional endings attach to…", "options": ["the stem", "the whole infinitive", "the subject", "nothing"], "answer": 1, "why": "HABLAR + ÍA."}, {"q": "ATENTAMENTE closes…", "options": ["a phone call", "a formal email", "a party", "a book"], "answer": 1, "why": "Atentamente = sincerely."}, {"q": "¿PODRÍA AYUDARME? means…", "options": ["Help!", "Could you help me?", "I help you", "He helps"], "answer": 1, "why": "Podría = could (soft)."}], "flashcards": "auto:vocab", "worksheet": {"title": "Email worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["attachment", "deadline", "sincerely"], "key": ["el adjunto", "el plazo", "atentamente"]}, {"instruction": "Make it polite (conditional).", "items": ["I would like to speak", "Could you help me?", "It would be perfect"], "key": ["Me gustaría hablar", "¿Podría ayudarme?", "Sería perfecto"]}, {"instruction": "Open a formal call.", "items": ["Good morning, I would like to speak with Ana", "Could you tell me your name?"], "key": ["Buenos días, me gustaría hablar con Ana", "¿Podría decirme su nombre?"]}]}}, {"id": "B2-U2-L2", "title": "POR vs PARA (for)", "learn": "Two FORS! PARA = purpose/destination (PARA TI = for you, PARA MADRID = to Madrid). POR = cause/price/exchange (POR LA LLUVIA = because of rain, POR 10 EUROS = for 10 euros).", "vocab": [{"t": "el regalo", "r": "ehl reh-GAH-loh", "en": "gift", "pos": "noun"}, {"t": "el motivo", "r": "ehl moh-TEE-voh", "en": "motive", "pos": "noun"}, {"t": "la causa", "r": "lah KAH-oo-sah", "en": "cause", "pos": "noun"}, {"t": "el destino", "r": "ehl dehs-TEE-noh", "en": "destination", "pos": "noun"}, {"t": "el camino", "r": "ehl kah-MEE-noh", "en": "way / road", "pos": "noun"}, {"t": "el medio", "r": "ehl MEH-dyoh", "en": "means / middle", "pos": "noun"}, {"t": "el favor", "r": "ehl fah-VOHR", "en": "favour", "pos": "noun"}, {"t": "el cambio", "r": "ehl KAHM-byoh", "en": "change", "pos": "noun"}], "grammar": {"title": "PARA = purpose · POR = cause", "explain": "PARA answers WHAT FOR / WHERE TO: ESTUDIO PARA APRENDER (I study to learn). POR answers WHY / HOW MUCH / THROUGH: POR LA MAÑANA (in the morning), POR FAVOR (please!).", "pattern": "para + purpose · por + cause/price", "examples": [{"t": "Este regalo es para ti.", "r": "EHS-teh reh-GAH-loh ehs PAH-rah tee.", "en": "This gift is for you."}, {"t": "Lo compré por diez euros.", "r": "loh kohm-PREH pohr dyehs eh-OO-rohs.", "en": "I bought it for ten euros."}, {"t": "Paseamos por el parque.", "r": "pah-seh-AH-mohs pohr ehl PAHR-keh.", "en": "We walk through the park."}], "mistakes": ["Saying POR TI for a gift — gifts are PARA ti.", "Saying PARA LA LLUVIA for cause — because of = POR."]}, "dialogue": [{"sp": "Ana", "t": "Este regalo es para ti.", "r": "EHS-teh reh-GAH-loh ehs PAH-rah tee.", "en": "This gift is for you."}, {"sp": "Ben", "t": "¡Gracias! ¿Por qué?", "r": "GRAH-syahs! pohr keh?", "en": "Thanks! Why?"}, {"sp": "Ana", "t": "Por tu ayuda. Lo compré por poco dinero.", "r": "pohr too ah-YOO-dah. loh kohm-PREH pohr POH-koh dee-NEH-roh.", "en": "For your help. I bought it for little money."}, {"sp": "Ben", "t": "¡Eres muy amable!", "r": "EH-rehs mwee ah-MAH-bleh!", "en": "You are very kind!"}], "practice": [{"type": "translate_en", "q": "Say: This gift is for you", "answer": "Este regalo es para ti"}, {"type": "fill", "q": "Lo compré ___ diez euros. (for)", "answer": "por"}, {"type": "choose", "q": "'I study to learn' is…", "options": ["Estudio por aprender", "Estudio para aprender", "Estudio aprender", "Por estudio aprender"], "answer": "Estudio para aprender"}, {"type": "reorder", "q": "Order: ti / para / es", "answer": "es para ti"}, {"type": "speak", "q": "Say aloud: Este regalo es para ti.", "answer": "Este regalo es para ti."}], "quiz": [{"q": "PARA TI means…", "options": ["by you", "for you", "with you", "from you"], "answer": 1, "why": "Para = for (purpose)."}, {"q": "POR DIEZ EUROS means…", "options": ["to ten euros", "for ten euros (price)", "ten euros daily", "free"], "answer": 1, "why": "Por = price/exchange."}, {"q": "POR LA MAÑANA means…", "options": ["for the morning gift", "in the morning", "to the morning", "good morning"], "answer": 1, "why": "Por = through/during."}, {"q": "ESTUDIO PARA APRENDER means…", "options": ["I study and learn", "I study to learn", "I learn to study", "I studied"], "answer": 1, "why": "Para + purpose."}, {"q": "¿POR QUÉ? asks…", "options": ["what for? (purpose)", "why? (cause)", "where?", "when?"], "answer": 1, "why": "Por qué = why."}], "flashcards": "auto:vocab", "worksheet": {"title": "Por vs para worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["gift", "destination", "favour"], "key": ["el regalo", "el destino", "el favor"]}, {"instruction": "Choose por or para.", "items": ["This gift is ___ you", "I bought it ___ 10 euros", "I study ___ learn"], "key": ["para", "por", "para"]}, {"instruction": "Thank someone.", "items": ["Thanks! Why?", "For your help"], "key": ["¡Gracias! ¿Por qué?", "Por tu ayuda"]}]}}]}, {"id": "B2-U3", "title": "Stories and hypotheticals", "lessons": [{"id": "B2-U3-L1", "title": "Idioms and sayings", "learn": "Idioms don't translate word-for-word! TOMAR EL PELO = to pull someone's leg (to tease). Learn them as whole chunks — they make you sound truly Spanish.", "vocab": [{"t": "tomar el pelo", "r": "toh-MAHR ehl PEH-loh", "en": "to pull someone's leg", "pos": "idiom"}, {"t": "costar un ojo de la cara", "r": "kohs-TAHR oon OH-hoh deh lah KAH-rah", "en": "to cost an arm and a leg", "pos": "idiom"}, {"t": "estar en las nubes", "r": "ehs-TAHR ehn lahs NOO-behs", "en": "to have your head in the clouds", "pos": "idiom"}, {"t": "ser pan comido", "r": "sehr pahn koh-MEE-doh", "en": "to be a piece of cake", "pos": "idiom"}, {"t": "meter la pata", "r": "meh-TEHR lah PAH-tah", "en": "to put your foot in it", "pos": "idiom"}, {"t": "no tener ni idea", "r": "noh teh-NEHR nee ee-DEH-ah", "en": "to have no idea", "pos": "idiom"}, {"t": "dormir como un tronco", "r": "dohr-MEER KOH-moh oon TROHN-koh", "en": "to sleep like a log", "pos": "idiom"}, {"t": "hablar por los codos", "r": "ah-BLAHR pohr lohs KOH-dohs", "en": "to talk non-stop", "pos": "idiom"}], "grammar": {"title": "Idioms = whole chunks, never word-for-word", "explain": "COSTAR UN OJO = to cost an eye (expensive!). Translate the MEANING, not the words. Use idioms whole: ME COSTÓ UN OJO = it cost me a fortune.", "pattern": "idiom as one fixed chunk", "examples": [{"t": "Me estás tomando el pelo.", "r": "meh ehs-TAHS toh-MAHN-doh ehl PEH-loh.", "en": "You are pulling my leg."}, {"t": "El examen fue pan comido.", "r": "ehl ehk-SAH-mehn fweh pahn koh-MEE-doh.", "en": "The exam was a piece of cake."}, {"t": "Metí la pata ayer.", "r": "meh-TEE lah PAH-tah ah-YEHR.", "en": "I put my foot in it yesterday."}], "mistakes": ["Translating idioms literally — learn the real meaning.", "Changing idiom words: TOMAR EL PELO is fixed!"]}, "dialogue": [{"sp": "Ben", "t": "¿Qué tal el examen?", "r": "keh tahl ehl ehk-SAH-mehn?", "en": "How was the exam?"}, {"sp": "Ana", "t": "Pan comido. Dormí como un tronco después.", "r": "pahn koh-MEE-doh. dohr-MEE KOH-moh oon TROHN-koh dehs-PWEHS.", "en": "Piece of cake. I slept like a log after."}, {"sp": "Ben", "t": "¡Me tomas el pelo!", "r": "meh TOH-mahs ehl PEH-loh!", "en": "You are pulling my leg!"}, {"sp": "Ana", "t": "No, en serio.", "r": "noh, ehn SEH-ryoh.", "en": "No, seriously."}], "practice": [{"type": "translate_en", "q": "Say: The exam was a piece of cake", "answer": "El examen fue pan comido"}, {"type": "fill", "q": "Me estás ___ el pelo. (pulling)", "answer": "tomando"}, {"type": "choose", "q": "'I have no idea' is…", "options": ["No tengo idea", "No tengo ni idea", "No sé nada idea", "Ni idea tengo no"], "answer": "No tengo ni idea"}, {"type": "reorder", "q": "Order: pata / la / metí", "answer": "metí la pata"}, {"type": "speak", "q": "Say aloud: El examen fue pan comido.", "answer": "El examen fue pan comido."}], "quiz": [{"q": "TOMAR EL PELO means…", "options": ["to cut hair", "to tease", "to sleep", "to eat"], "answer": 1, "why": "Pulling someone's leg = teasing."}, {"q": "PAN COMIDO describes something…", "options": ["tasty", "easy", "hard", "salty"], "answer": 1, "why": "Piece of cake = easy."}, {"q": "Why learn idioms as chunks?", "options": ["they are short", "word-for-word fails", "they rhyme", "exams need them"], "answer": 1, "why": "Costar un ojo ≠ eye shopping!"}, {"q": "DORMIR COMO UN TRONCO means…", "options": ["to nap lightly", "to sleep deeply", "to snore loudly", "to dream"], "answer": 1, "why": "Sleep like a log."}, {"q": "METÍ LA PATA AYER means…", "options": ["I danced", "I made a blunder", "I walked far", "I kicked"], "answer": 1, "why": "Meter la pata = to blunder."}], "flashcards": "auto:vocab", "worksheet": {"title": "Idioms worksheet", "tasks": [{"instruction": "Translate the meaning (not words!).", "items": ["tomar el pelo", "pan comido", "meter la pata"], "key": ["to tease", "easy / piece of cake", "to blunder"]}, {"instruction": "Use the idiom.", "items": ["The exam was a piece of cake", "You are pulling my leg"], "key": ["El examen fue pan comido", "Me tomas el pelo"]}, {"instruction": "React.", "items": ["How was the exam?", "No, seriously"], "key": ["¿Qué tal el examen?", "No, en serio"]}]}}, {"id": "B2-U3-L2", "title": "If-plans: si llueve, me quedo", "learn": "Real plans: SI + present, + present/future. SI LLUEVE, ME QUEDO (if it rains, I stay). SI VIENES, TE AYUDO (if you come, I help you). Cause meets result!", "vocab": [{"t": "si", "r": "see", "en": "if", "pos": "conjunction"}, {"t": "la condición", "r": "lah kohn-dee-SYOHN", "en": "condition", "pos": "noun"}, {"t": "el resultado", "r": "ehl reh-sool-TAH-doh", "en": "result", "pos": "noun"}, {"t": "el riesgo", "r": "ehl RYEHS-goh", "en": "risk", "pos": "noun"}, {"t": "el premio", "r": "ehl PREH-myoh", "en": "prize", "pos": "noun"}, {"t": "el castigo", "r": "ehl kahs-TEE-goh", "en": "punishment", "pos": "noun"}, {"t": "la opción", "r": "lah ohp-SYOHN", "en": "option", "pos": "noun"}, {"t": "la decisión", "r": "lah deh-see-SYOHN", "en": "decision", "pos": "noun"}], "grammar": {"title": "Real SI: si + present, + result", "explain": "SI LLUEVE (if it rains) → ME QUEDO (I stay). Both verbs in present, or result in future: SI VIENES, TE AYUDARÉ. Real, possible plans only!", "pattern": "si + present, + present/future", "examples": [{"t": "Si llueve, me quedo.", "r": "see YWEH-veh, meh KEH-doh.", "en": "If it rains, I stay."}, {"t": "Si vienes, te ayudo.", "r": "see VYEH-nehs, teh ah-YOO-doh.", "en": "If you come, I help you."}, {"t": "Si estudias, aprobarás.", "r": "see ehs-TOO-dyahs, ah-proh-bah-RAHS.", "en": "If you study, you will pass."}], "mistakes": ["Using future after SI: SI LLUEVE (present!), never SI LLOVERÁ.", "Forgetting the comma pause between condition and result."]}, "dialogue": [{"sp": "Ana", "t": "Si llueve, ¿qué hacemos?", "r": "see YWEH-veh, keh ah-SEH-mohs?", "en": "If it rains, what do we do?"}, {"sp": "Ben", "t": "Si llueve, me quedo en casa.", "r": "see YWEH-veh, meh KEH-doh ehn KAH-sah.", "en": "If it rains, I stay home."}, {"sp": "Ana", "t": "Y si hace sol, vamos a la playa.", "r": "ee see AH-seh sohl, VAH-mohs ah lah PLAH-yah.", "en": "And if it is sunny, we go to the beach."}, {"sp": "Ben", "t": "¡Buena decisión!", "r": "BWEH-nah deh-see-SYOHN!", "en": "Good decision!"}], "practice": [{"type": "translate_en", "q": "Say: If it rains, I stay", "answer": "Si llueve, me quedo"}, {"type": "fill", "q": "Si ___, te ayudo. (you come)", "answer": "vienes"}, {"type": "choose", "q": "'If you study, you will pass' is…", "options": ["Si estudias, aprobarás", "Si estudiarás, apruebas", "Si estudies, aprobarás", "Estudias si aprobarás"], "answer": "Si estudias, aprobarás"}, {"type": "reorder", "q": "Order: quedo / si / me / llueve", "answer": "si llueve, me quedo"}, {"type": "speak", "q": "Say aloud: Si llueve, me quedo.", "answer": "Si llueve, me quedo."}], "quiz": [{"q": "SI LLUEVE, ME QUEDO means…", "options": ["It rains, I left", "If it rains, I stay", "Rain stays", "I like rain"], "answer": 1, "why": "Si + present = real plan."}, {"q": "After SI the verb is…", "options": ["future", "present", "past", "infinitive"], "answer": 1, "why": "Si VIENES — present!"}, {"q": "EL PREMIO is…", "options": ["risk", "prize", "option", "result"], "answer": 1, "why": "Premio = prize."}, {"q": "SI ESTUDIAS, APROBARÁS: the result verb is…", "options": ["present", "future", "past", "missing"], "answer": 1, "why": "Aprobarás = you will pass."}, {"q": "LA DECISIÓN is…", "options": ["condition", "decision", "risk", "punishment"], "answer": 1, "why": "Decisión = decision."}], "flashcards": "auto:vocab", "worksheet": {"title": "If-plans worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["if", "prize", "decision"], "key": ["si", "el premio", "la decisión"]}, {"instruction": "Make if-plans.", "items": ["If it rains, I stay", "If you come, I help you", "If you study, you will pass"], "key": ["Si llueve, me quedo", "Si vienes, te ayudo", "Si estudias, aprobarás"]}, {"instruction": "Weekend logic.", "items": ["If it rains, what do we do?", "And if it is sunny, we go to the beach"], "key": ["Si llueve, ¿qué hacemos?", "Y si hace sol, vamos a la playa"]}]}}]}], "test": {"title": "B2 final test", "items": [{"type": "translate_en", "q": "Say: I want you to speak", "answer": "Quiero que hables"}, {"type": "fill", "q": "Dice que ___ (he is coming)", "answer": "viene"}, {"type": "choose", "q": "'Could you help me?'", "options": ["¿Me ayudas?", "¿Podría ayudarme?", "¿Ayúdame!", "¿Ayudas?"], "answer": "¿Podría ayudarme?"}, {"type": "translate_en", "q": "Say: This gift is for you", "answer": "Este regalo es para ti"}, {"type": "translate_t", "q": "El examen fue pan comido.", "answer": "The exam was a piece of cake."}, {"type": "fill", "q": "Si ___, me quedo. (it rains)", "answer": "llueve"}, {"type": "reorder", "q": "Order: hables / quiero / que", "answer": "quiero que hables"}, {"type": "speak", "q": "Say aloud: Quiero que me ayudes.", "answer": "Quiero que me ayudes."}, {"type": "fill", "q": "Me ___ hablar. (I would like to)", "answer": "gustaría"}, {"type": "choose", "q": "'I study to learn'", "options": ["Estudio por aprender", "Estudio para aprender", "Estudio aprendiendo", "Por estudio aprender"], "answer": "Estudio para aprender"}]}}}