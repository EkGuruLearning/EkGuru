{"code": "ar", "name": "Arabic", "native": "العربية", "phase": 1, "medium": "en", "file_level": "B2", "level": {"title": "Advanced: subjunctive, conditionals, debate, culture", "goals": ["Use أن-clauses and conditionals naturally", "Debate with connectors and viewpoints", "Discuss Arab culture with real fluency"], "units": [{"id": "B2-U1", "title": "Advanced grammar", "lessons": [{"id": "B2-U1-L1", "title": "أن: أريد أن أدرس", "learn": "Want TO do? أريد أن أدرس = I want to study! أن + bare present: يجب أن تذهب (you must go), يمكن أن آتي (I can come). Two verbs, one أن-bridge between them!", "vocab": [{"t": "أن", "r": "an", "en": "to / that", "pos": "phrase"}, {"t": "أحتاج", "r": "aḥtāj", "en": "I need", "pos": "verb"}, {"t": "يجب", "r": "yajib", "en": "must / should", "pos": "verb"}, {"t": "يمكن", "r": "yumkin", "en": "it is possible / can", "pos": "verb"}, {"t": "أستطيع", "r": "astaṭīʿ", "en": "I can", "pos": "verb"}, {"t": "أقرر", "r": "uqarrir", "en": "I decide", "pos": "verb"}, {"t": "أنسى", "r": "ansā", "en": "I forget", "pos": "verb"}, {"t": "أحاول", "r": "uḥāwil", "en": "I try", "pos": "verb"}], "grammar": {"title": "أن + bare present", "explain": "أريد أن أدرس (I want to study), يجب أن تذهب (you must go), أحاول أن أفهم (I try to understand). After أن, verbs go bare: أن يدرسَ، أن تذهبَ!", "pattern": "want/must/can + أن + bare verb", "examples": [{"t": "أريد أن أدرس العربية.", "r": "urīd an adrus al-ʿarabiyya.", "en": "I want to study Arabic."}, {"t": "يجب أن تذهب.", "r": "yajib an tadhhab.", "en": "You must go."}, {"t": "يمكن أن آتي غدا.", "r": "yumkin an ātī ghadan.", "en": "I can come tomorrow."}], "mistakes": ["Saying أريد أدرس without أن — bridge needs أن!", "Using past after أن: أن + PRESENT-bare!"]}, "dialogue": [{"sp": "ليلى", "t": "ماذا تريد أن تفعل؟", "r": "mādhā turīd an tafʿal?", "en": "What do you want to do? (to m)"}, {"sp": "عمر", "t": "أريد أن أدرس العربية.", "r": "urīd an adrus al-ʿarabiyya.", "en": "I want to study Arabic."}, {"sp": "ليلى", "t": "يجب أن تتدرب كل يوم!", "r": "yajib an tatadarrab kull yawm!", "en": "You must practise every day!"}, {"sp": "عمر", "t": "سأحاول!", "r": "sa-uḥāwil!", "en": "I will try!"}], "practice": [{"type": "translate_en", "q": "Say: I want to study Arabic", "answer": "أريد أن أدرس العربية"}, {"type": "fill", "q": "يجب ___ تذهب. (to/that)", "answer": "أن"}, {"type": "choose", "q": "'You must go' is…", "options": ["تريد أن تذهب", "يجب أن تذهب", "يمكن أن تذهب", "تحاول أن تذهب"], "answer": "يجب أن تذهب"}, {"type": "reorder", "q": "Order: أدرس / أن / أريد", "answer": "أريد أن أدرس"}, {"type": "speak", "q": "Say aloud: أريد أن أدرس العربية.", "answer": "أريد أن أدرس العربية."}], "quiz": [{"q": "أريد أن أدرس uses أن because…", "options": ["past tense", "bridge between two verbs", "plural", "formal"], "answer": 1, "why": "أن links want + do."}, {"q": "يجب أن تذهب means…", "options": ["you want to go", "you must go", "you can go", "you try to go"], "answer": 1, "why": "يجب = must."}, {"q": "يمكن means…", "options": ["must", "can / possible", "want", "try"], "answer": 1, "why": "يمكن = it is possible."}, {"q": "After أن verbs are…", "options": ["past", "bare present", "dual", "plural"], "answer": 1, "why": "أن يدرسَ — bare!"}, {"q": "سأحاول means…", "options": ["I tried", "I will try", "I want", "I must"], "answer": 1, "why": "سـ + أحاول = will try."}], "flashcards": "auto:vocab", "worksheet": {"title": "أن-clauses worksheet", "tasks": [{"instruction": "Translate to Arabic.", "items": ["to / that", "I need", "I try"], "key": ["أن", "أحتاج", "أحاول"]}, {"instruction": "Bridge verbs.", "items": ["I want to study", "You must go", "I can come tomorrow"], "key": ["أريد أن أدرس", "يجب أن تذهب", "يمكن أن آتي غدا"]}, {"instruction": "Coach a friend.", "items": ["You must practise every day!", "I will try!"], "key": ["يجب أن تتدرب كل يوم", "سأحاول"]}]}}, {"id": "B2-U1-L2", "title": "Conditionals: إذا ولو", "learn": "IF power! إذا درستَ نجحتَ = If you study, you succeed (real). لو كان عندي وقت، لسافرتُ = If I HAD time, I WOULD travel (dream!). إذا = real, لو = unreal. Dream in Arabic!", "vocab": [{"t": "إذا", "r": "idhā", "en": "if (real)", "pos": "conjunction"}, {"t": "لو", "r": "law", "en": "if (unreal)", "pos": "conjunction"}, {"t": "عندما", "r": "ʿindamā", "en": "when", "pos": "conjunction"}, {"t": "كلما", "r": "kullamā", "en": "whenever", "pos": "conjunction"}, {"t": "إلا", "r": "illā", "en": "unless / except", "pos": "phrase"}, {"t": "سواء", "r": "sawāʾ", "en": "whether", "pos": "phrase"}, {"t": "ربما", "r": "rubbamā", "en": "perhaps", "pos": "adverb"}, {"t": "لعل", "r": "laʿalla", "en": "hopefully / may", "pos": "phrase"}], "grammar": {"title": "إذا + past, past / لو + past, لـ+past", "explain": "إذا درستَ نجحتَ (if you study, you succeed). لو كان عندي مال، لسافرتُ (if I had money, I'd travel) — answer takes لَـ!", "pattern": "إذا… … · لو… لـ…", "examples": [{"t": "إذا درستَ، نجحتَ.", "r": "idhā darasta, najaḥta.", "en": "If you study, you succeed."}, {"t": "لو كان عندي وقت، لسافرتُ.", "r": "law kāna ʿindī waqt, la-sāfartu.", "en": "If I had time, I would travel."}, {"t": "ربما سأسافر غدا.", "r": "rubbamā sa-usāfir ghadan.", "en": "Perhaps I will travel tomorrow."}], "mistakes": ["Using future after إذا: إذا درستَ (past-form!), not ستدرس!", "Forgetting لَـ in لو-answers: لسافرتُ with لَ!"]}, "dialogue": [{"sp": "عمر", "t": "إذا درستَ، ستنجح.", "r": "idhā darasta, sa-tanjaḥ.", "en": "If you study, you will succeed. (to m)"}, {"sp": "ليلى", "t": "ولو كان عندي وقت أكثر؟", "r": "wa law kāna ʿindī waqt akthar?", "en": "And if I had more time?"}, {"sp": "عمر", "t": "لنجحتِ أكثر!", "r": "la-najaḥti akthar!", "en": "You would succeed more! (to f)"}, {"sp": "ليلى", "t": "إن شاء الله!", "r": "in shāʾa allāh!", "en": "God willing!"}], "practice": [{"type": "translate_en", "q": "Say: If you study, you succeed (m)", "answer": "إذا درستَ، نجحتَ"}, {"type": "fill", "q": "___ كان عندي وقت، لسافرتُ. (If, unreal)", "answer": "لو"}, {"type": "choose", "q": "'If I had time, I would travel' is…", "options": ["إذا كان عندي وقت، سأسافر", "لو كان عندي وقت، لسافرتُ", "عندما كان عندي وقت، سافرتُ", "ربما عندي وقت، سأسافر"], "answer": "لو كان عندي وقت، لسافرتُ"}, {"type": "reorder", "q": "Order: نجحتَ / درستَ / إذا", "answer": "إذا درستَ نجحتَ"}, {"type": "speak", "q": "Say aloud: إذا درستَ، ستنجح.", "answer": "إذا درستَ، ستنجح."}], "quiz": [{"q": "إذا درستَ نجحتَ means…", "options": ["you studied and succeeded", "if you study, you succeed", "study then succeed!", "you will study"], "answer": 1, "why": "إذا = real if."}, {"q": "لو signals…", "options": ["real plans", "unreal dreams", "orders", "questions"], "answer": 1, "why": "لو = if-only."}, {"q": "لسافرتُ has لَ because…", "options": ["future", "لو-answer marker", "plural", "formal"], "answer": 1, "why": "لو-answers take لَـ."}, {"q": "ربما means…", "options": ["always", "perhaps", "never", "must"], "answer": 1, "why": "ربما = perhaps."}, {"q": "إن شاء الله means…", "options": ["thank God", "God willing", "God is great", "praise God"], "answer": 1, "why": "Future + إن شاء الله!"}], "flashcards": "auto:vocab", "worksheet": {"title": "Conditionals worksheet", "tasks": [{"instruction": "Translate to Arabic.", "items": ["if (real)", "if (unreal)", "perhaps"], "key": ["إذا", "لو", "ربما"]}, {"instruction": "Real and unreal.", "items": ["If you study, you succeed (m)", "If I had time, I would travel"], "key": ["إذا درستَ، نجحتَ", "لو كان عندي وقت، لسافرتُ"]}, {"instruction": "Encourage.", "items": ["If you study, you will succeed", "God willing!"], "key": ["إذا درستَ، ستنجح", "إن شاء الله!"]}]}}]}, {"id": "B2-U2", "title": "Debate", "lessons": [{"id": "B2-U2-L1", "title": "Debate connectors", "learn": "Argue like an Arab intellectual! بالرغم من (despite), علاوة على (moreover), من ناحية… ومن جهة أخرى (on one hand… on the other), لذلك (therefore), باختصار (in short)!", "vocab": [{"t": "لكن", "r": "lākin", "en": "but", "pos": "conjunction"}, {"t": "بالرغم من", "r": "bi-ar-raghm min", "en": "despite", "pos": "phrase"}, {"t": "علاوة على", "r": "ʿilāwatan ʿalā", "en": "moreover", "pos": "phrase"}, {"t": "من ناحية", "r": "min nāḥiya", "en": "on one hand", "pos": "phrase"}, {"t": "من جهة أخرى", "r": "min jiha ukhrā", "en": "on the other hand", "pos": "phrase"}, {"t": "لذلك", "r": "li-dhālik", "en": "therefore", "pos": "adverb"}, {"t": "بالتالي", "r": "bi-at-tālī", "en": "consequently", "pos": "adverb"}, {"t": "باختصار", "r": "bi-ikhtiṣār", "en": "in short", "pos": "phrase"}], "grammar": {"title": "Connector chains", "explain": "من ناحية… ومن جهة أخرى… frames both sides. بالرغم من + noun: بالرغم من السعر (despite the price). لذلك concludes: لذلك أنا مع المترو!", "pattern": "من ناحية… من جهة أخرى… لذلك…", "examples": [{"t": "المترو جيد، بالرغم من الزحام.", "r": "al-mitrū jayyid, bi-ar-raghm min az-ziḥām.", "en": "The metro is good, despite the crowding."}, {"t": "علاوة على ذلك، هو رخيص.", "r": "ʿilāwatan ʿalā dhālik, huwa rakhīṣ.", "en": "Moreover, it is cheap."}, {"t": "لذلك أنا مع المترو.", "r": "li-dhālik anā maʿa al-mitrū.", "en": "Therefore I'm for the metro."}], "mistakes": ["Stopping at لكن — add بالرغم من + علاوة!", "Saying بالرغم بدون من — needs بالرغم من!"]}, "dialogue": [{"sp": "ليلى", "t": "المترو أفضل، بالرغم من الزحام.", "r": "al-mitrū afḍal, bi-ar-raghm min az-ziḥām.", "en": "The metro is better, despite the crowding."}, {"sp": "عمر", "t": "لكن السيارة أسرع!", "r": "lākinna as-sayyāra asraʿ!", "en": "But the car is faster!"}, {"sp": "ليلى", "t": "علاوة على ذلك، المترو أرخص.", "r": "ʿilāwatan ʿalā dhālik, al-mitrū arkhaṣ.", "en": "Moreover, the metro is cheaper."}, {"sp": "عمر", "t": "باختصار، كلاهما مفيد!", "r": "bi-ikhtiṣār, kilāhumā mufīd!", "en": "In short, both are useful!"}], "practice": [{"type": "translate_en", "q": "Say: Therefore I'm for the metro", "answer": "لذلك أنا مع المترو"}, {"type": "fill", "q": "___، كلاهما مفيد! (In short)", "answer": "باختصار"}, {"type": "choose", "q": "'Despite the crowding' is…", "options": ["بالرغم الزحام", "بالرغم من الزحام", "علاوة على الزحام", "لذلك الزحام"], "answer": "بالرغم من الزحام"}, {"type": "reorder", "q": "Order: المترو / مع / أنا / لذلك", "answer": "لذلك أنا مع المترو"}, {"type": "speak", "q": "Say aloud: لذلك أنا مع المترو.", "answer": "لذلك أنا مع المترو."}], "quiz": [{"q": "بالرغم من means…", "options": ["moreover", "despite", "therefore", "in short"], "answer": 1, "why": "بالرغم من = despite."}, {"q": "علاوة على ذلك means…", "options": ["however", "moreover", "therefore", "although"], "answer": 1, "why": "علاوة = moreover."}, {"q": "لذلك means…", "options": ["but", "despite", "therefore", "perhaps"], "answer": 2, "why": "لذلك = therefore."}, {"q": "باختصار means…", "options": ["in short", "for example", "of course", "by the way"], "answer": 0, "why": "باختصار = in short."}, {"q": "من جهة أخرى means…", "options": ["on one hand", "on the other hand", "therefore", "despite"], "answer": 1, "why": "Pairs with من ناحية."}], "flashcards": "auto:vocab", "worksheet": {"title": "Connectors worksheet", "tasks": [{"instruction": "Translate to Arabic.", "items": ["despite", "moreover", "therefore"], "key": ["بالرغم من", "علاوة على", "لذلك"]}, {"instruction": "Argue.", "items": ["The metro is good, despite the crowding", "Moreover, it is cheap", "Therefore I'm for the metro"], "key": ["المترو جيد، بالرغم من الزحام", "علاوة على ذلك، هو رخيص", "لذلك أنا مع المترو"]}, {"instruction": "Conclude.", "items": ["In short, both are useful!", "Therefore I'm for the metro"], "key": ["باختصار، كلاهما مفيد!", "لذلك أنا مع المترو"]}]}}, {"id": "B2-U2-L2", "title": "Viewpoints: وجهة نظر", "learn": "State YOUR view! برأيي (in my opinion), من وجهة نظري (from my viewpoint), أوافقك الرأي (I agree with you), أعارض (I oppose), بصراحة (frankly), في الحقيقة (actually)!", "vocab": [{"t": "وجهة نظر", "r": "wijhat naẓar", "en": "viewpoint", "pos": "noun"}, {"t": "أوافق", "r": "uwāfiq", "en": "I agree", "pos": "verb"}, {"t": "أعارض", "r": "uʿāriḍ", "en": "I oppose", "pos": "verb"}, {"t": "صحيح", "r": "ṣaḥīḥ", "en": "correct / true", "pos": "adjective"}, {"t": "خطأ", "r": "khaṭaʾ", "en": "wrong / mistake", "pos": "noun"}, {"t": "برأيي", "r": "bi-raʾyī", "en": "in my opinion", "pos": "phrase"}, {"t": "في الحقيقة", "r": "fī al-ḥaqīqa", "en": "actually", "pos": "phrase"}, {"t": "بصراحة", "r": "bi-ṣarāḥa", "en": "frankly", "pos": "phrase"}], "grammar": {"title": "برأيي… أوافقك الرأي", "explain": "برأيي، المترو أفضل (in my opinion, the metro is better). أوافقك الرأي (I agree with you-m), أوافقكِ (f). أعارض هذه الفكرة (I oppose this idea)!", "pattern": "برأيي… · أوافقك/أعارض", "examples": [{"t": "برأيي، المترو أفضل.", "r": "bi-raʾyī, al-mitrū afḍal.", "en": "In my opinion, the metro is better."}, {"t": "أوافقك الرأي.", "r": "uwāfiquka ar-raʾy.", "en": "I agree with you. (m)"}, {"t": "بصراحة، أعارض هذه الفكرة.", "r": "bi-ṣarāḥa, uʿāriḍ hādhihī al-fikra.", "en": "Frankly, I oppose this idea."}], "mistakes": ["Saying أنا أوافق بدون ك — agree WITH: أوافقك!", "Saying برأي بدون ي — MY opinion: برأيي!"]}, "dialogue": [{"sp": "عمر", "t": "برأيي، السيارة أفضل.", "r": "bi-raʾyī, as-sayyāra afḍal.", "en": "In my opinion, the car is better."}, {"sp": "ليلى", "t": "بصراحة، أعارض. المترو أرخص!", "r": "bi-ṣarāḥa, uʿāriḍ. al-mitrū arkhaṣ!", "en": "Frankly, I disagree. The metro is cheaper!"}, {"sp": "عمر", "t": "في الحقيقة، معك حق.", "r": "fī al-ḥaqīqa, maʿaki ḥaqq.", "en": "Actually, you're right. (to f)"}, {"sp": "ليلى", "t": "أوافقك الرأي أخيرا!", "r": "uwāfiquka ar-raʾy akhīran!", "en": "You agree with me at last! (to m)"}], "practice": [{"type": "translate_en", "q": "Say: In my opinion, the metro is better", "answer": "برأيي، المترو أفضل"}, {"type": "fill", "q": "___ الرأي. (I agree with you, m)", "answer": "أوافقك"}, {"type": "choose", "q": "'Frankly, I oppose' is…", "options": ["في الحقيقة، أوافق", "بصراحة، أعارض", "برأيي، أوافق", "صحيح، أعارض"], "answer": "بصراحة، أعارض"}, {"type": "reorder", "q": "Order: أفضل / المترو / برأيي", "answer": "برأيي المترو أفضل"}, {"type": "speak", "q": "Say aloud: برأيي، المترو أفضل.", "answer": "برأيي، المترو أفضل."}], "quiz": [{"q": "أوافقك الرأي means…", "options": ["I oppose you", "I agree with you", "I ask you", "I thank you"], "answer": 1, "why": "أوافق + ك = agree-with-you."}, {"q": "بصراحة means…", "options": ["actually", "frankly", "possibly", "finally"], "answer": 1, "why": "بصراحة = frankly."}, {"q": "في الحقيقة means…", "options": ["frankly", "actually", "finally", "nearly"], "answer": 1, "why": "في الحقيقة = in truth."}, {"q": "خطأ means…", "options": ["correct", "wrong", "maybe", "new"], "answer": 1, "why": "خطأ = wrong/mistake."}, {"q": "وجهة نظر means…", "options": ["good idea", "viewpoint", "right answer", "true story"], "answer": 1, "why": "وجهة نظر = viewpoint."}], "flashcards": "auto:vocab", "worksheet": {"title": "Viewpoints worksheet", "tasks": [{"instruction": "Translate to Arabic.", "items": ["in my opinion", "I agree", "I oppose"], "key": ["برأيي", "أوافق", "أعارض"]}, {"instruction": "Take sides.", "items": ["In my opinion, the metro is better", "I agree with you (m)", "Frankly, I oppose this idea"], "key": ["برأيي، المترو أفضل", "أوافقك الرأي", "بصراحة، أعارض هذه الفكرة"]}, {"instruction": "Concede.", "items": ["Actually, you're right (f)", "At last!"], "key": ["في الحقيقة، معك حق", "أخيرا!"]}]}}]}, {"id": "B2-U3", "title": "Culture and mastery", "lessons": [{"id": "B2-U3-L1", "title": "Arab hospitality and culture", "learn": "Arabs are famous for كرم (generosity)! أهلاً وسهلاً (welcome!), تفضل (please come in / help yourself!), البيت بيتك (my home is yours!). Coffee first, questions later — ضيافة (hospitality) is sacred!", "vocab": [{"t": "كرم", "r": "karam", "en": "generosity", "pos": "noun"}, {"t": "ضيافة", "r": "ḍiyāfa", "en": "hospitality", "pos": "noun"}, {"t": "قهوة عربية", "r": "qahwa ʿarabiyya", "en": "Arabic coffee", "pos": "noun"}, {"t": "تمر", "r": "tamr", "en": "dates", "pos": "noun"}, {"t": "شعر", "r": "shiʿr", "en": "poetry", "pos": "noun"}, {"t": "سوق", "r": "sūq", "en": "market", "pos": "noun"}, {"t": "مسجد", "r": "masjid", "en": "mosque", "pos": "noun"}, {"t": "عائلة", "r": "ʿāʾila", "en": "family", "pos": "noun"}], "grammar": {"title": "Hospitality phrases", "explain": "أهلاً وسهلاً (welcome!), تفضل/تفضلي (come in / have some!), البيت بيتك (make yourself at home!), صحتين (double health — said when someone eats/drinks)!", "pattern": "أهلاً وسهلاً · تفضل · صحتين", "examples": [{"t": "أهلاً وسهلاً! تفضل!", "r": "ahlan wa sahlan! tafaḍḍal!", "en": "Welcome! Come in! (m)"}, {"t": "البيت بيتك.", "r": "al-bayt baytuk.", "en": "My home is yours. (m)"}, {"t": "صحتين!", "r": "ṣaḥḥatayn!", "en": "Bless you (eating/drinking)!"}], "mistakes": ["Refusing coffee twice — first refusal is polite, second is final!", "Saying شكرا and leaving — hospitality needs time!"]}, "dialogue": [{"sp": "عمر", "t": "أهلاً وسهلاً! تفضل!", "r": "ahlan wa sahlan! tafaḍḍal!", "en": "Welcome! Come in! (to m)"}, {"sp": "ليلى", "t": "شكرا! البيت جميل!", "r": "shukran! al-bayt jamīl!", "en": "Thanks! The house is beautiful!"}, {"sp": "عمر", "t": "البيت بيتك. قهوة؟", "r": "al-bayt baytuk. qahwa?", "en": "My home is yours. Coffee? (to f)"}, {"sp": "ليلى", "t": "نعم، من فضلك!", "r": "naʿam, min faḍlik!", "en": "Yes, please!"}], "practice": [{"type": "translate_en", "q": "Say (to m): Welcome! Come in!", "answer": "أهلاً وسهلاً! تفضل!"}, {"type": "fill", "q": "البيت ___. (yours, m)", "answer": "بيتك"}, {"type": "choose", "q": "Said when someone eats/drinks…", "options": ["صحتين", "شكرا", "عفوا", "ممتاز"], "answer": "صحتين"}, {"type": "reorder", "q": "Order: وسهلاً / أهلاً", "answer": "أهلاً وسهلاً"}, {"type": "speak", "q": "Say aloud: أهلاً وسهلاً! تفضل!", "answer": "أهلاً وسهلاً! تفضل!"}], "quiz": [{"q": "أهلاً وسهلاً means…", "options": ["goodbye", "welcome", "thanks", "sorry"], "answer": 1, "why": "أهلاً وسهلاً = welcome!"}, {"q": "تفضل means…", "options": ["goodbye", "come in / have some", "thank you", "excuse me"], "answer": 1, "why": "تفضل = please come/have (m)."}, {"q": "البيت بيتك means…", "options": ["my home is big", "my home is yours", "your home is far", "this is home"], "answer": 1, "why": "Make-yourself-at-home phrase."}, {"q": "صحتين is said when…", "options": ["meeting", "eating/drinking", "leaving", "sleeping"], "answer": 1, "why": "Double-health blessing."}, {"q": "ضيافة means…", "options": ["generosity", "hospitality", "poetry", "family"], "answer": 1, "why": "ضيافة = hospitality."}], "flashcards": "auto:vocab", "worksheet": {"title": "Hospitality worksheet", "tasks": [{"instruction": "Translate to Arabic.", "items": ["welcome", "generosity", "dates"], "key": ["أهلاً وسهلاً", "كرم", "تمر"]}, {"instruction": "Host guests.", "items": ["Welcome! Come in! (m)", "My home is yours (m)", "Bless you (eating)!"], "key": ["أهلاً وسهلاً! تفضل!", "البيت بيتك", "صحتين!"]}, {"instruction": "Be a guest.", "items": ["Thanks! The house is beautiful!", "Yes, please!"], "key": ["شكرا! البيت جميل!", "نعم، من فضلك!"]}]}}, {"id": "B2-U3-L2", "title": "Storytelling mastery", "learn": "Graduation! Spin tales: في البداية (in the beginning), ثم (then), بعد ذلك (after that), فجأة (suddenly), أخيرا (finally), في النهاية (in the end). Mix pasts, كان, لو-dreams. Tell YOUR Cairo story!", "vocab": [{"t": "في البداية", "r": "fī al-bidāya", "en": "in the beginning", "pos": "phrase"}, {"t": "بعد ذلك", "r": "baʿda dhālik", "en": "after that", "pos": "phrase"}, {"t": "أخيرا", "r": "akhīran", "en": "finally", "pos": "adverb"}, {"t": "في النهاية", "r": "fī an-nihāya", "en": "in the end", "pos": "phrase"}, {"t": "بالمناسبة", "r": "bi-al-munāsaba", "en": "by the way", "pos": "phrase"}, {"t": "للأسف", "r": "li-al-asaf", "en": "unfortunately", "pos": "phrase"}, {"t": "على العكس", "r": "ʿalā al-ʿaks", "en": "on the contrary", "pos": "phrase"}, {"t": "يا للأسف", "r": "yā la-al-asaf", "en": "what a pity", "pos": "phrase"}], "grammar": {"title": "Story spine: في البداية… في النهاية", "explain": "في البداية… ثم… فجأة… أخيرا… في النهاية — the five-beat Arabic story spine. Wrap any tale and sound instantly fluent!", "pattern": "في البداية → ثم → فجأة → أخيرا", "examples": [{"t": "في البداية وصلتُ إلى القاهرة.", "r": "fī al-bidāya waṣaltu ilā al-qāhira.", "en": "In the beginning I arrived in Cairo."}, {"t": "فجأة بدأ المطر!", "r": "fajʾatan badaʾa al-maṭar!", "en": "Suddenly the rain started!"}, {"t": "في النهاية، نمتُ سعيدا.", "r": "fī an-nihāya, nimtu saʿīdan.", "en": "In the end, I slept happy."}], "mistakes": ["Listing events without spine words — always في البداية…ثم!", "Staying in one tense — mix وصلتُ + كان + سأسافر!"]}, "dialogue": [{"sp": "عمر", "t": "احكِ قصتك!", "r": "uḥkī qiṣṣatak!", "en": "Tell your story! (to m)"}, {"sp": "ليلى", "t": "في البداية وصلتُ إلى القاهرة. كان الجو جميلا.", "r": "fī al-bidāya waṣaltu ilā al-qāhira. kāna al-jaww jamīlan.", "en": "In the beginning I arrived in Cairo. The weather was beautiful."}, {"sp": "عمر", "t": "ثم ماذا؟", "r": "thumma mādhā?", "en": "Then what?"}, {"sp": "ليلى", "t": "فجأة بدأ المطر! في النهاية، نمتُ سعيدة!", "r": "fajʾatan badaʾa al-maṭar! fī an-nihāya, nimtu saʿīda!", "en": "Suddenly the rain started! In the end, I slept happy! (f)"}], "practice": [{"type": "translate_en", "q": "Say: In the beginning I arrived in Cairo", "answer": "في البداية وصلتُ إلى القاهرة"}, {"type": "fill", "q": "___، نمتُ سعيدا. (In the end)", "answer": "في النهاية"}, {"type": "choose", "q": "The story spine is…", "options": ["ثم، في البداية، فجأة", "في البداية، ثم، فجأة، في النهاية", "فجأة، أخيرا، ثم", "في النهاية، ثم، في البداية"], "answer": "في البداية، ثم، فجأة، في النهاية"}, {"type": "reorder", "q": "Order: المطر / بدأ / فجأة", "answer": "فجأة بدأ المطر"}, {"type": "speak", "q": "Say aloud: في البداية وصلتُ إلى القاهرة.", "answer": "في البداية وصلتُ إلى القاهرة."}], "quiz": [{"q": "The story spine is…", "options": ["لكن، لأن، ثم", "في البداية، ثم، فجأة، في النهاية", "نعم، لا، ربما", "أنا، أنت، هو"], "answer": 1, "why": "Beginning→then→suddenly→end."}, {"q": "فجأة means…", "options": ["slowly", "suddenly", "finally", "then"], "answer": 1, "why": "فجأة = suddenly."}, {"q": "في النهاية means…", "options": ["in the beginning", "in the end", "suddenly", "by the way"], "answer": 1, "why": "في النهاية = in the end."}, {"q": "للأسف means…", "options": ["luckily", "unfortunately", "finally", "frankly"], "answer": 1, "why": "للأسف = unfortunately."}, {"q": "بالمناسبة means…", "options": ["finally", "by the way", "suddenly", "however"], "answer": 1, "why": "بالمناسبة = by the way."}], "flashcards": "auto:vocab", "worksheet": {"title": "Storytelling worksheet", "tasks": [{"instruction": "Translate to Arabic.", "items": ["in the beginning", "suddenly", "in the end"], "key": ["في البداية", "فجأة", "في النهاية"]}, {"instruction": "Spine a story.", "items": ["In the beginning I arrived in Cairo", "Suddenly the rain started", "In the end, I slept happy"], "key": ["في البداية وصلتُ إلى القاهرة", "فجأة بدأ المطر", "في النهاية، نمتُ سعيدا"]}, {"instruction": "Tell it.", "items": ["Tell your story! (m)", "The weather was beautiful"], "key": ["احكِ قصتك!", "كان الجو جميلا"]}]}}]}], "test": {"title": "B2 final test", "items": [{"type": "translate_en", "q": "Say: I want to study Arabic", "answer": "أريد أن أدرس العربية"}, {"type": "translate_en", "q": "Say (m): If you study, you succeed", "answer": "إذا درستَ، نجحتَ"}, {"type": "choose", "q": "'You must go'", "options": ["تريد أن تذهب", "يجب أن تذهب", "يمكن أن تذهب", "تحاول أن تذهب"], "answer": "يجب أن تذهب"}, {"type": "translate_t", "q": "لذلك أنا مع المترو.", "answer": "Therefore I'm for the metro."}, {"type": "fill", "q": "___، كلاهما مفيد! (In short)", "answer": "باختصار"}, {"type": "choose", "q": "'Welcome! Come in! (m)'", "options": ["مع السلامة! اذهب!", "أهلاً وسهلاً! تفضل!", "شكرا! عفوا!", "صباح الخير! مساء الخير!"], "answer": "أهلاً وسهلاً! تفضل!"}, {"type": "reorder", "q": "Order: المطر / بدأ / فجأة", "answer": "فجأة بدأ المطر"}, {"type": "speak", "q": "Say aloud: برأيي، المترو أفضل.", "answer": "برأيي، المترو أفضل."}, {"type": "fill", "q": "___، نمتُ سعيدا. (In the end)", "answer": "في النهاية"}, {"type": "translate_en", "q": "Say: In my opinion, the metro is better", "answer": "برأيي، المترو أفضل"}]}}}