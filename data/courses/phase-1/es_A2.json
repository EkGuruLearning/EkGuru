{"code": "es", "name": "Spanish", "native": "Español", "phase": 1, "medium": "en", "file_level": "A2", "level": {"title": "Elementary: city, travel, routines, health", "goals": ["Find your way around a city", "Talk about past trips", "Describe routines and make future plans"], "units": [{"id": "A2-U1", "title": "Getting around", "lessons": [{"id": "A2-U1-L1", "title": "Around the city (ESTAR)", "learn": "SER is for WHO you are; ESTAR is for WHERE you are. ESTOY = I am (located), ESTÁS = you are, ESTÁ = it is. La estación ESTÁ allí = The station is over there. Add IZQUIERDA (left) and DERECHA (right) and you can follow any directions.", "vocab": [{"t": "la calle", "r": "lah KAH-yeh", "en": "street", "pos": "noun"}, {"t": "la plaza", "r": "lah PLAH-sah", "en": "square", "pos": "noun"}, {"t": "la estación", "r": "lah ehs-tah-SYOHN", "en": "station", "pos": "noun"}, {"t": "el banco", "r": "ehl BAHN-koh", "en": "bank", "pos": "noun"}, {"t": "el hospital", "r": "ehl ohs-pee-TAHL", "en": "hospital", "pos": "noun"}, {"t": "la tienda", "r": "lah TYEHN-dah", "en": "shop", "pos": "noun"}, {"t": "la izquierda", "r": "lah ees-KYEHR-dah", "en": "left", "pos": "noun"}, {"t": "la derecha", "r": "lah deh-REH-chah", "en": "right", "pos": "noun"}], "grammar": {"title": "ESTAR for location: estoy, estás, está", "explain": "ESTAR answers WHERE. ESTOY EN CASA = I am at home. Never use SER for location! Also learn CERCA (near) and LEJOS (far): Está cerca = It is near.", "pattern": "estoy/estás/está + en + place", "examples": [{"t": "Estoy en casa.", "r": "ehs-TOY ehn KAH-sah.", "en": "I am at home."}, {"t": "¿Dónde estás?", "r": "DOHN-deh ehs-TAHS?", "en": "Where are you?"}, {"t": "La tienda está cerca.", "r": "lah TYEHN-dah ehs-TAH SEHR-kah.", "en": "The shop is near."}], "mistakes": ["Saying SOY en casa — location is always ESTAR.", "Saying ESTÁ for yourself — I am = ESTOY."]}, "dialogue": [{"sp": "Ben", "t": "Perdón, ¿dónde está la estación?", "r": "pehr-DOHN, DOHN-deh ehs-TAH lah ehs-tah-SYOHN?", "en": "Excuse me, where is the station?"}, {"sp": "Ana", "t": "Está allí, a la derecha.", "r": "ehs-TAH ah-YEE, ah lah deh-REH-chah.", "en": "It is over there, on the right."}, {"sp": "Ben", "t": "¿Está lejos?", "r": "ehs-TAH LEH-hohs?", "en": "Is it far?"}, {"sp": "Ana", "t": "No, está cerca. Cinco minutos.", "r": "noh, ehs-TAH SEHR-kah. SEEN-koh mee-NOO-tohs.", "en": "No, it is near. Five minutes."}], "practice": [{"type": "translate_en", "q": "Say: Where is the station?", "answer": "¿Dónde está la estación?"}, {"type": "fill", "q": "Estoy ___ casa. (at)", "answer": "en"}, {"type": "choose", "q": "'It is near' is…", "options": ["Está lejos", "Está cerca", "Es cerca", "Soy cerca"], "answer": "Está cerca"}, {"type": "reorder", "q": "Order: está / tienda / la / cerca", "answer": "la tienda está cerca"}, {"type": "speak", "q": "Say aloud: ¿Dónde está el banco?", "answer": "¿Dónde está el banco?"}], "quiz": [{"q": "ESTOY EN CASA means…", "options": ["I am at home", "I go home", "my home is big", "I like home"], "answer": 0, "why": "Estoy + en = I am at."}, {"q": "LA DERECHA is…", "options": ["left", "right", "straight", "back"], "answer": 1, "why": "Derecha = right."}, {"q": "Why ESTÁ (not ES) for location?", "options": ["it sounds nicer", "location always uses ESTAR", "ES is only for food", "no reason"], "answer": 1, "why": "ESTAR = where things are."}, {"q": "¿DÓNDE ESTÁS? means…", "options": ["Who are you?", "Where are you?", "How are you?", "What are you?"], "answer": 1, "why": "Dónde + estás = where are you."}, {"q": "CINCO MINUTOS is…", "options": ["five minutes", "ten minutes", "five hours", "five days"], "answer": 0, "why": "Cinco = 5, minutos = minutes."}], "flashcards": "auto:vocab", "worksheet": {"title": "City worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["street", "station", "shop"], "key": ["la calle", "la estación", "la tienda"]}, {"instruction": "Complete with estoy, estás, or está.", "items": ["___ en casa (I am)", "¿Dónde ___? (are you)", "La plaza ___ cerca (is)"], "key": ["Estoy", "estás", "está"]}, {"instruction": "Ask for directions.", "items": ["Where is the bank?", "Is it far?"], "key": ["¿Dónde está el banco?", "¿Está lejos?"]}]}}, {"id": "A2-U1-L2", "title": "Travel and the past", "learn": "Talk about finished trips with the PRETÉRITO (simple past). For -AR verbs: HABLÉ (I spoke), HABLASTE (you spoke), HABLÓ (he/she spoke). VIAJÉ A ESPAÑA = I travelled to Spain. One accent mark changes everything!", "vocab": [{"t": "el viaje", "r": "ehl VYAH-heh", "en": "trip", "pos": "noun"}, {"t": "el avión", "r": "ehl ah-VYOHN", "en": "plane", "pos": "noun"}, {"t": "el hotel", "r": "ehl oh-TEHL", "en": "hotel", "pos": "noun"}, {"t": "la maleta", "r": "lah mah-LEH-tah", "en": "suitcase", "pos": "noun"}, {"t": "el billete", "r": "ehl bee-YEH-teh", "en": "ticket", "pos": "noun"}, {"t": "la playa", "r": "lah PLAH-yah", "en": "beach", "pos": "noun"}, {"t": "la montaña", "r": "lah mohn-TAHN-yah", "en": "mountain", "pos": "noun"}, {"t": "la foto", "r": "lah FOH-toh", "en": "photo", "pos": "noun"}], "grammar": {"title": "Past -AR: hablé, hablaste, habló", "explain": "Take off -AR, add -É (I), -ASTE (you), -Ó (he/she). Viajé = I travelled. These are finished, done actions: AYER (yesterday) loves the pretérito.", "pattern": "stem + é/aste/ó", "examples": [{"t": "Viajé a España.", "r": "vyah-HEH ah ehs-PAHN-yah.", "en": "I travelled to Spain."}, {"t": "¿Compraste billetes?", "r": "kohm-PRAHS-teh bee-YEH-tehs?", "en": "Did you buy tickets?"}, {"t": "Ella llegó ayer.", "r": "EH-yah yeh-GOH ah-YEHR.", "en": "She arrived yesterday."}], "mistakes": ["Saying HABLO for the past — past I = HABLÉ (with accent!).", "Forgetting AYER goes with finished past, not present."]}, "dialogue": [{"sp": "Ana", "t": "¿Viajaste este verano?", "r": "vyah-HAHS-teh EHS-teh veh-RAH-noh?", "en": "Did you travel this summer?"}, {"sp": "Ben", "t": "Sí, viajé a México. Visité la playa.", "r": "see, vyah-HEH ah MEH-hee-koh. vee-see-TEH lah PLAH-yah.", "en": "Yes, I travelled to Mexico. I visited the beach."}, {"sp": "Ana", "t": "¿Te gustó?", "r": "teh goos-TOH?", "en": "Did you like it?"}, {"sp": "Ben", "t": "¡Me encantó!", "r": "meh ehn-kahn-TOH!", "en": "I loved it!"}], "practice": [{"type": "translate_en", "q": "Say: I travelled to Spain", "answer": "Viajé a España"}, {"type": "fill", "q": "¿Compraste ___? (tickets)", "answer": "billetes"}, {"type": "choose", "q": "'She arrived yesterday' uses…", "options": ["llega", "llegó", "llegaste", "llegué"], "answer": "llegó"}, {"type": "reorder", "q": "Order: playa / visité / la", "answer": "visité la playa"}, {"type": "speak", "q": "Say aloud: Viajé a México.", "answer": "Viajé a México."}], "quiz": [{"q": "VIAJÉ means…", "options": ["I travel", "I travelled", "you travelled", "he travels"], "answer": 1, "why": "-É = I did (past)."}, {"q": "LA MALETA is…", "options": ["ticket", "suitcase", "hotel", "beach"], "answer": 1, "why": "Maleta = suitcase."}, {"q": "¿TE GUSTÓ? means…", "options": ["Did you like it?", "Do you like it?", "Will you like it?", "You like it!"], "answer": 0, "why": "-Ó past: did you like."}, {"q": "Which is 'you bought'?", "options": ["compré", "compraste", "compró", "compra"], "answer": 1, "why": "-ASTE = you did."}, {"q": "AYER means…", "options": ["tomorrow", "today", "yesterday", "now"], "answer": 2, "why": "Ayer = yesterday."}], "flashcards": "auto:vocab", "worksheet": {"title": "Travel worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["trip", "ticket", "beach"], "key": ["el viaje", "el billete", "la playa"]}, {"instruction": "Put VIAJAR in the past.", "items": ["I travelled", "you travelled", "she travelled"], "key": ["viajé", "viajaste", "viajó"]}, {"instruction": "Answer about a trip.", "items": ["Did you travel? (yes)", "Where? (to Mexico)"], "key": ["Sí, viajé", "Viajé a México"]}]}}]}, {"id": "A2-U2", "title": "Life and plans", "lessons": [{"id": "A2-U2-L1", "title": "Daily routines (reflexive verbs)", "learn": "Routines use REFLEXIVE verbs: the action goes back to you. ME LEVANTO = I get (myself) up. ME = myself, TE = yourself, SE = himself/herself. Every morning runs on ME/TE/SE!", "vocab": [{"t": "la mañana", "r": "lah mahn-YAH-nah", "en": "morning", "pos": "noun"}, {"t": "la tarde", "r": "lah TAHR-deh", "en": "afternoon", "pos": "noun"}, {"t": "la noche", "r": "lah NOH-cheh", "en": "night", "pos": "noun"}, {"t": "el trabajo", "r": "ehl trah-BAH-hoh", "en": "work / job", "pos": "noun"}, {"t": "la escuela", "r": "lah ehs-KWEH-lah", "en": "school", "pos": "noun"}, {"t": "la ducha", "r": "lah DOO-chah", "en": "shower", "pos": "noun"}, {"t": "el desayuno", "r": "ehl deh-sah-YOO-noh", "en": "breakfast", "pos": "noun"}, {"t": "la cena", "r": "lah SEH-nah", "en": "dinner", "pos": "noun"}], "grammar": {"title": "Reflexive ME/TE/SE: me levanto", "explain": "LEVANTARSE = to get up. ME LEVANTO (I get up), TE LEVANTAS (you get up), SE LEVANTA (he/she gets up). The little word before the verb points back at the person.", "pattern": "me/te/se + verb", "examples": [{"t": "Me levanto a las siete.", "r": "meh leh-VAHN-toh ah lahs SYEH-teh.", "en": "I get up at seven."}, {"t": "¿Te duchas por la mañana?", "r": "teh DOO-chahs pohr lah mahn-YAH-nah?", "en": "Do you shower in the morning?"}, {"t": "Se acuesta tarde.", "r": "seh ah-KWEHS-tah TAHR-deh.", "en": "He/She goes to bed late."}], "mistakes": ["Saying LEVANTO without ME — it means 'I lift', not 'I get up'!", "Mixing TE and SE: TE = you, SE = he/she."]}, "dialogue": [{"sp": "Ben", "t": "¿A qué hora te levantas?", "r": "ah keh OH-rah teh leh-VAHN-tahs?", "en": "What time do you get up?"}, {"sp": "Ana", "t": "Me levanto a las siete y me ducho.", "r": "meh leh-VAHN-toh ah lahs SYEH-teh ee meh DOO-choh.", "en": "I get up at seven and shower."}, {"sp": "Ben", "t": "¿Y desayunas?", "r": "ee deh-sah-YOO-nahs?", "en": "And do you eat breakfast?"}, {"sp": "Ana", "t": "Sí, desayuno con mi familia.", "r": "see, deh-sah-YOO-noh kohn mee fah-MEE-lyah.", "en": "Yes, I have breakfast with my family."}], "practice": [{"type": "translate_en", "q": "Say: I get up at seven", "answer": "Me levanto a las siete"}, {"type": "fill", "q": "¿Te ___? (do you shower)", "answer": "duchas"}, {"type": "choose", "q": "'He goes to bed late' uses…", "options": ["me acuesto", "te acuestas", "se acuesta", "nos acostamos"], "answer": "se acuesta"}, {"type": "reorder", "q": "Order: levanto / me / siete / las / a", "answer": "me levanto a las siete"}, {"type": "speak", "q": "Say aloud: Me levanto a las siete.", "answer": "Me levanto a las siete."}], "quiz": [{"q": "ME LEVANTO means…", "options": ["I lift it", "I get up", "I sit down", "I run"], "answer": 1, "why": "Levanto + ME = I get myself up."}, {"q": "LA CENA is…", "options": ["breakfast", "lunch", "dinner", "snack"], "answer": 2, "why": "Cena = dinner."}, {"q": "¿A QUÉ HORA…? asks about…", "options": ["price", "time", "place", "reason"], "answer": 1, "why": "A qué hora = at what time."}, {"q": "TE DUCHAS means…", "options": ["I shower", "you shower", "she showers", "we shower"], "answer": 1, "why": "TE = you."}, {"q": "Which is reflexive?", "options": ["hablo", "me llamo", "como", "vivo"], "answer": 1, "why": "Me llamo = I call myself."}], "flashcards": "auto:vocab", "worksheet": {"title": "Routines worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["morning", "school", "dinner"], "key": ["la mañana", "la escuela", "la cena"]}, {"instruction": "Complete with me, te, or se.", "items": ["___ levanto (I)", "¿___ duchas? (you)", "___ acuesta (she)"], "key": ["Me", "Te", "Se"]}, {"instruction": "Describe your morning.", "items": ["I get up at …", "I shower"], "key": ["Me levanto a las …", "Me ducho"]}]}}, {"id": "A2-U2-L2", "title": "Health and future plans", "learn": "At the doctor: ME DUELE LA CABEZA = my head hurts (to me it pains the head). For plans, Spanish loves IR A + verb: VOY A VIAJAR = I am going to travel. Easy future, no new endings!", "vocab": [{"t": "la cabeza", "r": "lah kah-BEH-sah", "en": "head", "pos": "noun"}, {"t": "la mano", "r": "lah MAH-noh", "en": "hand", "pos": "noun"}, {"t": "el ojo", "r": "ehl OH-hoh", "en": "eye", "pos": "noun"}, {"t": "el médico", "r": "ehl MEH-dee-koh", "en": "doctor", "pos": "noun"}, {"t": "la farmacia", "r": "lah fahr-MAH-syah", "en": "pharmacy", "pos": "noun"}, {"t": "el dolor", "r": "ehl doh-LOHR", "en": "pain", "pos": "noun"}, {"t": "la fiebre", "r": "lah FYEH-breh", "en": "fever", "pos": "noun"}, {"t": "la salud", "r": "lah sah-LOOD", "en": "health", "pos": "noun"}], "grammar": {"title": "Future with IR A: voy a viajar", "explain": "VOY = I go, VAS = you go, VA = he/she goes. VOY A + verb = I am going to…: VOY A COMER = I am going to eat. The second verb never changes!", "pattern": "voy/vas/va + a + verb", "examples": [{"t": "Voy a viajar.", "r": "voy ah vyah-HAHR.", "en": "I am going to travel."}, {"t": "¿Vas a estudiar?", "r": "vahs ah ehs-too-DYAHR?", "en": "Are you going to study?"}, {"t": "Va a llover.", "r": "vah ah yoh-VEHR.", "en": "It is going to rain."}], "mistakes": ["Changing the second verb: VOY A VIAJAR, never VOY A VIAJO.", "Forgetting A: VOY A comer, not VOY comer."]}, "dialogue": [{"sp": "Ben", "t": "Doctor, me duele la cabeza.", "r": "dohk-TOHR, meh DWEH-leh lah kah-BEH-sah.", "en": "Doctor, my head hurts."}, {"sp": "Ana", "t": "¿Tienes fiebre?", "r": "TYEH-nehs FYEH-breh?", "en": "Do you have a fever?"}, {"sp": "Ben", "t": "No, pero voy a descansar.", "r": "noh, PEH-roh voy ah dehs-kahn-SAHR.", "en": "No, but I am going to rest."}, {"sp": "Ana", "t": "Bien. Vas a estar bien.", "r": "byehn. vahs ah ehs-TAHR byehn.", "en": "Good. You are going to be fine."}], "practice": [{"type": "translate_en", "q": "Say: I am going to travel", "answer": "Voy a viajar"}, {"type": "fill", "q": "Me duele la ___. (head)", "answer": "cabeza"}, {"type": "choose", "q": "'Are you going to study?' is…", "options": ["¿Vas a estudiar?", "¿Voy a estudiar?", "¿Va a estudiar?", "¿Van a estudiar?"], "answer": "¿Vas a estudiar?"}, {"type": "reorder", "q": "Order: descansar / voy / a", "answer": "voy a descansar"}, {"type": "speak", "q": "Say aloud: Me duele la cabeza.", "answer": "Me duele la cabeza."}], "quiz": [{"q": "VOY A VIAJAR means…", "options": ["I travel now", "I travelled", "I am going to travel", "I want travel"], "answer": 2, "why": "Voy a + verb = going to."}, {"q": "ME DUELE LA CABEZA means…", "options": ["my head hurts", "my hand hurts", "my eye hurts", "my leg hurts"], "answer": 0, "why": "Cabeza = head."}, {"q": "LA FARMACIA is…", "options": ["hospital", "pharmacy", "clinic", "shop"], "answer": 1, "why": "Farmacia = pharmacy."}, {"q": "VAS A ESTAR BIEN means…", "options": ["you were fine", "you are going to be fine", "you feel bad", "you look fine"], "answer": 1, "why": "Vas a + estar bien."}, {"q": "Which verb NEVER changes in IR A plans?", "options": ["voy", "the first verb", "the second verb", "both verbs"], "answer": 2, "why": "Voy a COMER — comer stays whole."}], "flashcards": "auto:vocab", "worksheet": {"title": "Health worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["head", "doctor", "fever"], "key": ["la cabeza", "el médico", "la fiebre"]}, {"instruction": "Write the plan.", "items": ["I am going to rest", "You are going to be fine"], "key": ["Voy a descansar", "Vas a estar bien"]}, {"instruction": "At the doctor.", "items": ["My head hurts", "I have a fever"], "key": ["Me duele la cabeza", "Tengo fiebre"]}]}}]}, {"id": "A2-U3", "title": "Shopping and weather", "lessons": [{"id": "A2-U3-L1", "title": "Clothes and shopping (demonstratives)", "learn": "Shop in Spanish! LA CAMISA (shirt), LOS ZAPATOS (shoes). Point with ESTE (this, near me) and ESE (that, near you): ESTA CAMISA (this shirt), ESE VESTIDO (that dress).", "vocab": [{"t": "la camisa", "r": "lah kah-MEE-sah", "en": "shirt", "pos": "noun"}, {"t": "los pantalones", "r": "lohs pahn-tah-LOH-nehs", "en": "trousers", "pos": "noun"}, {"t": "los zapatos", "r": "lohs sah-PAH-tohs", "en": "shoes", "pos": "noun"}, {"t": "el vestido", "r": "ehl vehs-TEE-doh", "en": "dress", "pos": "noun"}, {"t": "la tienda", "r": "lah TYEHN-dah", "en": "shop", "pos": "noun"}, {"t": "el precio", "r": "ehl PREH-syoh", "en": "price", "pos": "noun"}, {"t": "barato", "r": "bah-RAH-toh", "en": "cheap", "pos": "adjective"}, {"t": "caro", "r": "KAH-roh", "en": "expensive", "pos": "adjective"}], "grammar": {"title": "ESTE vs ESE: this vs that", "explain": "ESTE/ESTA = this (near me). ESE/ESA = that (near you). They match gender: ESTE libro, ESTA camisa, ESE vestido, ESA tienda.", "pattern": "este/esta + near thing · ese/esa + farther thing", "examples": [{"t": "Esta camisa es barata.", "r": "EHS-tah kah-MEE-sah ehs bah-RAH-tah.", "en": "This shirt is cheap."}, {"t": "Ese vestido es caro.", "r": "EH-seh vehs-TEE-doh ehs KAH-roh.", "en": "That dress is expensive."}, {"t": "¿Cuánto cuesta este?", "r": "KWAHN-toh KWEHS-tah EHS-teh?", "en": "How much is this one?"}], "mistakes": ["Saying ESTE camisa — camisa is feminine: ESTA camisa.", "Using ESE for things in your hand — near you is ESTE."]}, "dialogue": [{"sp": "Ben", "t": "¿Cuánto cuesta esta camisa?", "r": "KWAHN-toh KWEHS-tah EHS-tah kah-MEE-sah?", "en": "How much is this shirt?"}, {"sp": "Ana", "t": "Veinte euros. Es barata.", "r": "BEH-een-teh eh-OO-rohs. ehs bah-RAH-tah.", "en": "Twenty euros. It is cheap."}, {"sp": "Ben", "t": "¿Y ese vestido?", "r": "ee EH-seh vehs-TEE-doh?", "en": "And that dress?"}, {"sp": "Ana", "t": "Cincuenta euros.", "r": "seen-KWEHN-tah eh-OO-rohs.", "en": "Fifty euros."}], "practice": [{"type": "translate_en", "q": "Say: This shirt is cheap", "answer": "Esta camisa es barata"}, {"type": "fill", "q": "¿Cuánto cuesta ___ vestido? (that)", "answer": "ese"}, {"type": "choose", "q": "'That dress is expensive' is…", "options": ["Este vestido es caro", "Ese vestido es caro", "Esta vestida es cara", "Ese vestida es caro"], "answer": "Ese vestido es caro"}, {"type": "reorder", "q": "Order: camisa / barata / es / esta", "answer": "esta camisa es barata"}, {"type": "speak", "q": "Say aloud: ¿Cuánto cuesta esta camisa?", "answer": "¿Cuánto cuesta esta camisa?"}], "quiz": [{"q": "ESTA CAMISA means…", "options": ["that shirt", "this shirt", "those shirts", "my shirt"], "answer": 1, "why": "Esta = this (feminine)."}, {"q": "LOS PANTALONES are…", "options": ["shoes", "trousers", "shirts", "dresses"], "answer": 1, "why": "Pantalones = trousers."}, {"q": "¿CUÁNTO CUESTA…? asks about…", "options": ["size", "price", "colour", "place"], "answer": 1, "why": "Cuesta = it costs."}, {"q": "ESE is used for things…", "options": ["in your hand", "near the other person", "far from both", "invisible"], "answer": 1, "why": "Ese = that (near you)."}, {"q": "BARATO means…", "options": ["expensive", "cheap", "big", "new"], "answer": 1, "why": "Barato = cheap."}], "flashcards": "auto:vocab", "worksheet": {"title": "Shopping worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["shirt", "shoes", "cheap"], "key": ["la camisa", "los zapatos", "barato"]}, {"instruction": "Choose este, esta, ese, or esa.", "items": ["___ camisa (this)", "___ vestido (that)", "___ tienda (that)"], "key": ["esta", "ese", "esa"]}, {"instruction": "Ask prices.", "items": ["How much is this shirt?", "How much is that dress?"], "key": ["¿Cuánto cuesta esta camisa?", "¿Cuánto cuesta ese vestido?"]}]}}, {"id": "A2-U3-L2", "title": "Weather and -ER/-IR past", "learn": "Weather uses HACER (to make): HACE SOL (it is sunny), HACE FRÍO (it is cold). Past of -ER/-IR verbs: COMÍ (I ate), VIVÍ (I lived), COMISTE, COMIÓ. Same endings for -ER and -IR!", "vocab": [{"t": "el sol", "r": "ehl sohl", "en": "sun", "pos": "noun"}, {"t": "la lluvia", "r": "lah YOO-vyah", "en": "rain", "pos": "noun"}, {"t": "el frío", "r": "ehl FREE-oh", "en": "cold", "pos": "noun"}, {"t": "el calor", "r": "ehl kah-LOHR", "en": "heat", "pos": "noun"}, {"t": "el verano", "r": "ehl veh-RAH-noh", "en": "summer", "pos": "noun"}, {"t": "el invierno", "r": "ehl een-VYEHR-noh", "en": "winter", "pos": "noun"}, {"t": "la nube", "r": "lah NOO-beh", "en": "cloud", "pos": "noun"}, {"t": "el viento", "r": "ehl VYEHN-toh", "en": "wind", "pos": "noun"}], "grammar": {"title": "Past -ER/-IR: comí, comiste, comió", "explain": "Drop -ER/-IR, add -Í (I), -ISTE (you), -IÓ (he/she). COMER → comí, comiste, comió. VIVIR → viví, viviste, vivió. Accents matter: COMIO (wrong) vs COMIÓ (he ate)!", "pattern": "stem + í/iste/ió", "examples": [{"t": "Comí paella.", "r": "koh-MEE pah-EH-yah.", "en": "I ate paella."}, {"t": "¿Viviste en Madrid?", "r": "vee-VEES-teh ehn mah-DREED?", "en": "Did you live in Madrid?"}, {"t": "Bebió agua.", "r": "beh-VYOH AH-gwah.", "en": "He/She drank water."}], "mistakes": ["Forgetting the accent: COMIÓ, not COMIO.", "Mixing -AR endings: COMÍ (not COMÉ) — -ER past I is -Í."]}, "dialogue": [{"sp": "Ana", "t": "¿Qué tiempo hace?", "r": "keh TYEHM-poh AH-seh?", "en": "What is the weather like?"}, {"sp": "Ben", "t": "Hace sol. Ayer llovió.", "r": "AH-seh sohl. ah-YEHR yoh-VYOH.", "en": "It is sunny. Yesterday it rained."}, {"sp": "Ana", "t": "¿Comiste fuera?", "r": "koh-MEES-teh FWEH-rah?", "en": "Did you eat out?"}, {"sp": "Ben", "t": "Sí, comí en la playa.", "r": "see, koh-MEE ehn lah PLAH-yah.", "en": "Yes, I ate at the beach."}], "practice": [{"type": "translate_en", "q": "Say: I ate paella", "answer": "Comí paella"}, {"type": "fill", "q": "Hace ___ (sun)", "answer": "sol"}, {"type": "choose", "q": "'Did you live in Madrid?' uses…", "options": ["viví", "viviste", "vivió", "vivo"], "answer": "viviste"}, {"type": "reorder", "q": "Order: paella / comí", "answer": "comí paella"}, {"type": "speak", "q": "Say aloud: Hace sol.", "answer": "Hace sol."}], "quiz": [{"q": "HACE FRÍO means…", "options": ["it is hot", "it is cold", "it rains", "it snows"], "answer": 1, "why": "Frío = cold."}, {"q": "COMÍ means…", "options": ["I eat", "I ate", "you ate", "he eats"], "answer": 1, "why": "-Í = I did (past)."}, {"q": "LA LLUVIA is…", "options": ["sun", "rain", "wind", "cloud"], "answer": 1, "why": "Lluvia = rain."}, {"q": "-ER and -IR past endings are…", "options": ["totally different", "the same", "mixed with -AR", "never used"], "answer": 1, "why": "Comí/viví — same pattern."}, {"q": "AYER LLOVIÓ means…", "options": ["today it rains", "yesterday it rained", "tomorrow rain", "no rain"], "answer": 1, "why": "Ayer + -Ó past."}], "flashcards": "auto:vocab", "worksheet": {"title": "Weather worksheet", "tasks": [{"instruction": "Translate to Spanish.", "items": ["sun", "rain", "winter"], "key": ["el sol", "la lluvia", "el invierno"]}, {"instruction": "Put COMER in the past.", "items": ["I ate", "you ate", "she ate"], "key": ["comí", "comiste", "comió"]}, {"instruction": "Talk weather.", "items": ["What is the weather like?", "It is sunny"], "key": ["¿Qué tiempo hace?", "Hace sol"]}]}}]}], "test": {"title": "A2 final test", "items": [{"type": "translate_en", "q": "Say: Where is the station?", "answer": "¿Dónde está la estación?"}, {"type": "fill", "q": "Viajé a ___ (Mexico)", "answer": "México"}, {"type": "choose", "q": "'I get up at seven'", "options": ["Levanto a las siete", "Me levanto a las siete", "Se levanta a las siete", "Te levantas a las siete"], "answer": "Me levanto a las siete"}, {"type": "translate_en", "q": "Say: I am going to study", "answer": "Voy a estudiar"}, {"type": "translate_t", "q": "Me duele la cabeza.", "answer": "My head hurts."}, {"type": "fill", "q": "La tienda está ___ (near)", "answer": "cerca"}, {"type": "reorder", "q": "Order: gustó / te / ?", "answer": "¿te gustó?"}, {"type": "speak", "q": "Say aloud: ¿Dónde está el banco?", "answer": "¿Dónde está el banco?"}, {"type": "translate_en", "q": "Say: This shirt is cheap", "answer": "Esta camisa es barata"}, {"type": "fill", "q": "Comí ___ (paella)", "answer": "paella"}]}}}