  "assessments": {
    "lesson_quiz": {
      "purpose": "immediate objective check",
      "design": "6–10 mixed items, mostly taught content plus one transfer item; feedback and retry",
      "stakes": "formative"
    },
    "unit_quiz": {
      "purpose": "interleaved retention and scenario transfer",
      "design": "20–30 items plus one speaking/writing task; no hints first attempt",
      "stakes": "formative milestone"
    },
    "level_test": {
      "purpose": "CEFR profile, not lesson completion",
      "design": "balanced reading/listening/writing/speaking/interaction/mediation; unseen material",
      "stakes": "promotion"
    },
    "diagnostic": {
      "purpose": "find prerequisite gaps",
      "design": "low-stakes adaptive skill map; can recommend remediation without demotion"
    },
    "placement": {
      "purpose": "starting point",
      "design": "adaptive receptive screen followed by script, speaking and writing verification; confidence bands"
    },
